---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/nav/Breadcrumb.astro';

const siteUrl = import.meta.env.SITE || 'https://mazethis.com';

const faqItems = [
  // General
  { q: 'Are mazes on MazeThis free?', a: 'Yes. MazeThis is free to use for personal and educational maze solving. You can play online, generate custom mazes, and print worksheet-style mazes without creating an account.' },
  { q: 'Do I need an account?', a: 'No. MazeThis does not require an account. Progress saves locally on your device when a page supports saved progress.' },
  { q: 'What can I do on MazeThis?', a: 'You can play the Maze of the Day, work through Maze Library collections, generate custom mazes, and print maze worksheets.' },
  // Playing Mazes
  { q: 'How do I play a maze online?', a: 'Open a playable maze and move with arrow keys, WASD, swipe controls, or the on-screen D-pad depending on your device.' },
  { q: 'Can I use hints?', a: 'Yes. Playable mazes include tools such as hints, solutions, and traveled-path display where available.' },
  { q: 'How do I see the solution?', a: 'Use the Show Solution option during play. It reveals the solution path for the current maze.' },
  { q: 'Can I reset a maze?', a: 'Yes. Pause the maze and choose Reset Progress to clear the current run.' },
  { q: 'Do mazes work on phones and tablets?', a: 'Yes. MazeThis works on mobile devices. You can swipe to move, use touch controls, and use the minimap to explore larger mazes.' },
  // Printing Mazes
  { q: 'Can I print mazes?', a: 'Yes. Use Printable Mazes for worksheet-style printouts. You can generate a maze, choose a size, and print a clean page.' },
  { q: 'Can I include an answer key?', a: 'Yes. On Printable Mazes, choose Include Answer Key before printing. The printout includes the maze worksheet and a second page with the solution.' },
  { q: 'Can I download mazes as SVG files?', a: 'Yes. Maze Generator and Printable Mazes can download the current maze as an SVG file. SVG files scale cleanly and can be used in design or document tools.' },
  { q: 'Can teachers print mazes for classrooms?', a: 'Yes. MazeThis mazes can be used for classroom activities, warm-ups, quiet work, and printable practice.' },
  // Progress and Daily Maze
  { q: 'Does my progress save?', a: 'On supported pages, progress saves locally on your device. This lets you leave and return without creating an account.' },
  { q: 'Where is my progress stored?', a: 'Progress is stored in your browser on the device you are using. It is not tied to an account.' },
  { q: 'Is there a daily maze challenge?', a: 'Yes. MazeThis has a Maze of the Day with one fresh daily maze challenge.' },
  { q: 'When does the Maze of the Day change?', a: 'The Maze of the Day changes at midnight based on the current date.' },
  { q: 'Is the daily maze the same for everyone?', a: 'The daily maze is generated from the date, so players on the same local date receive the same daily challenge.' },
  // Maze Collections
  { q: 'What are the maze difficulty levels?', a: 'MazeThis uses size-based collections: Small 20×20, Medium 40×40, Large 60×60, Expert 80×80, and Monster 100×100. Larger mazes generally take more focus and navigation.' },
  { q: 'What is the easiest maze size?', a: 'Small Mazes are the easiest starting point. They are quick, readable, and good for beginners or short sessions.' },
  { q: 'What is the hardest maze size?', a: 'Monster Mazes are the largest Maze Library collection on MazeThis. They use 100×100 grids and are built for serious focus.' },
  { q: 'What is the Maze Library?', a: 'The Maze Library contains maze collections you can work through over time. Your progress saves on this device so you can complete each collection.' },
  { q: 'How is the Maze Generator different from the Maze Library?', a: 'The Maze Generator creates a new custom maze whenever you want. The Maze Library is your home for collections with progress tracking.' },
  { q: 'What is the difference between a maze and a labyrinth?', a: 'A maze usually has branching paths, choices, and dead ends. A labyrinth usually has one continuous path to the center and back out.' },
];

const schemaLD = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: faqItems.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${siteUrl}/faq#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
        { '@type': 'ListItem', position: 2, name: 'FAQ', item: `${siteUrl}/faq` },
      ],
    },
  ],
});
---

<BaseLayout
  title="FAQ | MazeThis"
  description="Answers to common questions about playing mazes online, printing maze worksheets, saving progress, using hints, downloading SVGs, and choosing maze sizes on MazeThis."
  canonical={`${siteUrl}/faq`}
  schemaLD={schemaLD}
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 pt-8 pb-10 sm:pt-10">

    <Breadcrumb crumbs={[{ label: 'Home', href: '/' }, { label: 'FAQ' }]} />

    <!-- Hero -->
    <div class="mt-6 mb-12 md:mb-16 lg:mb-20">
      <p class="text-xs tracking-widest uppercase font-semibold text-arch-accent mb-2">HELP CENTER</p>
      <h1 class="text-5xl sm:text-6xl lg:text-7xl xl:text-8xl mb-5">Frequently Asked Questions</h1>
      <p class="text-lg sm:text-xl md:text-2xl max-w-2xl leading-relaxed" style="color: var(--color-muted-strong);">
        Answers to common questions about playing mazes, printing maze worksheets, saving progress, and using MazeThis tools.
      </p>
    </div>

    <!-- Quick Links -->
    <section class="mb-14">
      <h2 class="text-xl font-bold text-arch-charcoal mb-2">What do you need help with?</h2>
      <p class="text-sm mb-6" style="color: var(--color-muted-strong);">Jump to the area that matches your question.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <a href="#playing-mazes" class="card-hover rounded-lg p-5 flex flex-col gap-3 no-underline">
          <div>
            <p class="font-semibold mb-1" style="color: var(--color-charcoal);">Playing Mazes</p>
            <p class="text-sm" style="color: var(--color-muted-strong);">How to move, use hints, view solutions, and solve mazes online.</p>
          </div>
          <span class="text-sm font-medium mt-auto" style="color: var(--color-accent);">Jump to section →</span>
        </a>
        <a href="#printing-mazes" class="card-hover rounded-lg p-5 flex flex-col gap-3 no-underline">
          <div>
            <p class="font-semibold mb-1" style="color: var(--color-charcoal);">Printing Mazes</p>
            <p class="text-sm" style="color: var(--color-muted-strong);">How printable mazes, answer keys, and SVG downloads work.</p>
          </div>
          <span class="text-sm font-medium mt-auto" style="color: var(--color-accent);">Jump to section →</span>
        </a>
        <a href="#progress-daily" class="card-hover rounded-lg p-5 flex flex-col gap-3 no-underline">
          <div>
            <p class="font-semibold mb-1" style="color: var(--color-charcoal);">Progress and Daily Maze</p>
            <p class="text-sm" style="color: var(--color-muted-strong);">How saved progress, reset, and the daily maze work.</p>
          </div>
          <span class="text-sm font-medium mt-auto" style="color: var(--color-accent);">Jump to section →</span>
        </a>
        <a href="#maze-collections" class="card-hover rounded-lg p-5 flex flex-col gap-3 no-underline">
          <div>
            <p class="font-semibold mb-1" style="color: var(--color-charcoal);">Maze Collections</p>
            <p class="text-sm" style="color: var(--color-muted-strong);">How sizes, difficulty, and the Maze Library work.</p>
          </div>
          <span class="text-sm font-medium mt-auto" style="color: var(--color-accent);">Jump to section →</span>
        </a>
      </div>
    </section>

    <!-- FAQ: General -->
    <section class="mt-16 pt-10" style="border-top: 1px solid var(--color-border);">
      <h2 class="text-xl font-bold text-arch-charcoal mb-6">General</h2>
      <dl class="space-y-5">
        <div class="border-b pb-5 last:border-0" style="border-color: var(--color-border);">
          <dt class="font-semibold mb-1" style="color: var(--color-charcoal);">Are mazes on MazeThis free?</dt>
          <dd class="text-sm leading-relaxed" style="color: var(--color-muted-strong);">Yes. MazeThis is free to use for personal and educational maze solving. You can play online, generate custom mazes, and print worksheet-style mazes without creating an account.</dd>
        </div>
        <div class="border-b pb-5 last:border-0" style="border-color: var(--color-border);">
          <dt class="font-semibold mb-1" style="color: var(--color-charcoal);">Do I need an account?</dt>
          <dd class="text-sm leading-relaxed" style="color: var(--color-muted-strong);">No. MazeThis does not require an account. Progress saves locally on your device when a page supports saved progress.</dd>
        </div>
        <div class="border-b pb-5 last:border-0" style="border-color: var(--color-border);">
          <dt class="font-semibold mb-1" style="color: var(--color-charcoal);">What can I do on MazeThis?</dt>
          <dd class="text-sm leading-relaxed" style="color: var(--color-muted-strong);">You can play the Maze of the Day, work through Maze Library collections, generate custom mazes, and print maze worksheets.</dd>
        </div>
      </dl>
    </section>

    <!-- FAQ: Playing Mazes -->
    <section id="playing-mazes" class="mt-16 pt-10 scroll-mt-20" style="border-top: 1px solid var(--color-border);">
      <h2 class="text-xl font-bold text-arch-charcoal mb-6">Playing Mazes</h2>
      <dl class="space-y-5">
        <div class="border-b pb-5 last:border-0" style="border-color: var(--color-border);">
          <dt class="font-semibold mb-1" style="color: var(--color-charcoal);">How do I play a maze online?</dt>
          <dd class="text-sm leading-relaxed" style="color: var(--color-muted-strong);">Open a playable maze and move with arrow keys, WASD, swipe controls, or the on-screen D-pad depending on your device.</dd>
        </div>
        <div class="border-b pb-5 last:border-0" style="border-color: var(--color-border);">
          <dt class="font-semibold mb-1" style="color: var(--color-charcoal);">Can I use hints?</dt>
          <dd class="text-sm leading-relaxed" style="color: var(--color-muted-strong);">Yes. Playable mazes include tools such as hints, solutions, and traveled-path display where available.</dd>
        </div>
        <div class="border-b pb-5 last:border-0" style="border-color: var(--color-border);">
          <dt class="font-semibold mb-1" style="color: var(--color-charcoal);">How do I see the solution?</dt>
          <dd class="text-sm leading-relaxed" style="color: var(--color-muted-strong);">Use the Show Solution option during play. It reveals the solution path for the current maze.</dd>
        </div>
        <div class="border-b pb-5 last:border-0" style="border-color: var(--color-border);">
          <dt class="font-semibold mb-1" style="color: var(--color-charcoal);">Can I reset a maze?</dt>
          <dd class="text-sm leading-relaxed" style="color: var(--color-muted-strong);">Yes. Pause the maze and choose Reset Progress to clear the current run.</dd>
        </div>
        <div class="border-b pb-5 last:border-0" style="border-color: var(--color-border);">
          <dt class="font-semibold mb-1" style="color: var(--color-charcoal);">Do mazes work on phones and tablets?</dt>
          <dd class="text-sm leading-relaxed" style="color: var(--color-muted-strong);">Yes. MazeThis works on mobile devices. You can swipe to move, use touch controls, and use the minimap to explore larger mazes.</dd>
        </div>
      </dl>
    </section>

    <!-- FAQ: Printing Mazes -->
    <section id="printing-mazes" class="mt-16 pt-10 scroll-mt-20" style="border-top: 1px solid var(--color-border);">
      <h2 class="text-xl font-bold text-arch-charcoal mb-6">Printing Mazes</h2>
      <dl class="space-y-5">
        <div class="border-b pb-5 last:border-0" style="border-color: var(--color-border);">
          <dt class="font-semibold mb-1" style="color: var(--color-charcoal);">Can I print mazes?</dt>
          <dd class="text-sm leading-relaxed" style="color: var(--color-muted-strong);">Yes. Use <a href="/printable-mazes" style="color: var(--color-accent);">Printable Mazes</a> for worksheet-style printouts. You can generate a maze, choose a size, and print a clean page.</dd>
        </div>
        <div class="border-b pb-5 last:border-0" style="border-color: var(--color-border);">
          <dt class="font-semibold mb-1" style="color: var(--color-charcoal);">Can I include an answer key?</dt>
          <dd class="text-sm leading-relaxed" style="color: var(--color-muted-strong);">Yes. On Printable Mazes, choose Include Answer Key before printing. The printout includes the maze worksheet and a second page with the solution.</dd>
        </div>
        <div class="border-b pb-5 last:border-0" style="border-color: var(--color-border);">
          <dt class="font-semibold mb-1" style="color: var(--color-charcoal);">Can I download mazes as SVG files?</dt>
          <dd class="text-sm leading-relaxed" style="color: var(--color-muted-strong);">Yes. Maze Generator and Printable Mazes can download the current maze as an SVG file. SVG files scale cleanly and can be used in design or document tools.</dd>
        </div>
        <div class="border-b pb-5 last:border-0" style="border-color: var(--color-border);">
          <dt class="font-semibold mb-1" style="color: var(--color-charcoal);">Can teachers print mazes for classrooms?</dt>
          <dd class="text-sm leading-relaxed" style="color: var(--color-muted-strong);">Yes. MazeThis mazes can be used for classroom activities, warm-ups, quiet work, and printable practice.</dd>
        </div>
      </dl>
    </section>

    <!-- FAQ: Progress and Daily Maze -->
    <section id="progress-daily" class="mt-16 pt-10 scroll-mt-20" style="border-top: 1px solid var(--color-border);">
      <h2 class="text-xl font-bold text-arch-charcoal mb-6">Progress and Daily Maze</h2>
      <dl class="space-y-5">
        <div class="border-b pb-5 last:border-0" style="border-color: var(--color-border);">
          <dt class="font-semibold mb-1" style="color: var(--color-charcoal);">Does my progress save?</dt>
          <dd class="text-sm leading-relaxed" style="color: var(--color-muted-strong);">On supported pages, progress saves locally on your device. This lets you leave and return without creating an account.</dd>
        </div>
        <div class="border-b pb-5 last:border-0" style="border-color: var(--color-border);">
          <dt class="font-semibold mb-1" style="color: var(--color-charcoal);">Where is my progress stored?</dt>
          <dd class="text-sm leading-relaxed" style="color: var(--color-muted-strong);">Progress is stored in your browser on the device you are using. It is not tied to an account.</dd>
        </div>
        <div class="border-b pb-5 last:border-0" style="border-color: var(--color-border);">
          <dt class="font-semibold mb-1" style="color: var(--color-charcoal);">Is there a daily maze challenge?</dt>
          <dd class="text-sm leading-relaxed" style="color: var(--color-muted-strong);">Yes. MazeThis has a <a href="/maze-of-the-day" style="color: var(--color-accent);">Maze of the Day</a> with one fresh daily maze challenge.</dd>
        </div>
        <div class="border-b pb-5 last:border-0" style="border-color: var(--color-border);">
          <dt class="font-semibold mb-1" style="color: var(--color-charcoal);">When does the Maze of the Day change?</dt>
          <dd class="text-sm leading-relaxed" style="color: var(--color-muted-strong);">The Maze of the Day changes at midnight based on the current date.</dd>
        </div>
        <div class="border-b pb-5 last:border-0" style="border-color: var(--color-border);">
          <dt class="font-semibold mb-1" style="color: var(--color-charcoal);">Is the daily maze the same for everyone?</dt>
          <dd class="text-sm leading-relaxed" style="color: var(--color-muted-strong);">The daily maze is generated from the date, so players on the same local date receive the same daily challenge.</dd>
        </div>
      </dl>
    </section>

    <!-- FAQ: Maze Collections and Difficulty -->
    <section id="maze-collections" class="mt-16 pt-10 scroll-mt-20" style="border-top: 1px solid var(--color-border);">
      <h2 class="text-xl font-bold text-arch-charcoal mb-6">Maze Collections and Difficulty</h2>
      <dl class="space-y-5">
        <div class="border-b pb-5 last:border-0" style="border-color: var(--color-border);">
          <dt class="font-semibold mb-1" style="color: var(--color-charcoal);">What are the maze difficulty levels?</dt>
          <dd class="text-sm leading-relaxed" style="color: var(--color-muted-strong);">MazeThis uses size-based collections: Small 20&times;20, Medium 40&times;40, Large 60&times;60, Expert 80&times;80, and Monster 100&times;100. Larger mazes generally take more focus and navigation.</dd>
        </div>
        <div class="border-b pb-5 last:border-0" style="border-color: var(--color-border);">
          <dt class="font-semibold mb-1" style="color: var(--color-charcoal);">What is the easiest maze size?</dt>
          <dd class="text-sm leading-relaxed" style="color: var(--color-muted-strong);"><a href="/small-mazes" style="color: var(--color-accent);">Small Mazes</a> are the easiest starting point. They are quick, readable, and good for beginners or short sessions.</dd>
        </div>
        <div class="border-b pb-5 last:border-0" style="border-color: var(--color-border);">
          <dt class="font-semibold mb-1" style="color: var(--color-charcoal);">What is the hardest maze size?</dt>
          <dd class="text-sm leading-relaxed" style="color: var(--color-muted-strong);"><a href="/monster-mazes" style="color: var(--color-accent);">Monster Mazes</a> are the largest Maze Library collection on MazeThis. They use 100&times;100 grids and are built for serious focus.</dd>
        </div>
        <div class="border-b pb-5 last:border-0" style="border-color: var(--color-border);">
          <dt class="font-semibold mb-1" style="color: var(--color-charcoal);">What is the Maze Library?</dt>
          <dd class="text-sm leading-relaxed" style="color: var(--color-muted-strong);">The <a href="/maze-library" style="color: var(--color-accent);">Maze Library</a> contains maze collections you can work through over time. Your progress saves on this device so you can complete each collection.</dd>
        </div>
        <div class="border-b pb-5 last:border-0" style="border-color: var(--color-border);">
          <dt class="font-semibold mb-1" style="color: var(--color-charcoal);">How is the Maze Generator different from the Maze Library?</dt>
          <dd class="text-sm leading-relaxed" style="color: var(--color-muted-strong);">The <a href="/maze-generator" style="color: var(--color-accent);">Maze Generator</a> creates a new custom maze whenever you want. The Maze Library is your home for collections with progress tracking.</dd>
        </div>
        <div class="border-b pb-5 last:border-0" style="border-color: var(--color-border);">
          <dt class="font-semibold mb-1" style="color: var(--color-charcoal);">What is the difference between a maze and a labyrinth?</dt>
          <dd class="text-sm leading-relaxed" style="color: var(--color-muted-strong);">A maze usually has branching paths, choices, and dead ends. A labyrinth usually has one continuous path to the center and back out.</dd>
        </div>
      </dl>
    </section>

    <!-- MazeThis Tools -->
    <section class="mt-12">
      <h2 class="text-xl font-bold text-arch-charcoal mb-2">MazeThis Tools</h2>
      <p class="text-sm mb-6" style="color: var(--color-muted-strong);">Choose the tool that matches what you want to do next.</p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <a href="/maze-library" class="card-hover rounded-lg p-5 flex flex-col gap-3 no-underline">
          <div>
            <p class="font-semibold mb-1" style="color: var(--color-charcoal);">Maze Library</p>
            <p class="text-sm" style="color: var(--color-muted-strong);">Work through Maze Library collections and track your progress.</p>
          </div>
          <span class="text-sm font-medium mt-auto" style="color: var(--color-accent);">Maze Library →</span>
        </a>
        <a href="/maze-generator" class="card-hover rounded-lg p-5 flex flex-col gap-3 no-underline">
          <div>
            <p class="font-semibold mb-1" style="color: var(--color-charcoal);">Maze Generator</p>
            <p class="text-sm" style="color: var(--color-muted-strong);">Create a custom maze and decide whether to play, print, or download it.</p>
          </div>
          <span class="text-sm font-medium mt-auto" style="color: var(--color-accent);">Maze Generator →</span>
        </a>
        <a href="/printable-mazes" class="card-hover rounded-lg p-5 flex flex-col gap-3 no-underline">
          <div>
            <p class="font-semibold mb-1" style="color: var(--color-charcoal);">Printable Mazes</p>
            <p class="text-sm" style="color: var(--color-muted-strong);">A print-first worksheet tool with optional answer key pages.</p>
          </div>
          <span class="text-sm font-medium mt-auto" style="color: var(--color-accent);">Printable Mazes →</span>
        </a>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="mt-12 rounded-sm border border-arch-200 bg-arch-bg p-6">
      <h2 class="text-lg font-bold text-arch-charcoal mb-2">Ready to solve a maze?</h2>
      <p class="text-sm text-arch-600 mb-5">Browse the Maze Library, generate a custom maze, or print a worksheet-style maze.</p>
      <div class="flex flex-wrap gap-3">
        <a href="/maze-library"    class="btn-secondary">Maze Library</a>
        <a href="/maze-generator"  class="btn-secondary">Maze Generator</a>
        <a href="/printable-mazes" class="btn-secondary">Printable Mazes</a>
      </div>
    </section>

  </div>
</BaseLayout>
