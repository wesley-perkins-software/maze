---
import BaseLayout from '../layouts/BaseLayout.astro';
import { MazeGenerator } from '../components/maze/MazeGenerator';

const siteUrl = import.meta.env.SITE || 'https://mazethis.com';

const faqItems = [
  {
    q: 'Is the maze generator free?',
    a: 'Yes, completely free. No account, no sign-up, no limits. Generate as many mazes as you like.',
  },
  {
    q: 'Can I print the mazes?',
    a: 'Yes. Click the Print button to send the current maze directly to your printer. You can also Download SVG and print from any image viewer.',
  },
  {
    q: 'What sizes can I make?',
    a: 'Choose Small (20×20), Medium (40×40), Large (60×60), Expert (80×80), or Monster (100×100) with one click. Need something specific? Use the Custom button to set exact dimensions up to 100×100.',
  },
  {
    q: 'Can I use these mazes in my classroom?',
    a: 'Absolutely. Teachers use MazeThis to print mazes for worksheets, activity packs, and early-learning exercises. All mazes are free to print and share.',
  },
  {
    q: 'How are the mazes generated?',
    a: 'Every maze is built with a Growing Tree algorithm — a hybrid between depth-first search and Prim\'s algorithm. Larger mazes use more branching and loop carving to create genuine decision points, not just long corridors.',
  },
  {
    q: 'Why do larger mazes feel harder?',
    a: 'Larger mazes use higher branching (more junction choices) and more loop density (more cycles that defeat wall-following). This creates real disorientation, not just a longer path.',
  },
];

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Free Maze Generator',
      url: `${siteUrl}/maze-generator`,
      description:
        'Free online maze generator. Create custom mazes from Small (20×20) to Monster (100×100). Play in your browser, download as SVG, or print.',
      applicationCategory: 'UtilityApplication',
      isAccessibleForFree: true,
      operatingSystem: 'Web Browser',
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqItems.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ],
});
---

<BaseLayout
  title="Free Maze Generator — Create Custom Mazes Online | MazeThis"
  description="Make a free maze online in seconds. Pick Small, Medium, or Large — then play it in your browser, download as SVG, or print. Smart branching and loop carving make every maze genuinely challenging."
  schemaLD={schema}
>
  <div class="screen-only mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 pt-8 pb-10 sm:pt-10 lg:pt-8">

    <!-- Breadcrumb + heading — mobile only; desktop version renders inside the generator component -->
    <div class="mb-6 scroll-mt-24 lg:hidden">
      <nav aria-label="Breadcrumb" class="text-sm text-arch-600 mb-4">
        <ol class="flex items-center gap-1">
          <li><a href="/" class="hover:text-arch-charcoal transition-colors">Home</a></li>
          <li>
            <svg class="w-3 h-3 mx-1 text-arch-600 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </li>
          <li><span class="text-arch-charcoal font-medium" aria-current="page">Maze Generator</span></li>
        </ol>
      </nav>

      <p class="text-xs tracking-widest uppercase font-semibold text-arch-accent mb-2">Free Maze Generator</p>
      <h1 class="text-5xl text-arch-charcoal mb-3">Build Your Own Maze</h1>
      <p class="text-arch-600 text-base max-w-xl">
        Choose a size, generate a maze, then play online or print.
      </p>
    </div>

    <!-- Generator Island -->
    <MazeGenerator client:only="react">
      <div
        slot="fallback"
        class="screen-only flex flex-col gap-7 lg:grid lg:grid-cols-[320px_1fr] lg:items-start lg:gap-10"
        aria-hidden="true"
      >
        <div class="min-w-0 w-full lg:col-start-2 lg:row-start-1">
          <div
            class="border border-arch-400/60 bg-arch-surface mx-auto"
            style="width: min(100%, calc(100vh - 140px)); aspect-ratio: 1 / 1; box-shadow: inset 0 0 0 6px #FFFFFF, inset 0 0 0 7px #B0AEA8;"
          >
          </div>
          <div
            class="grid grid-cols-[minmax(0,1fr)_auto_auto_minmax(0,1fr)] items-center gap-x-5 pt-2 pb-1 mx-auto sm:gap-x-6"
            style="width: min(100%, calc(100vh - 140px));"
          >
            <span class="h-4 w-14 bg-arch-200/70"></span>
            <span class="h-4 w-16 bg-arch-200/70"></span>
            <span class="h-4 w-16 bg-arch-200/70"></span>
            <span class="h-4 w-16 justify-self-end bg-arch-200/70"></span>
          </div>
        </div>

        <div class="w-full shrink-0 flex flex-col gap-4 lg:col-start-1 lg:row-start-1">
          <div class="hidden lg:block">
            <div class="mb-3 h-4 w-36 bg-arch-200/70"></div>
            <div class="mb-2 h-3 w-32 bg-arch-200/70"></div>
            <div class="mb-2 h-12 w-full bg-arch-200/70"></div>
            <div class="mb-4 h-10 w-full bg-arch-200/70"></div>
          </div>
          <div>
            <div class="mb-2 h-3 w-12 bg-arch-200/70"></div>
            <div class="grid grid-cols-3 gap-1.5">
              <span class="h-[58px] rounded-sm border border-arch-200 bg-arch-surface"></span>
              <span class="h-[58px] rounded-sm border border-arch-200 bg-arch-surface"></span>
              <span class="h-[58px] rounded-sm border border-arch-200 bg-arch-surface"></span>
              <span class="h-[58px] rounded-sm border border-arch-200 bg-arch-surface"></span>
              <span class="h-[58px] rounded-sm border border-arch-200 bg-arch-surface"></span>
              <span class="h-[58px] rounded-sm border border-arch-200 bg-arch-surface"></span>
            </div>
          </div>
          <div class="border-t border-arch-200"></div>
          <div class="space-y-2.5">
            <div class="h-[52px] rounded-sm border-2 border-arch-charcoal bg-arch-surface"></div>
            <div class="h-[52px] rounded-sm bg-arch-accent/80"></div>
            <div class="flex gap-2">
              <div class="h-[38px] flex-1 rounded-sm border border-arch-200 bg-arch-surface"></div>
              <div class="hidden h-[38px] flex-1 rounded-sm border border-arch-200 bg-arch-surface lg:block"></div>
            </div>
          </div>
        </div>
      </div>
    </MazeGenerator>

    <!-- ── How to Use ─────────────────────────────────────────────────────── -->
    <section class="mt-16 pt-10" style="border-top: 1px solid var(--color-border);">
      <h2 class="text-xl font-bold text-arch-charcoal mb-6">How to Create Your Maze</h2>
      <ol class="grid grid-cols-1 sm:grid-cols-3 gap-6 list-none">
        <li class="flex gap-4">
          <span class="shrink-0 w-8 h-8 rounded-full bg-arch-charcoal text-white text-sm font-bold flex items-center justify-center">1</span>
          <div>
            <p class="font-semibold" style="color: var(--color-charcoal);">Pick a size</p>
            <p class="text-sm mt-1" style="color: var(--color-muted-strong);">Small for quick fun, Large for a serious challenge. Complexity scales automatically.</p>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="shrink-0 w-8 h-8 rounded-full bg-arch-charcoal text-white text-sm font-bold flex items-center justify-center">2</span>
          <div>
            <p class="font-semibold" style="color: var(--color-charcoal);">Generate</p>
            <p class="text-sm mt-1" style="color: var(--color-muted-strong);">Each maze is unique and seeded — hit Generate New Maze as many times as you like.</p>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="shrink-0 w-8 h-8 rounded-full bg-arch-charcoal text-white text-sm font-bold flex items-center justify-center">3</span>
          <div>
            <p class="font-semibold" style="color: var(--color-charcoal);">Play, print, or download</p>
            <p class="text-sm mt-1" style="color: var(--color-muted-strong);">Solve it in your browser with arrow keys, or export for printing.</p>
          </div>
        </li>
      </ol>
    </section>

    <!-- ── Size Guide ─────────────────────────────────────────────────────── -->
    <section class="mt-12">
      <h2 class="text-xl font-bold text-arch-charcoal mb-6">Choosing the Right Size</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
        <div class="rounded-sm border border-arch-200 bg-arch-surface p-4">
          <div class="flex items-center gap-2 mb-2">
            <span class="inline-block rounded-sm bg-green-100 px-2 py-0.5 text-xs font-semibold text-green-700">Small</span>
          </div>
          <p class="text-xs font-mono text-arch-400 mb-2">20×20 · ~3 min</p>
          <p class="text-sm text-arch-600">Quick and approachable. A handful of junctions — the right warm-up.</p>
          <a href="/small-mazes" class="mt-3 inline-block text-xs text-arch-accent hover:underline font-medium">Browse →</a>
        </div>
        <div class="rounded-sm border border-arch-200 bg-arch-surface p-4">
          <div class="flex items-center gap-2 mb-2">
            <span class="inline-block rounded-sm bg-arch-100 px-2 py-0.5 text-xs font-semibold text-arch-charcoal">Medium</span>
          </div>
          <p class="text-xs font-mono text-arch-400 mb-2">40×40 · ~12 min</p>
          <p class="text-sm text-arch-600">The balanced challenge. Enough loops that wall-following stops working.</p>
          <a href="/medium-mazes" class="mt-3 inline-block text-xs text-arch-accent hover:underline font-medium">Browse →</a>
        </div>
        <div class="rounded-sm border border-arch-200 bg-arch-surface p-4">
          <div class="flex items-center gap-2 mb-2">
            <span class="inline-block rounded-sm bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-700">Large</span>
          </div>
          <p class="text-xs font-mono text-arch-400 mb-2">60×60 · ~30 min</p>
          <p class="text-sm text-arch-600">A genuine labyrinth. Dense branching. Consult the minimap often.</p>
          <a href="/large-mazes" class="mt-3 inline-block text-xs text-arch-accent hover:underline font-medium">Browse →</a>
        </div>
        <div class="rounded-sm border border-arch-200 bg-arch-surface p-4">
          <div class="flex items-center gap-2 mb-2">
            <span class="inline-block rounded-sm bg-orange-100 px-2 py-0.5 text-xs font-semibold text-orange-700">Expert</span>
          </div>
          <p class="text-xs font-mono text-arch-400 mb-2">80×80 · ~60 min</p>
          <p class="text-sm text-arch-600">A true labyrinth. Aggressive loop carving — easy to lose your bearings even with a map.</p>
        </div>
        <div class="rounded-sm border border-arch-200 bg-arch-surface p-4">
          <div class="flex items-center gap-2 mb-2">
            <span class="inline-block rounded-sm bg-arch-charcoal px-2 py-0.5 text-xs font-semibold text-white">Monster</span>
          </div>
          <p class="text-xs font-mono text-arch-400 mb-2">100×100 · 90+ min</p>
          <p class="text-sm text-arch-600">The hardest maze we generate. Print it. Block off an afternoon. Not for the faint-hearted.</p>
        </div>
      </div>
    </section>

    <!-- ── Use Cases ──────────────────────────────────────────────────────── -->
    <section class="mt-12">
      <h2 class="text-xl font-bold text-arch-charcoal mb-6">Ways to Use Your Maze</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-sm" style="color: var(--color-muted-strong);">
        <div class="card rounded-lg p-4">
          <p class="font-semibold mb-1" style="color: var(--color-charcoal);">🏫 Classroom worksheets</p>
          <p>Print a fresh maze for every student. Small mazes work well for younger kids; Medium for primary school.</p>
        </div>
        <div class="card rounded-lg p-4">
          <p class="font-semibold mb-1" style="color: var(--color-charcoal);">🧒 Kids activity</p>
          <p>Keep kids entertained on car trips, rainy days, or waiting rooms. Generate a Small maze for ages 4–8.</p>
        </div>
        <div class="card rounded-lg p-4">
          <p class="font-semibold mb-1" style="color: var(--color-charcoal);">🎮 Play online</p>
          <p>Solve with arrow keys on desktop or swipe on mobile. The timer and hint system keep it engaging for all ages.</p>
        </div>
        <div class="card rounded-lg p-4">
          <p class="font-semibold mb-1" style="color: var(--color-charcoal);">🧩 Puzzle challenge</p>
          <p>Try a Large maze for a serious mental workout. Download as SVG to share or print at any resolution.</p>
        </div>
      </div>
    </section>

    <!-- ── FAQ ────────────────────────────────────────────────────────────── -->
    <section class="mt-12">
      <h2 class="text-xl font-bold text-arch-charcoal mb-6">Frequently Asked Questions</h2>
      <dl class="space-y-5">
        {faqItems.map(({ q, a }) => (
          <div class="border-b pb-5 last:border-0" style="border-color: var(--color-border);">
            <dt class="font-semibold mb-1" style="color: var(--color-charcoal);">{q}</dt>
            <dd class="text-sm" style="color: var(--color-muted-strong);">{a}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- ── Browse Pre-Made Mazes ──────────────────────────────────────────── -->
    <section class="mt-12 rounded-sm border border-arch-200 bg-arch-bg p-6">
      <h2 class="text-lg font-bold text-arch-charcoal mb-4">Browse Pre-Made Mazes</h2>
      <p class="text-sm text-arch-600 mb-4">Prefer to browse a curated collection? We have 150+ ready-to-play mazes across all sizes.</p>
      <nav aria-label="Maze library categories" class="flex flex-wrap gap-3">
        <a href="/small-mazes"      class="rounded-sm border border-arch-200 bg-arch-surface px-4 py-2 text-sm font-medium text-arch-600 hover:border-arch-charcoal hover:text-arch-charcoal transition-colors">Small Mazes</a>
        <a href="/medium-mazes"     class="rounded-sm border border-arch-200 bg-arch-surface px-4 py-2 text-sm font-medium text-arch-600 hover:border-arch-charcoal hover:text-arch-charcoal transition-colors">Medium Mazes</a>
        <a href="/large-mazes"      class="rounded-sm border border-arch-200 bg-arch-surface px-4 py-2 text-sm font-medium text-arch-600 hover:border-arch-charcoal hover:text-arch-charcoal transition-colors">Large Mazes</a>
        <a href="/printable-mazes"  class="rounded-sm border border-arch-200 bg-arch-surface px-4 py-2 text-sm font-medium text-arch-600 hover:border-arch-charcoal hover:text-arch-charcoal transition-colors">Printable Mazes</a>
      </nav>
    </section>

  </div>
</BaseLayout>
