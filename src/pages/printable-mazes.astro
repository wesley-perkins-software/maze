---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/nav/Breadcrumb.astro';
import { PrintableMazeGenerator } from '../components/maze/PrintableMazeGenerator';

const siteUrl = import.meta.env.SITE || 'https://mazethis.com';

const faqItems = [
  {
    q: 'What are maze printables?',
    a: 'Maze printables are maze puzzles you generate and print on standard paper, then solve with a pencil. Each maze prints as a clean single-page worksheet — no ads, no extra content, just the maze.',
  },
  {
    q: 'Are these maze printables free?',
    a: 'Yes. Every maze you generate on this page is free — no account, no sign-up, and no payment required.',
  },
  {
    q: 'How do I print a maze?',
    a: 'Choose a size, then click Generate Printable Maze. When you are happy with the maze, click Print Maze. Your browser opens a clean print view showing only the maze. Print on standard Letter or A4 paper.',
  },
  {
    q: 'Can I print mazes without ads?',
    a: 'Yes. The print view is completely ad-free — only the maze appears on the printed page.',
  },
  {
    q: 'Can I print maze solutions?',
    a: 'Solution printing is not yet available. This page currently produces clean, puzzle-only worksheets. Solution printing is planned for a future update.',
  },
  {
    q: 'What size maze should I print for kids?',
    a: 'Small Mazes (20×20 grid) are the best starting point for children and beginners — quick to complete and easy to navigate on the page. Medium Mazes (40×40) work well for older kids and teens who want more of a challenge.',
  },
  {
    q: 'Can teachers use these maze worksheets?',
    a: 'Yes. You can generate and print as many mazes as you need — great for classroom sets, warm-up activities, and take-home worksheets. No license or permission is required for educational use.',
  },
  {
    q: 'Can I make a custom printable maze?',
    a: 'This page generates ready-made mazes in five sizes. For full control over dimensions and advanced options, use the Maze Generator — it also lets you print or download the result as an SVG.',
  },
  {
    q: 'Are the mazes black and white?',
    a: 'Yes. All mazes print in black and white. Use your printer\'s grayscale mode to save ink.',
  },
];

const schemaLD = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${siteUrl}/printable-mazes`,
      url: `${siteUrl}/printable-mazes`,
      name: 'Free Maze Printables',
      description: 'Generate free printable maze worksheets in small, medium, large, expert, and monster sizes. Clean ad-free printouts — no account required.',
      isPartOf: { '@id': `${siteUrl}/#website` },
      breadcrumb: { '@id': `${siteUrl}/printable-mazes#breadcrumb` },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${siteUrl}/printable-mazes#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
        { '@type': 'ListItem', position: 2, name: 'Printable Mazes', item: `${siteUrl}/printable-mazes` },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqItems.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ],
});
---

<BaseLayout
  title="Free Maze Printables — Print Maze Worksheets | MazeThis"
  description="Generate free printable maze worksheets in seconds. Choose a size, generate a clean ad-free maze, and print — no account required."
  schemaLD={schemaLD}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 lg:py-12">

    <Breadcrumb crumbs={[{ label: 'Home', href: '/' }, { label: 'Printable Mazes' }]} />

    <!-- Hero -->
    <div class="mt-6 mb-12 md:mb-16 lg:mb-20">
      <h1 class="text-5xl sm:text-6xl lg:text-7xl xl:text-8xl mb-5">Free Maze Printables</h1>
      <p class="text-lg sm:text-xl md:text-2xl max-w-2xl leading-relaxed" style="color: var(--color-muted-strong);">
        Generate clean maze worksheets in seconds. Choose a size and print an ad-free page — no account required.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a href="#generator" class="btn-primary px-6 md:px-8 py-3 md:py-3.5 text-sm md:text-base">Generate a Printable Maze</a>
        <a href="/maze-generator" class="btn-secondary px-6 md:px-8 py-3 md:py-3.5 text-sm md:text-base">Open Maze Generator</a>
      </div>
      <p class="mt-4 text-base" style="color: var(--color-muted-strong);">
        Ad-free printouts — no account required.
      </p>
    </div>

    <!-- Generator island -->
    <div id="generator" class="mb-16 lg:mb-20">
      <h2 class="text-2xl md:text-3xl mb-6" style="color: var(--color-charcoal);">Generate a printable maze</h2>
      <PrintableMazeGenerator client:only="react">
        <!-- Fallback shown before JS hydrates -->
        <div slot="fallback" class="rounded-lg border p-8 text-center" style="border-color: var(--color-border); color: var(--color-muted-strong);">
          <p class="text-base">Loading maze generator…</p>
        </div>
      </PrintableMazeGenerator>
    </div>

    <!-- How printing works -->
    <div class="mb-14 lg:mb-16 max-w-2xl">
      <h2 class="text-2xl md:text-3xl mb-6" style="color: var(--color-charcoal);">How printing works</h2>
      <ol class="space-y-4">
        {[
          { n: '1', text: 'Choose a size above — Small, Medium, Large, Expert, or Monster.' },
          { n: '2', text: 'Click <strong>Generate Printable Maze</strong> to create a fresh random maze.' },
          { n: '3', text: 'Click <strong>Print Maze</strong> for a clean, ad-free printout — just the maze, nothing else.' },
          { n: '4', text: 'Print on standard Letter or A4 paper. Repeat as many times as you like.' },
        ].map(({ n, text }) => (
          <li class="flex gap-4 items-start">
            <span
              class="flex-shrink-0 flex items-center justify-center w-7 h-7 rounded-full text-white text-xs font-bold"
              style="background-color: var(--color-accent);"
            >{n}</span>
            <span class="text-base pt-0.5 leading-relaxed" style="color: var(--color-muted-strong);" set:html={text} />
          </li>
        ))}
      </ol>
    </div>

    <!-- Why print mazes -->
    <div class="mb-14 lg:mb-16">
      <h2 class="text-2xl md:text-3xl mb-6" style="color: var(--color-charcoal);">Why print mazes?</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 lg:gap-5 max-w-3xl">
        {[
          {
            heading: 'No screens required',
            body: 'A printed maze works anywhere — at a table, in the car, or in a classroom with no devices.',
          },
          {
            heading: 'Fine motor and focus',
            body: 'Tracing a pencil through a maze builds fine motor skills and sustained attention in children.',
          },
          {
            heading: 'Unlimited copies',
            body: 'Generate and print as many mazes as you need — ideal for classroom sets or family activity packs.',
          },
          {
            heading: 'Clean, portable fun',
            body: 'Completed puzzles can be kept, shared, or displayed. A solved paper maze has a satisfying finality.',
          },
        ].map(({ heading, body }) => (
          <div class="card p-5">
            <p class="font-semibold mb-1.5" style="color: var(--color-charcoal);">{heading}</p>
            <p class="text-sm leading-relaxed" style="color: var(--color-muted-strong);">{body}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Printing tips -->
    <div class="mb-14 lg:mb-16 max-w-2xl">
      <h2 class="text-2xl md:text-3xl mb-5" style="color: var(--color-charcoal);">Printing tips</h2>
      <ul class="space-y-3">
        {[
          { label: 'Paper size', tip: 'Standard 8.5×11 (Letter) or A4 works for all maze sizes.' },
          { label: 'Black and white', tip: 'All mazes are black and white. Use grayscale mode to save ink.' },
          { label: 'Fit to page', tip: 'Print at 100% scale for correct line thickness. Avoid automatic scaling.' },
          { label: 'Classroom copies', tip: 'Generate and print as many copies as you need — no limits.' },
        ].map(({ label, tip }) => (
          <li class="flex gap-3 items-start text-sm" style="color: var(--color-muted-strong);">
            <span
              class="flex-shrink-0 rounded-full"
              style="background-color: var(--color-accent); width: 6px; height: 6px; margin-top: 6px; flex-shrink: 0;"
            />
            <span><strong style="color: var(--color-charcoal);">{label}:</strong> {tip}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Comparison: Printable vs Library vs Generator -->
    <div class="mb-14 lg:mb-16">
      <h2 class="text-2xl md:text-3xl mb-6" style="color: var(--color-charcoal);">Printable Mazes vs. Maze Library vs. Maze Generator</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 lg:gap-5">
        <div class="card p-5 lg:p-6">
          <p
            class="text-xs font-semibold uppercase tracking-wider mb-2"
            style="font-family: 'IBM Plex Mono', monospace; color: var(--color-accent);"
          >You are here</p>
          <p class="font-semibold text-lg mb-1.5" style="color: var(--color-charcoal);">Printable Mazes</p>
          <p class="text-sm leading-relaxed mb-4" style="color: var(--color-muted-strong);">Generate ready-made maze worksheets and print them on paper. No account needed, unlimited mazes.</p>
          <span class="text-sm font-medium" style="color: var(--color-accent);">Print on paper →</span>
        </div>
        <a href="/maze-library" class="card-hover flex flex-col p-5 lg:p-6 no-underline">
          <p
            class="text-xs font-semibold uppercase tracking-wider mb-2"
            style="font-family: 'IBM Plex Mono', monospace; color: var(--color-muted-strong);"
          >Track progress</p>
          <p class="font-semibold text-lg mb-1.5" style="color: var(--color-charcoal);">Maze Library</p>
          <p class="text-sm leading-relaxed mb-4" style="color: var(--color-muted-strong);">Fixed online collections you can play and track over time. Progress saves on your device.</p>
          <span class="text-sm font-medium mt-auto" style="color: var(--color-accent);">Browse the library →</span>
        </a>
        <a href="/maze-generator" class="card-hover flex flex-col p-5 lg:p-6 no-underline">
          <p
            class="text-xs font-semibold uppercase tracking-wider mb-2"
            style="font-family: 'IBM Plex Mono', monospace; color: var(--color-muted-strong);"
          >Custom size</p>
          <p class="font-semibold text-lg mb-1.5" style="color: var(--color-charcoal);">Maze Generator</p>
          <p class="text-sm leading-relaxed mb-4" style="color: var(--color-muted-strong);">Generate a maze in any size, play it online, download as SVG, or print from your browser.</p>
          <span class="text-sm font-medium mt-auto" style="color: var(--color-accent);">Create a maze →</span>
        </a>
      </div>
    </div>

    <!-- FAQ -->
    <div class="max-w-2xl mb-12">
      <h2 class="text-2xl md:text-3xl mb-6" style="color: var(--color-charcoal);">Frequently asked questions</h2>
      <div class="space-y-2">
        {faqItems.map(({ q, a }) => (
          <details class="group border rounded-lg" style="border-color: var(--color-border);">
            <summary
              class="flex cursor-pointer items-center justify-between px-4 py-4 font-semibold select-none list-none [&::-webkit-details-marker]:hidden"
              style="color: var(--color-charcoal);"
            >
              {q}
              <svg
                class="h-4 w-4 shrink-0 ml-3 transition-transform duration-200 group-open:rotate-180"
                style="color: var(--color-muted-strong);"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
              </svg>
            </summary>
            <div class="px-4 pb-4 text-base leading-relaxed" style="color: var(--color-muted-strong);">
              {a}
            </div>
          </details>
        ))}
      </div>
    </div>

  </div>
</BaseLayout>
