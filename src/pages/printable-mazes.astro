---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/nav/Breadcrumb.astro';
import CategoryNav from '../components/nav/CategoryNav.astro';
import MazeCard from '../components/ui/MazeCard.astro';
import { getMazesByDifficulty } from '../lib/catalog/index.js';

const smallMazes  = getMazesByDifficulty('small').slice(0, 5);
const mediumMazes = getMazesByDifficulty('medium').slice(0, 5);
const largeMazes  = getMazesByDifficulty('large').slice(0, 5);

const siteUrl = import.meta.env.SITE || 'https://mazethis.com';

const schemaLD = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Free Printable Mazes',
  description: 'Download and print 150+ free maze puzzles in small, medium, and large sizes. Clean print layouts — no ads.',
  url: `${siteUrl}/printable-mazes`,
  publisher: { '@type': 'Organization', name: 'MazeThis', url: siteUrl },
});
---

<BaseLayout
  title="Free Printable Mazes — 150+ to Download & Print | MazeThis"
  description="Download and print 150+ free maze puzzles. Small mazes for quick fun, medium mazes for a real challenge, and large mazes for serious solvers. Clean print layouts — no ads, no sign-up required."
  schemaLD={schemaLD}
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-10">
    <Breadcrumb crumbs={[{ label: 'Home', href: '/' }, { label: 'Printable Mazes' }]} />

    <div class="mt-4 mb-8">
      <h1 class="mb-3">Free Printable Mazes</h1>
      <p class="text-slate-500 text-lg max-w-3xl">
        150+ free printable maze puzzles in three sizes. Click any maze, then
        hit "Print Maze" for a clean, ad-free printout — ready in seconds, no account needed.
      </p>
    </div>

    <!-- Quick category nav -->
    <div class="mb-10">
      <CategoryNav />
    </div>

    <!-- How to print -->
    <div class="mb-12 rounded-xl bg-blue-50 border border-blue-100 p-6">
      <h2 class="text-lg font-bold text-slate-800 mb-3">How to Print a Maze</h2>
      <ol class="space-y-2 text-sm text-slate-600">
        <li class="flex gap-3">
          <span class="flex-shrink-0 flex items-center justify-center w-6 h-6 rounded-full bg-blue-600 text-white text-xs font-bold">1</span>
          <span>Click any maze below (or browse by size above)</span>
        </li>
        <li class="flex gap-3">
          <span class="flex-shrink-0 flex items-center justify-center w-6 h-6 rounded-full bg-blue-600 text-white text-xs font-bold">2</span>
          <span>Click the <strong>"Print Maze"</strong> button on the maze page</span>
        </li>
        <li class="flex gap-3">
          <span class="flex-shrink-0 flex items-center justify-center w-6 h-6 rounded-full bg-blue-600 text-white text-xs font-bold">3</span>
          <span>Your browser opens a clean print view — no ads, no navigation, just the maze</span>
        </li>
        <li class="flex gap-3">
          <span class="flex-shrink-0 flex items-center justify-center w-6 h-6 rounded-full bg-blue-600 text-white text-xs font-bold">4</span>
          <span>Print on standard 8.5×11 (Letter) or A4 paper and you're done</span>
        </li>
      </ol>
    </div>

    <!-- Small mazes preview -->
    <section class="mb-12">
      <div class="flex items-center justify-between mb-5">
        <div>
          <h2 class="text-xl font-bold text-slate-800">Small Printable Mazes</h2>
          <p class="text-slate-500 text-sm mt-1">20×20 grid — quick and approachable for all ages</p>
        </div>
        <a href="/small-mazes" class="text-sm font-medium text-blue-600 hover:underline whitespace-nowrap">
          All 60 small mazes →
        </a>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4">
        {smallMazes.map((entry) => <MazeCard entry={entry} />)}
      </div>
    </section>

    <!-- Medium mazes preview -->
    <section class="mb-12">
      <div class="flex items-center justify-between mb-5">
        <div>
          <h2 class="text-xl font-bold text-slate-800">Medium Printable Mazes</h2>
          <p class="text-slate-500 text-sm mt-1">40×40 grid — a focused challenge with real decision points</p>
        </div>
        <a href="/medium-mazes" class="text-sm font-medium text-blue-600 hover:underline whitespace-nowrap">
          All 50 medium mazes →
        </a>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4">
        {mediumMazes.map((entry) => <MazeCard entry={entry} />)}
      </div>
    </section>

    <!-- Large mazes preview -->
    <section class="mb-12">
      <div class="flex items-center justify-between mb-5">
        <div>
          <h2 class="text-xl font-bold text-slate-800">Large Printable Mazes</h2>
          <p class="text-slate-500 text-sm mt-1">60×60 grid — dense labyrinth, easy to get lost</p>
        </div>
        <a href="/large-mazes" class="text-sm font-medium text-blue-600 hover:underline whitespace-nowrap">
          All 40 large mazes →
        </a>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4">
        {largeMazes.map((entry) => <MazeCard entry={entry} />)}
      </div>
    </section>

    <!-- Content section -->
    <section class="mt-8 prose prose-slate max-w-none">
      <h2>Why Print Mazes?</h2>
      <p>
        Printed mazes have advantages that screens can't replicate: the physical act of tracing with a pencil
        develops fine motor skills in children, and the tangible paper copy can be kept, shared, or displayed.
        There's also something satisfying about a completed paper maze that a solved digital one can't quite match.
      </p>
      <p>
        For teachers and homeschool parents, printed mazes are invaluable: self-contained activities that require
        no devices, no internet, no setup. A stack of maze worksheets can occupy a classroom for an extended period
        and serve as both entertainment and genuine skills practice.
      </p>
      <h2>Printing Tips</h2>
      <ul>
        <li><strong>Paper size:</strong> Standard 8.5×11 (Letter) or A4 paper works for all mazes</li>
        <li><strong>Color vs. grayscale:</strong> All mazes are black and white — use grayscale mode to save ink</li>
        <li><strong>Scale:</strong> Print at 100% (actual size) for correct line thickness</li>
        <li><strong>Multiple copies:</strong> Each maze page can be printed unlimited times — great for classroom sets</li>
      </ul>
      <p>
        Need something specific? Use the <a href="/maze-generator">free maze generator</a> to create
        a custom maze in any size — then print or download it.
      </p>
    </section>
  </div>
</BaseLayout>
