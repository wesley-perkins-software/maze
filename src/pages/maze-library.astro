---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/nav/Breadcrumb.astro';
import { CATEGORIES } from '../types/maze.js';
import { getAllLibraryMazes, getLibraryMazesByDifficulty } from '../lib/library/catalog.js';

const mazes = getAllLibraryMazes();
const totalCount = mazes.length;

const tierCounts: Record<string, number> = {};
const tierFirstIds: Record<string, string> = {};
const tierAllIds: Record<string, string[]> = {};
for (const cat of CATEGORIES) {
  const tierMazes = getLibraryMazesByDifficulty(cat.difficulty);
  tierCounts[cat.difficulty] = tierMazes.length;
  tierFirstIds[cat.difficulty] = tierMazes[0]?.id ?? '';
  tierAllIds[cat.difficulty] = tierMazes.map((m) => m.id);
}

const gridSizes: Record<string, string> = {
  small:   '20×20',
  medium:  '40×40',
  large:   '60×60',
  expert:  '80×80',
  monster: '100×100',
};

const tierDescriptions: Record<string, string> = {
  small:   'Quick, approachable puzzles. Great for warm-ups and casual play.',
  medium:  'Real branching paths and genuine decision points.',
  large:   'Dense labyrinths that are genuinely easy to get lost in.',
  expert:  'Long corridors and deep branching. Serious challenge.',
  monster: 'The hardest mazes in the collection. Extreme scale.',
};

const schemaLD = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': 'https://mazethis.com/maze-library',
      url: 'https://mazethis.com/maze-library',
      name: 'Maze Library — Play & Complete 160 Curated Mazes | MazeThis',
      description:
        'Browse 160 curated maze puzzles across five sizes. Track your progress and complete the full MazeThis collection — free to play in your browser.',
      isPartOf: { '@id': 'https://mazethis.com/#website' },
      breadcrumb: { '@id': 'https://mazethis.com/maze-library#breadcrumb' },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://mazethis.com/maze-library#breadcrumb',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://mazethis.com/' },
        { '@type': 'ListItem', position: 2, name: 'Maze Library' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What is the Maze Library?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'The Maze Library is a curated collection of 160 maze puzzles across five sizes: Small, Medium, Large, Expert, and Monster. Each maze is uniquely generated and permanently available to play in your browser.',
          },
        },
        {
          '@type': 'Question',
          name: 'How many mazes are in the Maze Library?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'There are 160 mazes in total: 40 Small, 40 Medium, 40 Large, 25 Expert, and 15 Monster.',
          },
        },
        {
          '@type': 'Question',
          name: 'Is the Maze Library free?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. Every maze in the Maze Library is free to play directly in your browser — no account or download required.',
          },
        },
        {
          '@type': 'Question',
          name: 'How do I track my progress?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Progress is saved on your device. After solving a maze, your completion is recorded so you can see which mazes you have finished across each collection.',
          },
        },
      ],
    },
  ],
});
---

<BaseLayout
  title="Maze Library — Play & Complete 160 Curated Mazes | MazeThis"
  description="Browse 160 curated maze puzzles across five sizes. Track your progress and complete the full MazeThis collection — free to play in your browser."
  schemaLD={schemaLD}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">

    <Breadcrumb crumbs={[{ label: 'Home', href: '/' }, { label: 'Maze Library' }]} />

    <!-- Hero -->
    <div class="mt-6 mb-10">
      <h1 class="mb-3">Maze Library</h1>
      <p class="text-slate-500 text-lg max-w-2xl">
        {totalCount} curated maze puzzles across five sizes. Complete every maze in the MazeThis collection — play free in your browser, no account required.
      </p>
    </div>

    <!-- Tier cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-4 mb-12">
      {CATEGORIES.map((cat) => {
        const count = tierCounts[cat.difficulty] ?? 0;
        const gridSize = gridSizes[cat.difficulty] ?? '';
        const desc = tierDescriptions[cat.difficulty] ?? '';
        const firstId = tierFirstIds[cat.difficulty] ?? '';
        return (
          <div
            class="card flex flex-col p-5 gap-3"
            data-tier={cat.difficulty}
            data-tier-total={count}
            data-tier-first-id={firstId}
          >
            <div>
              <p class="text-xs font-mono text-slate-400 mb-1">{gridSize} grid</p>
              <h2 class="text-lg font-bold" style="color: var(--color-charcoal);">{cat.label}</h2>
              <p class="text-slate-500 text-sm mt-1">{desc}</p>
            </div>

            <!-- Progress (updated client-side) -->
            <div class="mt-auto space-y-1.5">
              <div class="flex items-baseline justify-between gap-1">
                <span
                  class="tier-progress-text text-xs font-semibold text-slate-600"
                  data-total={count}
                >
                  0 / {count}
                </span>
                <span class="text-xs text-slate-400">complete</span>
              </div>
              <div class="h-1 rounded-full bg-slate-100 overflow-hidden">
                <div
                  class="tier-progress-bar h-full rounded-full bg-emerald-500 transition-all duration-500"
                  style="width:0%"
                />
              </div>
            </div>

            <div class="flex items-center gap-2 pt-1">
              <a
                href={`/${cat.slug}`}
                class="flex-1 text-center rounded-lg border py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-50 transition-colors"
                style="border-color: var(--color-border);"
              >
                Browse
              </a>
              <a
                href={firstId ? `/play/library/${firstId}` : `/${cat.slug}`}
                class="tier-play-next flex-1 text-center btn-primary rounded-lg py-1.5 text-xs"
                data-all-ids={JSON.stringify(tierAllIds[cat.difficulty] ?? [])}
              >
                Play Next
              </a>
            </div>
          </div>
        );
      })}
    </div>

    <!-- FAQ -->
    <div class="max-w-2xl">
      <h2 class="text-xl font-bold mb-5" style="color: var(--color-charcoal);">About the Maze Library</h2>
      <dl class="space-y-5">
        <div>
          <dt class="font-semibold text-slate-800">What is the Maze Library?</dt>
          <dd class="mt-1 text-slate-600 text-sm">
            The Maze Library is a curated collection of {totalCount} maze puzzles across five sizes — Small (20×20), Medium (40×40), Large (60×60), Expert (80×80), and Monster (100×100). Each maze is uniquely generated and permanently available to play in your browser.
          </dd>
        </div>
        <div>
          <dt class="font-semibold text-slate-800">How many mazes are there?</dt>
          <dd class="mt-1 text-slate-600 text-sm">
            160 in total: 40 Small, 40 Medium, 40 Large, 25 Expert, and 15 Monster. Every maze has a fixed layout — the same maze is always at the same URL.
          </dd>
        </div>
        <div>
          <dt class="font-semibold text-slate-800">Is the Maze Library free?</dt>
          <dd class="mt-1 text-slate-600 text-sm">
            Yes. Every maze is free to play directly in your browser — no account, no download, no sign-up required.
          </dd>
        </div>
        <div>
          <dt class="font-semibold text-slate-800">How do I track my progress?</dt>
          <dd class="mt-1 text-slate-600 text-sm">
            Progress is saved on your device. After solving a maze, your completion is recorded so you can see which mazes you have finished across each collection.
          </dd>
        </div>
        <div>
          <dt class="font-semibold text-slate-800">What is the hardest tier?</dt>
          <dd class="mt-1 text-slate-600 text-sm">
            Monster mazes are the hardest in the collection — 100×100 grids with extremely long solution paths. Expert mazes (80×80) are a solid step up from Large before tackling Monster.
          </dd>
        </div>
      </dl>
    </div>

    <!-- Secondary CTA -->
    <div class="mt-12 rounded-2xl bg-blue-50 border border-blue-100 p-8 text-center">
      <h2 class="text-xl font-bold text-slate-800 mb-2">Want an infinite challenge?</h2>
      <p class="text-slate-600 mb-4">
        Use the free maze generator to create mazes in any size — from tiny 5×5 grids to custom giants.
      </p>
      <a href="/maze-generator" class="btn-primary">Open Maze Generator</a>
    </div>

  </div>
</BaseLayout>

<script>
  (function () {
    try {
      var raw = localStorage.getItem('mazethis.library.progress');
      var parsed = raw ? JSON.parse(raw) : null;
      var ids = Array.isArray(parsed && parsed.completedMazeIds) ? parsed.completedMazeIds : [];
      var done = new Set(ids);

      document.querySelectorAll('[data-tier]').forEach(function (card) {
        var tier = card.getAttribute('data-tier');
        var total = parseInt(card.getAttribute('data-tier-total') || '0', 10);
        if (!tier || !total) return;

        var prefix = tier + '-';
        var count = 0;
        done.forEach(function (id) {
          if (typeof id === 'string' && id.startsWith(prefix)) count++;
        });

        var textEl = card.querySelector('.tier-progress-text');
        if (textEl) textEl.textContent = count + ' / ' + total;

        var barEl = card.querySelector('.tier-progress-bar');
        if (barEl) barEl.setAttribute('style', 'width:' + Math.round((count / total) * 100) + '%');

        var link = card.querySelector('.tier-play-next');
        if (!link) return;
        var allIds = [];
        try { allIds = JSON.parse(link.getAttribute('data-all-ids') || '[]'); } catch (_) {}
        if (!Array.isArray(allIds) || allIds.length === 0) return;

        var next = allIds.find(function (id) { return !done.has(id); });
        if (next) {
          link.setAttribute('href', '/play/library/' + next);
        } else {
          link.textContent = 'All Complete ✓';
          link.removeAttribute('href');
          link.setAttribute('style', 'opacity:0.55;pointer-events:none;');
        }
      });
    } catch (_) {}
  })();
</script>
