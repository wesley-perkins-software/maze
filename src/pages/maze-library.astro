---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/nav/Breadcrumb.astro';
import { CATEGORIES } from '../types/maze.js';
import { getAllLibraryMazes, getLibraryMazesByDifficulty } from '../lib/library/catalog.js';

const mazes = getAllLibraryMazes();
const totalCount = mazes.length;

const tierCounts: Record<string, number> = {};
const tierFirstIds: Record<string, string> = {};
const tierAllIds: Record<string, string[]> = {};
for (const cat of CATEGORIES) {
  const tierMazes = getLibraryMazesByDifficulty(cat.difficulty);
  tierCounts[cat.difficulty] = tierMazes.length;
  tierFirstIds[cat.difficulty] = tierMazes[0]?.id ?? '';
  tierAllIds[cat.difficulty] = tierMazes.map((m) => m.id);
}

const gridSizes: Record<string, string> = {
  small:   '20×20',
  medium:  '40×40',
  large:   '60×60',
  expert:  '80×80',
  monster: '100×100',
};

const tierPositioning: Record<string, string> = {
  small:   'Best for quick solves',
  medium:  'Balanced challenge',
  large:   'Longer sessions',
  expert:  'Experienced solvers',
  monster: 'Serious focus',
};

const tierDescriptions: Record<string, string> = {
  small:   'Quick 20×20 maze puzzles for fast solves.',
  medium:  'Balanced 40×40 mazes with more room to explore.',
  large:   'Bigger 60×60 maze challenges for longer sessions.',
  expert:  'Demanding 80×80 mazes for experienced solvers.',
  monster: 'Huge 100×100 maze puzzles built for serious focus.',
};

const faqItems = [
  {
    q: 'Are these mazes free?',
    a: `Yes. Every maze in the Maze Library is free to play — no account, no sign-up, and no payment required. All ${totalCount} mazes are available in your browser at any time.`,
  },
  {
    q: 'Can I play the mazes online?',
    a: 'Yes. All mazes play directly in your browser. Use the arrow keys or WASD on desktop, or the on-screen D-pad on mobile and tablet. No download or app is needed.',
  },
  {
    q: 'Do the mazes save my progress?',
    a: 'Yes. After you solve a maze, your completion is saved to your device. The progress bars on this page update to show how many mazes you have finished in each size tier. Progress is stored in your browser and persists between visits without an account.',
  },
  {
    q: 'What maze size should I start with?',
    a: 'If you are new to maze puzzles, start with Small Mazes. The 20×20 grid is quick to complete and easy to orient yourself. Once you are comfortable, Medium Mazes (40×40) are a natural step up with more branching paths.',
  },
  {
    q: 'What is the hardest maze in the library?',
    a: 'Monster Mazes are the hardest — 100×100 grids with extremely long solution paths. Expert Mazes (80×80) are a significant challenge in their own right and a good step before tackling Monster.',
  },
  {
    q: 'Can I print these mazes?',
    a: 'The library mazes are optimized for online play. For print-ready puzzles, visit the Printable Mazes page or use the Maze Generator to create and download a maze in any size.',
  },
  {
    q: 'How many mazes are in the Maze Library?',
    a: `There are ${totalCount} mazes in total: ${tierCounts.small} Small, ${tierCounts.medium} Medium, ${tierCounts.large} Large, ${tierCounts.expert} Expert, and ${tierCounts.monster} Monster. Every maze has a fixed layout — the same puzzle is always at the same URL.`,
  },
  {
    q: 'What is the difference between the Maze Library and the Maze Generator?',
    a: `The Maze Library is a curated collection of ${totalCount} fixed mazes — each one is permanent, numbered, and completable as part of a set. The Maze Generator creates a new unique maze on demand, in any size, with no fixed layout. Use the Library to work through a collection; use the Generator for infinite variety.`,
  },
];

const schemaLD = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': 'https://mazethis.com/maze-library',
      url: 'https://mazethis.com/maze-library',
      name: 'Free Online Mazes - Play Maze Puzzles by Size | MazeThis',
      description:
        'Play free online maze puzzles in five sizes — small, medium, large, expert, and monster. Track your progress and work through each collection at your own pace.',
      isPartOf: { '@id': 'https://mazethis.com/#website' },
      breadcrumb: { '@id': 'https://mazethis.com/maze-library#breadcrumb' },
      about: {
        '@type': 'Dataset',
        name: 'MazeThis Maze Library',
        description:
          `A curated collection of ${totalCount} free online maze puzzles across five sizes: ${tierCounts.small} Small (20×20), ${tierCounts.medium} Medium (40×40), ${tierCounts.large} Large (60×60), ${tierCounts.expert} Expert (80×80), and ${tierCounts.monster} Monster (100×100).`,
        url: 'https://mazethis.com/maze-library',
        publisher: { '@type': 'Organization', name: 'MazeThis', url: 'https://mazethis.com' },
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://mazethis.com/maze-library#breadcrumb',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://mazethis.com/' },
        { '@type': 'ListItem', position: 2, name: 'Maze Library', item: 'https://mazethis.com/maze-library' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqItems.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ],
});
---

<BaseLayout
  title="Free Online Mazes - Play Maze Puzzles by Size | MazeThis"
  description="Play free online maze puzzles in five sizes — small, medium, large, expert, and monster. Track your progress and work through each collection at your own pace."
  schemaLD={schemaLD}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 lg:py-12">

    <Breadcrumb crumbs={[{ label: 'Home', href: '/' }, { label: 'Maze Library' }]} />

    <!-- Hero -->
    <div class="mt-6 mb-12 md:mb-16 lg:mb-20">
      <h1 class="text-5xl sm:text-6xl lg:text-7xl xl:text-8xl mb-5">Free Online Mazes</h1>
      <p class="text-base sm:text-lg md:text-xl max-w-2xl leading-relaxed" style="color: var(--color-muted-strong);">
        Choose a maze by size and start playing instantly. Track your progress through each collection, play today's maze, or generate a custom maze anytime.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a href="#maze-collections" class="btn-primary px-6 md:px-8 py-3 md:py-3.5 text-sm md:text-base">Choose a Maze</a>
        <a href="/play/maze-of-the-day/" class="btn-secondary px-6 md:px-8 py-3 md:py-3.5 text-sm md:text-base">Play Today's Maze</a>
        <a href="/maze-generator" class="btn-secondary px-5 md:px-7 py-3 md:py-3.5 text-sm md:text-base">Make a Maze</a>
      </div>
      <p class="mt-4 text-sm" style="color: var(--color-muted-strong);">
        Progress saves on your device — no account required.
      </p>
    </div>

    <!-- Maze Collections -->
    <div id="maze-collections" class="mb-14 lg:mb-16">
      <h2 class="text-2xl md:text-3xl mb-6 lg:mb-8" style="color: var(--color-charcoal);">Maze Collections</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-4 lg:gap-5">
        {CATEGORIES.map((cat) => {
          const count = tierCounts[cat.difficulty] ?? 0;
          const gridSize = gridSizes[cat.difficulty] ?? '';
          const desc = tierDescriptions[cat.difficulty] ?? '';
          const positioning = tierPositioning[cat.difficulty] ?? '';
          const firstId = tierFirstIds[cat.difficulty] ?? '';
          return (
            <div
              class="card flex flex-col p-5 lg:p-6 gap-3"
              data-tier={cat.difficulty}
              data-tier-total={count}
              data-tier-first-id={firstId}
            >
              <div class="flex-1">
                <p
                  class="text-xs font-semibold uppercase tracking-wider mb-2"
                  style="font-family: 'IBM Plex Mono', monospace; color: var(--color-accent);"
                >{positioning}</p>
                <p
                  class="text-xs mb-1.5"
                  style="font-family: 'IBM Plex Mono', monospace; color: var(--color-muted-strong);"
                >{gridSize} grid</p>
                <h3
                  class="text-xl md:text-2xl tracking-tight leading-none mb-2"
                  style="font-family: 'Bebas Neue', sans-serif; color: var(--color-charcoal);"
                >{cat.label}</h3>
                <p class="text-sm leading-snug" style="color: var(--color-muted-strong);">{desc}</p>
              </div>

              <!-- Progress (updated client-side) -->
              <div class="space-y-1.5">
                <div class="flex items-baseline justify-between gap-1">
                  <span
                    class="tier-progress-text text-xs font-semibold"
                    style="color: var(--color-muted-strong);"
                    data-total={count}
                  >
                    0 / {count}
                  </span>
                  <span class="text-xs" style="color: var(--color-muted-strong);">complete</span>
                </div>
                <div class="tier-progress-container h-1.5 rounded-full overflow-hidden">
                  <div
                    class="tier-progress-bar h-full rounded-full transition-all duration-500"
                    style="width:0%"
                  />
                </div>
              </div>

              <div class="flex items-center gap-2">
                <a
                  href={`/${cat.slug}`}
                  class="flex-1 text-center rounded-lg border py-2 text-xs font-medium transition-colors"
                  style="border-color: var(--color-border); color: var(--color-muted-strong);"
                  onmouseover="this.style.backgroundColor='var(--color-border)'; this.style.color='var(--color-charcoal)';"
                  onmouseout="this.style.backgroundColor=''; this.style.color='var(--color-muted-strong)';"
                >
                  Browse
                </a>
                <a
                  href={firstId ? `/play/library/${firstId}` : `/${cat.slug}`}
                  class="tier-play-next flex-1 text-center rounded-lg py-2 text-xs font-semibold transition-colors"
                  style="border: 1px solid var(--color-accent); color: var(--color-accent);"
                  data-all-ids={JSON.stringify(tierAllIds[cat.difficulty] ?? [])}
                  onmouseover="this.style.backgroundColor='var(--color-accent)'; this.style.color='#ffffff';"
                  onmouseout="this.style.backgroundColor=''; this.style.color='var(--color-accent)';"
                >
                  Play Next
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <!-- More Ways to Play -->
    <div class="mb-14 lg:mb-16">
      <h2 class="text-2xl md:text-3xl mb-6" style="color: var(--color-charcoal);">More Ways to Play</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 lg:gap-5">
        <a href="/maze-of-the-day" class="card-hover flex flex-col p-5 lg:p-6 gap-3 no-underline">
          <div>
            <p class="font-semibold text-base mb-1.5" style="color: var(--color-charcoal);">Daily Challenge</p>
            <p class="text-sm leading-relaxed" style="color: var(--color-muted-strong);">Play one new maze each day.</p>
          </div>
          <span class="text-sm font-medium mt-auto" style="color: var(--color-accent);">Play today →</span>
        </a>
        <a href="/maze-generator" class="card-hover flex flex-col p-5 lg:p-6 gap-3 no-underline">
          <div>
            <p class="font-semibold text-base mb-1.5" style="color: var(--color-charcoal);">Maze Generator</p>
            <p class="text-sm leading-relaxed" style="color: var(--color-muted-strong);">Create a custom maze by size.</p>
          </div>
          <span class="text-sm font-medium mt-auto" style="color: var(--color-accent);">Try it →</span>
        </a>
        <a href="/printable-mazes" class="card-hover flex flex-col p-5 lg:p-6 gap-3 no-underline">
          <div>
            <p class="font-semibold text-base mb-1.5" style="color: var(--color-charcoal);">Printable Mazes</p>
            <p class="text-sm leading-relaxed" style="color: var(--color-muted-strong);">Print maze puzzles for paper solves and classroom use.</p>
          </div>
          <span class="text-sm font-medium mt-auto" style="color: var(--color-accent);">Browse →</span>
        </a>
      </div>
    </div>

    <!-- FAQ -->
    <div class="max-w-2xl mb-12">
      <h2 class="text-2xl md:text-3xl mb-6" style="color: var(--color-charcoal);">About the Maze Library</h2>
      <div class="space-y-2">
        {faqItems.map(({ q, a }) => (
          <details class="group border rounded-lg" style="border-color: var(--color-border);">
            <summary
              class="flex cursor-pointer items-center justify-between px-4 py-3.5 font-semibold select-none list-none [&::-webkit-details-marker]:hidden"
              style="color: var(--color-charcoal);"
            >
              {q}
              <svg
                class="h-4 w-4 shrink-0 ml-3 transition-transform duration-200 group-open:rotate-180"
                style="color: var(--color-muted-strong);"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
              </svg>
            </summary>
            <div class="px-4 pb-4 text-sm leading-relaxed" style="color: var(--color-muted-strong);">
              {a}
            </div>
          </details>
        ))}
      </div>
    </div>

  </div>
</BaseLayout>

<script>
  (function () {
    try {
      var raw = localStorage.getItem('mazethis.library.progress');
      var parsed = raw ? JSON.parse(raw) : null;
      var ids = Array.isArray(parsed && parsed.completedMazeIds) ? parsed.completedMazeIds : [];
      var done = new Set(ids);

      document.querySelectorAll('[data-tier]').forEach(function (card) {
        var tier = card.getAttribute('data-tier');
        var total = parseInt(card.getAttribute('data-tier-total') || '0', 10);
        if (!tier || !total) return;

        var prefix = tier + '-';
        var count = 0;
        done.forEach(function (id) {
          if (typeof id === 'string' && id.startsWith(prefix)) count++;
        });

        var textEl = card.querySelector('.tier-progress-text');
        if (textEl) textEl.textContent = count + ' / ' + total;

        var barEl = card.querySelector('.tier-progress-bar');
        if (barEl) barEl.setAttribute('style', 'width:' + Math.round((count / total) * 100) + '%');

        var link = card.querySelector('.tier-play-next');
        if (!link) return;
        var allIds = [];
        try { allIds = JSON.parse(link.getAttribute('data-all-ids') || '[]'); } catch (_) {}
        if (!Array.isArray(allIds) || allIds.length === 0) return;

        var next = allIds.find(function (id) { return !done.has(id); });
        if (next) {
          link.setAttribute('href', '/play/library/' + next);
        } else {
          link.textContent = 'All Complete ✓';
          link.removeAttribute('href');
          link.setAttribute('style', 'opacity:0.55;pointer-events:none;');
        }
      });
    } catch (_) {}
  })();
</script>
