---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/nav/Breadcrumb.astro';
import { CATEGORIES } from '../types/maze.js';
import { getAllLibraryMazes, getLibraryMazesByDifficulty } from '../lib/library/catalog.js';

const mazes = getAllLibraryMazes();
const totalCount = mazes.length;

const tierCounts: Record<string, number> = {};
const tierFirstIds: Record<string, string> = {};
const tierAllIds: Record<string, string[]> = {};
for (const cat of CATEGORIES) {
  const tierMazes = getLibraryMazesByDifficulty(cat.difficulty);
  tierCounts[cat.difficulty] = tierMazes.length;
  tierFirstIds[cat.difficulty] = tierMazes[0]?.id ?? '';
  tierAllIds[cat.difficulty] = tierMazes.map((m) => m.id);
}

const gridSizes: Record<string, string> = {
  small:   '20×20',
  medium:  '40×40',
  large:   '60×60',
  expert:  '80×80',
  hardcore: '100×100',
};

const tierPositioning: Record<string, string> = {
  small:   'Best for quick solves',
  medium:  'Balanced challenge',
  large:   'Longer sessions',
  expert:  'Experienced solvers',
  hardcore: 'Serious focus',
};

const tierDescriptions: Record<string, string> = {
  small:   'Quick 20×20 maze puzzles for fast solves.',
  medium:  'Balanced 40×40 mazes with more room to explore.',
  large:   'Bigger 60×60 maze challenges for longer sessions.',
  expert:  'Demanding 80×80 mazes for experienced solvers.',
  hardcore: 'Huge 100×100 maze puzzles built for serious focus.',
};

const faqItems = [
  {
    q: 'What is the Maze Library?',
    a: 'The Maze Library is a set of maze collections you can solve over time. Every maze has a permanent spot in a numbered collection, so you can track your progress and work toward completing them all.',
  },
  {
    q: 'How is the Maze Library different from the Maze of the Day?',
    a: 'The Maze of the Day offers one new puzzle each day — it changes daily and cannot be replayed. The Maze Library contains collections that are always available, so you can solve them at your own pace and come back where you left off.',
  },
  {
    q: 'How is the Maze Library different from the Maze Generator?',
    a: 'The Maze Generator creates a unique random maze on demand, with no set layout or progress tracking. The Maze Library contains numbered, permanent mazes — each one stays at the same URL so you can track completions and work through a collection.',
  },
  {
    q: 'Do the mazes save my progress?',
    a: 'Yes. After you solve a maze, your completion is saved to your device using browser storage. The progress bars on this page update to show how many mazes you have finished in each collection. No account is required and progress persists between visits.',
  },
  {
    q: 'Can I complete every maze in the library?',
    a: 'Yes. The Maze Library is designed to be completed. Work through each collection at your own pace — start with Small, move through Medium and Large, then take on Expert and Hardcore when you are ready.',
  },
  {
    q: 'What maze size should I start with?',
    a: 'If you are new to maze puzzles, start with Small Mazes. The 20×20 grid is quick to complete and easy to orient yourself. Once you are comfortable, Medium Mazes (40×40) are a natural step up with more branching paths.',
  },
  {
    q: 'What is the hardest maze in the library?',
    a: 'Hardcore Mazes are the hardest — 100×100 grids with extremely long solution paths. Expert Mazes (80×80) are a significant challenge and a good preparation before tackling Hardcore.',
  },
  {
    q: 'Are these mazes free?',
    a: 'Yes. Every maze in the Maze Library is free to play — no account, no sign-up, and no payment required. All mazes are available in your browser at any time.',
  },
  {
    q: 'Can I print these mazes?',
    a: 'The library mazes are optimized for online play. For print-ready puzzles, visit the Printable Mazes page or use the Maze Generator to create and download a maze in any size.',
  },
];

const schemaLD = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': 'https://mazepuzzles.io/maze-library',
      url: 'https://mazepuzzles.io/maze-library',
      name: 'Free Online Maze Library - Complete Maze Collections | MazePuzzles.io',
      description:
        'Play Maze Library collections online, track your progress, and work toward completing every maze in the MazePuzzles.io Maze Library.',
      isPartOf: { '@id': 'https://mazepuzzles.io/#website' },
      breadcrumb: { '@id': 'https://mazepuzzles.io/maze-library#breadcrumb' },
      about: {
        '@type': 'Dataset',
        name: 'MazePuzzles.io Maze Library',
        description:
          `A curated collection of ${totalCount} free online maze puzzles across five sizes: ${tierCounts.small} Small (20×20), ${tierCounts.medium} Medium (40×40), ${tierCounts.large} Large (60×60), ${tierCounts.expert} Expert (80×80), and ${tierCounts.hardcore} Hardcore (100×100).`,
        url: 'https://mazepuzzles.io/maze-library',
        publisher: { '@type': 'Organization', name: 'MazePuzzles.io', url: 'https://mazepuzzles.io' },
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://mazepuzzles.io/maze-library#breadcrumb',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://mazepuzzles.io/' },
        { '@type': 'ListItem', position: 2, name: 'Maze Library', item: 'https://mazepuzzles.io/maze-library' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqItems.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ],
});
---

<BaseLayout
  title="Free Online Maze Library - Complete Maze Collections | MazePuzzles.io"
  description="Play Maze Library collections online, track your progress, and work toward completing every maze in the MazePuzzles.io Maze Library."
  schemaLD={schemaLD}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 lg:py-12">

    <Breadcrumb crumbs={[{ label: 'Home', href: '/' }, { label: 'Maze Library' }]} />

    <!-- Hero -->
    <div class="mt-6 mb-12 md:mb-16 lg:mb-20">
      <p class="text-xs tracking-widest uppercase font-semibold text-arch-accent mb-2">Free Online Maze Library</p>
      <h1 class="text-5xl sm:text-6xl lg:text-7xl xl:text-8xl mb-5">Free Online Maze Library</h1>
      <p class="text-lg sm:text-xl md:text-2xl max-w-2xl leading-relaxed" style="color: var(--color-muted-strong);">
        Choose a maze collection and solve each puzzle at your own pace. Your progress saves on this device, so you can come back and keep going.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a href="#maze-collections" class="btn-primary px-6 md:px-8 py-3 md:py-3.5 text-sm md:text-base">Choose a Maze</a>
        <a href="/play/maze-of-the-day/" class="btn-secondary px-6 md:px-8 py-3 md:py-3.5 text-sm md:text-base">Play Today's Maze</a>
        <a href="/maze-generator" class="btn-secondary px-5 md:px-7 py-3 md:py-3.5 text-sm md:text-base">Make a Maze</a>
      </div>
    </div>

    <!-- Maze Collections -->
    <div id="maze-collections" class="mb-14 lg:mb-16">
      <h2 class="text-xl font-bold text-arch-charcoal mb-6 lg:mb-8">Maze Collections</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-4 lg:gap-5">
        {CATEGORIES.map((cat) => {
          const count = tierCounts[cat.difficulty] ?? 0;
          const gridSize = gridSizes[cat.difficulty] ?? '';
          const desc = tierDescriptions[cat.difficulty] ?? '';
          const positioning = tierPositioning[cat.difficulty] ?? '';
          const firstId = tierFirstIds[cat.difficulty] ?? '';
          return (
            <div
              class="card flex flex-col p-5 lg:p-6 gap-3"
              data-tier={cat.difficulty}
              data-tier-total={count}
              data-tier-first-id={firstId}
            >
              <div class="flex-1">
                <p
                  class="text-xs font-semibold uppercase tracking-wider mb-2"
                  style="font-family: 'IBM Plex Mono', monospace; color: var(--color-accent);"
                >{positioning}</p>
                <p
                  class="text-sm mb-1.5"
                  style="font-family: 'IBM Plex Mono', monospace; color: var(--color-muted-strong);"
                >{gridSize} grid</p>
                <h3
                  class="text-xl md:text-2xl tracking-tight leading-none mb-2"
                  style="font-family: 'Bebas Neue', sans-serif; color: var(--color-charcoal);"
                >{cat.label}</h3>
                <p class="text-base leading-snug" style="color: var(--color-muted-strong);">{desc}</p>
              </div>

              <!-- Progress (updated client-side) -->
              <div class="space-y-1.5">
                <div class="flex items-baseline">
                  <span
                    class="tier-progress-text text-sm font-semibold"
                    style="color: var(--color-muted-strong);"
                    data-total={count}
                  >
                    0 / {count} solved
                  </span>
                </div>
                <div class="tier-progress-container h-1.5 rounded-full overflow-hidden">
                  <div
                    class="tier-progress-bar h-full rounded-full transition-all duration-500"
                    style="width:0%"
                  />
                </div>
              </div>

              <div class="flex items-center gap-2">
                <a
                  href={`/${cat.slug}`}
                  class="flex-1 text-center rounded-lg border py-2 text-sm font-medium transition-colors"
                  style="border-color: var(--color-border); color: var(--color-muted-strong);"
                  onmouseover="this.style.backgroundColor='var(--color-border)'; this.style.color='var(--color-charcoal)';"
                  onmouseout="this.style.backgroundColor=''; this.style.color='var(--color-muted-strong)';"
                >
                  Browse
                </a>
                <a
                  href={firstId ? `/play/library/${firstId}` : `/${cat.slug}`}
                  class="tier-play-next flex-1 text-center rounded-lg py-2 text-sm font-semibold transition-colors"
                  style="border: 1px solid var(--color-accent); color: var(--color-accent);"
                  data-all-ids={JSON.stringify(tierAllIds[cat.difficulty] ?? [])}
                  onmouseover="this.style.backgroundColor='var(--color-accent)'; this.style.color='#ffffff';"
                  onmouseout="this.style.backgroundColor=''; this.style.color='var(--color-accent)';"
                >
                  Play Next
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <!-- How the Maze Library Works -->
    <section class="mt-16 pt-10" style="border-top: 1px solid var(--color-border);">
      <h2 class="text-xl font-bold text-arch-charcoal mb-6">How the Maze Library Works</h2>
      <ol class="grid grid-cols-1 sm:grid-cols-3 gap-6 list-none">
        <li class="flex gap-4">
          <span class="shrink-0 w-8 h-8 rounded-full bg-arch-accent text-white text-sm font-bold flex items-center justify-center">1</span>
          <div>
            <p class="font-semibold" style="color: var(--color-charcoal);">Choose a collection</p>
            <p class="text-sm mt-1" style="color: var(--color-muted-strong);">Pick Small, Medium, Large, Expert, or Hardcore.</p>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="shrink-0 w-8 h-8 rounded-full bg-arch-accent text-white text-sm font-bold flex items-center justify-center">2</span>
          <div>
            <p class="font-semibold" style="color: var(--color-charcoal);">Solve each maze</p>
            <p class="text-sm mt-1" style="color: var(--color-muted-strong);">Play online with keyboard, swipe, or D-pad controls.</p>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="shrink-0 w-8 h-8 rounded-full bg-arch-accent text-white text-sm font-bold flex items-center justify-center">3</span>
          <div>
            <p class="font-semibold" style="color: var(--color-charcoal);">Track completion</p>
            <p class="text-sm mt-1" style="color: var(--color-muted-strong);">Finished mazes are saved on this device so you can work through every collection over time.</p>
          </div>
        </li>
      </ol>
      <p class="text-sm mt-4" style="color: var(--color-muted-strong);">
        <a href="/maze-guides/maze-library" style="color: var(--color-accent);">How to use the Maze Library →</a>
      </p>
    </section>

    <!-- Why Complete the Library? -->
    <section class="mt-12">
      <h2 class="text-xl font-bold text-arch-charcoal mb-6">Why Complete the Library?</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-sm" style="color: var(--color-muted-strong);">
        <div class="card rounded-lg p-4">
          <p class="font-semibold mb-1" style="color: var(--color-charcoal);">Completionist progress</p>
          <p>Work through each collection and see what you have finished.</p>
        </div>
        <div class="card rounded-lg p-4">
          <p class="font-semibold mb-1" style="color: var(--color-charcoal);">Library challenges</p>
          <p>Every library maze has a stable place, so you can replay or resume specific puzzles.</p>
        </div>
        <div class="card rounded-lg p-4">
          <p class="font-semibold mb-1" style="color: var(--color-charcoal);">All skill levels</p>
          <p>Start with Small mazes and move up to larger, denser collections.</p>
        </div>
        <div class="card rounded-lg p-4">
          <p class="font-semibold mb-1" style="color: var(--color-charcoal);">No account required</p>
          <p>Progress saves locally on your device.</p>
        </div>
      </div>
    </section>

    <!-- Tool Comparison -->
    <section class="mt-12">
      <h2 class="text-xl font-bold text-arch-charcoal mb-2">Maze Library, Maze Generator, and Printable Mazes</h2>
      <p class="text-sm text-arch-600 mb-6">Three tools, each built for a different use. Choose the one that fits.</p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="card rounded-lg p-5 flex flex-col gap-3">
          <div>
            <p class="font-semibold mb-1" style="color: var(--color-charcoal);">Maze Library</p>
            <p class="text-sm" style="color: var(--color-muted-strong);">Work through Maze Library collections and track your progress.</p>
          </div>
          <span class="text-xs text-arch-400 mt-auto">You are here</span>
        </div>
        <a href="/maze-generator" class="card-hover rounded-lg p-5 flex flex-col gap-3 no-underline">
          <div>
            <p class="font-semibold mb-1" style="color: var(--color-charcoal);">Maze Generator</p>
            <p class="text-sm" style="color: var(--color-muted-strong);">Create a custom maze and decide whether to play, print, or download it.</p>
          </div>
          <span class="text-sm font-medium mt-auto" style="color: var(--color-accent);">Maze Generator →</span>
        </a>
        <a href="/printable-mazes" class="card-hover rounded-lg p-5 flex flex-col gap-3 no-underline">
          <div>
            <p class="font-semibold mb-1" style="color: var(--color-charcoal);">Printable Mazes</p>
            <p class="text-sm" style="color: var(--color-muted-strong);">A print-first worksheet tool with optional answer key pages.</p>
          </div>
          <span class="text-sm font-medium mt-auto" style="color: var(--color-accent);">Free Maze Printables →</span>
        </a>
      </div>
    </section>

    <!-- FAQ -->
    <section class="mt-12">
      <h2 class="text-xl font-bold text-arch-charcoal mb-6">Frequently asked questions</h2>
      <dl class="space-y-5">
        {faqItems.map(({ q, a }) => (
          <div class="border-b pb-5 last:border-0" style="border-color: var(--color-border);">
            <dt class="font-semibold mb-1" style="color: var(--color-charcoal);">{q}</dt>
            <dd class="text-sm" style="color: var(--color-muted-strong);">{a}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- Final CTA -->
    <section class="mt-12 rounded-sm border border-arch-200 bg-arch-bg p-6">
      <h2 class="text-lg font-bold text-arch-charcoal mb-2">Want to make your own maze?</h2>
      <p class="text-sm text-arch-600 mb-5">Use the Maze Generator to create a custom maze, or use Printable Mazes when you want worksheet-style printouts with optional answer key pages.</p>
      <div class="flex flex-wrap gap-3">
        <a href="/maze-generator" class="btn-secondary">Maze Generator</a>
        <a href="/printable-mazes" class="btn-secondary">Printable Mazes</a>
      </div>
    </section>

  </div>
</BaseLayout>

<script>
  (function () {
    try {
      var raw = localStorage.getItem('mazepuzzles.library.progress');
      var parsed = raw ? JSON.parse(raw) : null;
      var ids = Array.isArray(parsed && parsed.completedMazeIds) ? parsed.completedMazeIds : [];
      var done = new Set(ids);

      document.querySelectorAll('[data-tier]').forEach(function (card) {
        var tier = card.getAttribute('data-tier');
        var total = parseInt(card.getAttribute('data-tier-total') || '0', 10);
        if (!tier || !total) return;

        var prefix = tier + '-';
        var count = 0;
        done.forEach(function (id) {
          if (typeof id === 'string' && id.startsWith(prefix)) count++;
        });

        var textEl = card.querySelector('.tier-progress-text');
        if (textEl) textEl.textContent = count + ' / ' + total + ' solved';

        var barEl = card.querySelector('.tier-progress-bar');
        if (barEl) barEl.setAttribute('style', 'width:' + Math.round((count / total) * 100) + '%');

        var link = card.querySelector('.tier-play-next');
        if (!link) return;
        var allIds = [];
        try { allIds = JSON.parse(link.getAttribute('data-all-ids') || '[]'); } catch (_) {}
        if (!Array.isArray(allIds) || allIds.length === 0) return;

        var next = allIds.find(function (id) { return !done.has(id); });
        if (next) {
          link.setAttribute('href', '/play/library/' + next);
        } else {
          link.textContent = 'All Complete ✓';
          link.removeAttribute('href');
          link.setAttribute('style', 'opacity:0.55;pointer-events:none;');
        }
      });
    } catch (_) {}
  })();
</script>

<script>
  import { trackLibraryCollectionViewed } from '../lib/analytics';
  const key = 'ga_lib_overview_viewed';
  if (!sessionStorage.getItem(key)) {
    sessionStorage.setItem(key, '1');
    trackLibraryCollectionViewed('overview');
  }
</script>
