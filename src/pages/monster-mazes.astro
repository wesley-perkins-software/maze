---
import CategoryLayout from '../layouts/CategoryLayout.astro';
import LibraryMazeCard from '../components/ui/LibraryMazeCard.astro';
import { LibraryProgress } from '../components/library/LibraryProgress';
import { getCategoryBySlug } from '../types/maze.js';
import { getLibraryMazesByDifficulty } from '../lib/library/catalog.js';

const category = getCategoryBySlug('monster-mazes')!;
const mazes = getLibraryMazesByDifficulty('monster');
const allIds = mazes.map((m) => m.id);
const firstLabel = 'Start Monster #001';

const BASE = 'https://mazethis.com';
const pageUrl = `${BASE}/monster-mazes`;

const faqItems = [
  {
    open: true,
    q: 'What are Monster Mazes?',
    a: 'Monster Mazes are puzzle games on a 100×100 grid — the hardest mazes in the MazeThis collection. With 10,000 cells to navigate, Monster Mazes are built for committed solvers who want an extreme challenge. The collection contains 15 curated puzzles, each with a fixed unique layout.',
  },
  {
    open: true,
    q: 'Who are Monster Mazes for?',
    a: 'Monster Mazes are intended for experienced solvers who have completed smaller tiers and are ready for the ultimate challenge. The 100×100 grid demands sustained focus and a systematic approach — these are not casual puzzles.',
  },
  {
    q: 'What makes Monster Mazes different?',
    a: 'Monster Mazes are the largest puzzles in the Maze Library. The 100×100 grid produces extremely long solution paths and highly complex branching — you can spend a long time exploring dead ends. Completing all 15 Monster Mazes is the ultimate achievement in the MazeThis collection.',
  },
  {
    q: 'How many Monster Mazes are there?',
    a: 'There are 15 Monster Mazes in the collection, numbered Monster #001 through Monster #015. Every maze has a fixed layout — the same puzzle is always at the same URL.',
  },
  {
    q: 'Are Monster Mazes free to play?',
    a: 'Yes. Every Monster Maze is free to play directly in your browser — no account, no download, and no sign-up required.',
  },
  {
    q: 'Can I play Monster Mazes on mobile?',
    a: 'Yes. Monster Mazes work on any modern phone or tablet. Because the 100×100 grid is very dense, a larger screen or tablet is more comfortable. The on-screen d-pad and touch navigation both work.',
  },
  {
    q: 'How is my progress saved?',
    a: "Progress is saved on your device. After solving a maze, a green checkmark badge appears on the card and the progress bar updates. Your completions are stored in your browser's local storage, so they persist between visits without requiring an account.",
  },
  {
    q: 'Can I print Monster Mazes?',
    a: 'Yes. Visit the Printable Mazes page to download and print maze puzzles in a range of sizes, including monster mazes.',
  },
  {
    q: 'What should I try after Monster Mazes?',
    a: 'Monster Mazes are the highest tier in the Maze Library. After completing them, you can explore the full library — 160 curated puzzles across five difficulty tiers — or challenge yourself with the daily Maze of the Day for a fresh puzzle every day.',
  },
];

const schemaLD = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': pageUrl,
      url: pageUrl,
      name: category.title,
      description: category.description,
      isPartOf: { '@id': `${BASE}/#website` },
      breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${BASE}/` },
        { '@type': 'ListItem', position: 2, name: 'Maze Library', item: `${BASE}/maze-library` },
        { '@type': 'ListItem', position: 3, name: 'Monster Mazes' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqItems.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
    {
      '@type': 'ItemList',
      name: 'Monster Mazes',
      numberOfItems: mazes.length,
      itemListElement: mazes.map((m, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `${BASE}/play/library/${m.id}`,
      })),
    },
  ],
});
---

<CategoryLayout
  category={category}
  totalCount={mazes.length}
  schemaLD={schemaLD}
  tagline="15 maze puzzles on a 100×100 grid. Play free online and complete the collection."
>
  <!-- Progress row -->
  <div class="mb-6 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3">
    <div class="min-w-0 flex-1 max-w-sm">
      <LibraryProgress client:load total={mazes.length} difficulty={category.difficulty} />
    </div>
    <a
      id="play-next-link"
      href={`/play/library/${allIds[0]}`}
      data-all-ids={JSON.stringify(allIds)}
      data-first-label={firstLabel}
      class="btn-primary text-sm px-4 py-2 shrink-0 w-full sm:w-auto"
    >
      {firstLabel}
    </a>
  </div>

  <!-- Card grid -->
  <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
    {mazes.map((entry, i) => (
      <LibraryMazeCard entry={entry} index={i} />
    ))}
  </div>

  <!-- FAQ -->
  <div class="mt-12 max-w-2xl">
    <h2 class="text-xl font-bold mb-5" style="color: var(--color-charcoal);">About Monster Mazes</h2>
    <div class="space-y-2">
      {faqItems.map(({ q, a, open }) => (
        <details open={open} class="group border rounded-lg" style="border-color: var(--color-border);">
          <summary class="flex cursor-pointer items-center justify-between px-4 py-3 font-semibold select-none list-none [&::-webkit-details-marker]:hidden" style="color: var(--color-charcoal);">
            {q}
            <svg class="h-4 w-4 shrink-0 ml-3 transition-transform duration-200 group-open:rotate-180" style="color: var(--color-muted);" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
            </svg>
          </summary>
          <div class="px-4 pb-4 text-sm leading-relaxed" style="color: var(--color-muted-strong);">
            {q === 'What should I try after Monster Mazes?' ? (
              <p>Monster Mazes are the highest tier in the Maze Library. After completing them, you can explore the <a href="/maze-library" class="underline hover:opacity-80">full Maze Library</a> — 160 curated puzzles across five difficulty tiers — or challenge yourself with the <a href="/maze-of-the-day" class="underline hover:opacity-80">Maze of the Day</a> for a fresh puzzle every day.</p>
            ) : q === 'Can I print Monster Mazes?' ? (
              <p>Yes. Visit the <a href="/printable-mazes" class="underline hover:opacity-80">Printable Mazes</a> page to download and print maze puzzles in a range of sizes, including monster mazes.</p>
            ) : (
              <p>{a}</p>
            )}
          </div>
        </details>
      ))}
    </div>
  </div>
</CategoryLayout>

<script>
  (function () {
    try {
      var raw = localStorage.getItem('mazethis.library.progress');
      var ids = raw ? JSON.parse(raw)?.completedMazeIds : [];
      if (!Array.isArray(ids)) return;
      var done = new Set(ids);

      document.querySelectorAll('[data-maze-id]').forEach(function (el) {
        if (done.has(el.getAttribute('data-maze-id'))) {
          el.classList.add('maze-card-completed');
        }
      });

      var link = document.getElementById('play-next-link');
      if (!link) return;
      var allIds = JSON.parse(link.getAttribute('data-all-ids') ?? '[]');
      var next = allIds.find(function (id) { return !done.has(id); });

      if (next) {
        var nextCard = document.querySelector('[data-maze-id="' + next + '"]');
        if (nextCard) nextCard.classList.add('maze-card-next');
      }

      var firstLabel = link.getAttribute('data-first-label') ?? 'Play Next';

      if (done.size === 0) {
        link.textContent = firstLabel;
      } else if (next) {
        link.textContent = 'Play Next';
        link.setAttribute('href', '/play/library/' + next);
      } else {
        link.textContent = 'Collection Complete ✓';
        link.setAttribute('href', '/play/library/' + allIds[0]);
      }
    } catch (_) {}
  })();
</script>
