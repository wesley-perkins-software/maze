---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import HowItWorks from '../components/home/HowItWorks.astro';

const siteUrl = import.meta.env.SITE || 'https://mazethis.com';

const websiteSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'MazeThis',
  url: siteUrl,
  description: 'Free online mazes, daily maze challenge, maze generator, and printable maze worksheets.',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteUrl}/maze-generator`,
    'query-input': 'required name=search_term_string',
  },
});

const organizationSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'MazeThis',
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  description: 'Free online mazes and interactive maze puzzles for all skill levels. Daily maze challenge, fixed collections, custom maze generator, and printable worksheets.',
  foundingDate: '2024',
  knowsAbout: ['maze puzzles', 'printable mazes', 'daily maze challenge', 'maze generation', 'brain games', 'educational puzzles'],
});
---

<BaseLayout
  title="MazeThis | Free Online Mazes, Maze Generator, and Printable Mazes"
  description="Play a fresh daily maze, browse free online maze collections, generate custom mazes, and print clean maze worksheets with MazeThis."
  schemaLD={[websiteSchema, organizationSchema]}
>

  <!-- 1. Hero -->
  <Hero />

  <!-- 2. Choose How You Want to Play — 4-card product-path grid -->
  <section
    class="py-16 sm:py-20"
    style="background-color: var(--color-surface); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);"
    aria-labelledby="products-heading"
  >
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">

      <div class="mb-10">
        <p
          class="text-xs uppercase tracking-widest mb-2"
          style="font-family: 'IBM Plex Mono', monospace; color: var(--color-muted-strong);"
        >The Best Maze Experience on the Internet</p>
        <h2
          id="products-heading"
          class="font-display text-5xl sm:text-6xl uppercase"
          style="color: var(--color-charcoal);"
        >Choose How You<br />Want to Play</h2>
        <p
          class="mt-3 text-sm leading-relaxed max-w-lg"
          style="color: var(--color-muted-strong);"
        >Start with today's maze, work through a collection, generate a custom maze, or print a worksheet.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {[
          {
            title: 'Maze of the Day',
            desc: 'Play one fresh daily maze challenge.',
            cta: 'Play today →',
            href: '/maze-of-the-day',
          },
          {
            title: 'Maze Library',
            desc: 'Complete fixed online maze collections and track your progress.',
            cta: 'Browse library →',
            href: '/maze-library',
          },
          {
            title: 'Maze Generator',
            desc: 'Create a custom maze to play, print, or download.',
            cta: 'Generate a maze →',
            href: '/maze-generator',
          },
          {
            title: 'Printable Mazes',
            desc: 'Generate clean maze worksheets with optional answer key pages.',
            cta: 'Print mazes →',
            href: '/printable-mazes',
          },
        ].map(({ title, desc, cta, href }) => (
          <a
            href={href}
            class="card-hover rounded-lg p-5 flex flex-col gap-3 no-underline"
          >
            <div>
              <p
                class="font-semibold mb-1"
                style="color: var(--color-charcoal);"
              >{title}</p>
              <p
                class="text-sm"
                style="color: var(--color-muted-strong);"
              >{desc}</p>
            </div>
            <span
              class="text-sm font-medium mt-auto"
              style="color: var(--color-accent);"
            >{cta}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. How MazeThis Works (dark section) -->
  <HowItWorks />

  <!-- 4. Generator CTA (light section) -->
  <section
    class="relative overflow-hidden py-20 sm:py-28"
    style="background-color: var(--color-bg); border-top: 1px solid var(--color-border);"
    aria-labelledby="generator-cta-heading"
  >
    <div class="absolute inset-0 architect-dot-grid opacity-60 pointer-events-none" aria-hidden="true"></div>
    <div class="absolute top-0 left-0 right-0 h-0.5" style="background-color: var(--color-accent);"></div>

    <div class="relative mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <p
          class="text-xs uppercase tracking-widest mb-4"
          style="font-family: 'IBM Plex Mono', monospace; color: var(--color-muted);"
        >Maze Generator</p>
        <h2
          id="generator-cta-heading"
          class="font-display text-6xl sm:text-7xl lg:text-8xl uppercase leading-none mb-6"
          style="color: var(--color-charcoal);"
        >Build Your<br />Own Maze</h2>
        <p
          class="text-sm leading-relaxed mb-8 max-w-md"
          style="color: var(--color-muted-strong);"
        >
          Choose a size, generate a unique maze, then play online, print, or download the SVG.
        </p>
        <a
          href="/maze-generator"
          class="btn-primary text-sm px-8 py-4 inline-flex items-center gap-2.5 w-full sm:w-auto justify-center sm:justify-start"
        >
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
          </svg>
          Generate a Maze
        </a>
      </div>
    </div>
  </section>

  <!-- 5. Built for Maze Lovers (dark section) -->
  <section
    class="relative overflow-hidden py-14 sm:py-20"
    style="background-color: var(--color-charcoal);"
    aria-labelledby="features-heading"
  >
    <div class="absolute inset-0 architect-dot-grid opacity-20 pointer-events-none" aria-hidden="true"></div>
    <div class="absolute top-0 left-0 right-0 h-0.5" style="background-color: var(--color-accent);" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">

      <div class="mb-10">
        <p
          class="text-xs uppercase tracking-widest mb-2"
          style="font-family: 'IBM Plex Mono', monospace; color: color-mix(in srgb, var(--color-bg) 50%, transparent);"
        >Features</p>
        <h2
          id="features-heading"
          class="font-display text-5xl sm:text-6xl uppercase"
          style="color: var(--color-bg);"
        >Built for<br />Maze Lovers</h2>
        <p
          class="mt-3 text-sm leading-relaxed max-w-lg"
          style="color: color-mix(in srgb, var(--color-bg) 60%, transparent);"
        >MazeThis gives you more than one way to solve: daily challenges, fixed collections, custom generation, and printable worksheets.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-16 gap-y-8">
        {[
          {
            id: '01',
            title: 'Daily Maze Challenge',
            body: 'A fresh maze every day.',
          },
          {
            id: '02',
            title: 'Track Your Progress',
            body: 'Complete fixed collections over time on the same device.',
          },
          {
            id: '03',
            title: 'Generate Unlimited Mazes',
            body: 'Create a new custom maze whenever you want.',
          },
          {
            id: '04',
            title: 'Print Clean Worksheets',
            body: 'Make printable mazes with optional answer key pages.',
          },
          {
            id: '05',
            title: 'Play on Any Device',
            body: 'Use keyboard, swipe, or on-screen controls.',
          },
          {
            id: '06',
            title: 'No Account Required',
            body: 'Start solving immediately.',
          },
        ].map(({ id, title, body }) => (
          <div class="flex gap-5">
            <span
              class="text-xs shrink-0 mt-1 w-6"
              style="font-family: 'IBM Plex Mono', monospace; color: color-mix(in srgb, var(--color-bg) 40%, transparent);"
            >{id}</span>
            <div>
              <h3
                class="text-sm font-bold mb-1"
                style="color: var(--color-bg);"
              >{title}</h3>
              <p
                class="text-sm leading-relaxed"
                style="color: color-mix(in srgb, var(--color-bg) 65%, transparent);"
              >{body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. Learn section -->
  <section
    class="py-14 sm:py-20"
    style="background-color: var(--color-bg); border-top: 1px solid var(--color-border);"
    aria-labelledby="learn-heading"
  >
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center">
      <h2
        id="learn-heading"
        class="font-display text-4xl sm:text-5xl uppercase mb-4"
        style="color: var(--color-charcoal);"
      >Want to Get Better at Mazes?</h2>
      <p
        class="text-sm leading-relaxed max-w-md mx-auto mb-8"
        style="color: var(--color-muted-strong);"
      >Read maze-solving strategies, difficulty guides, and maze basics in Learn.</p>
      <a
        href="/learn"
        class="btn-secondary text-sm px-7 py-3 inline-flex items-center gap-2"
      >
        Explore Learn →
      </a>
    </div>
  </section>

  <!-- 7. Final CTA -->
  <section
    class="relative overflow-hidden py-16 sm:py-24"
    style="background-color: var(--color-charcoal);"
    aria-labelledby="final-cta-heading"
  >
    <div class="absolute inset-0 architect-dot-grid opacity-20 pointer-events-none" aria-hidden="true"></div>
    <div class="absolute top-0 left-0 right-0 h-0.5" style="background-color: var(--color-accent);" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center">
      <h2
        id="final-cta-heading"
        class="font-display text-5xl sm:text-6xl lg:text-7xl uppercase leading-none mb-4"
        style="color: var(--color-bg);"
      >Ready to Solve<br />a Maze?</h2>
      <p
        class="text-sm leading-relaxed mb-10 max-w-sm mx-auto"
        style="color: color-mix(in srgb, var(--color-bg) 65%, transparent);"
      >Start with today's maze, browse the library, or generate your own.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="/maze-of-the-day"
          class="btn-primary text-sm px-7 py-3.5 inline-flex items-center gap-2 w-full sm:w-auto justify-center"
        >
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M8 5v14l11-7z" />
          </svg>
          Play Today's Maze
        </a>
        <a
          href="/maze-library"
          class="btn-secondary text-sm px-7 py-3.5 w-full sm:w-auto text-center"
          style="color: var(--color-bg); border-color: color-mix(in srgb, var(--color-bg) 35%, transparent);"
        >
          Maze Library
        </a>
        <a
          href="/maze-generator"
          class="btn-secondary text-sm px-7 py-3.5 w-full sm:w-auto text-center"
          style="color: var(--color-bg); border-color: color-mix(in srgb, var(--color-bg) 35%, transparent);"
        >
          Maze Generator
        </a>
      </div>
    </div>
  </section>

  <!-- Sticky CTA — mobile only -->
  <div
    id="sticky-cta"
    class="fixed bottom-0 left-0 right-0 z-50 sm:hidden translate-y-full transition-transform duration-300 ease-in-out"
    aria-hidden="true"
  >
    <div
      class="px-4 py-2.5 backdrop-blur-md"
      style="background-color: color-mix(in srgb, var(--color-bg) 95%, transparent); border-top: 1px solid var(--color-border);"
    >
      <div class="mx-auto max-w-xl flex items-center justify-between gap-4">
        <div class="min-w-0">
          <p
            class="text-sm font-bold truncate"
            style="color: var(--color-charcoal);"
          >Today's Maze Challenge</p>
          <p
            id="sticky-cta-sub"
            class="text-xs"
            style="font-family: 'IBM Plex Mono', monospace; color: var(--color-muted-strong);"
          >A new maze is ready.</p>
        </div>
        <a
          id="sticky-cta-btn"
          href="/play/maze-of-the-day/"
          class="btn-primary text-xs px-4 py-2 shrink-0"
          tabindex="-1"
          aria-hidden="true"
        >
          Play Now
        </a>
      </div>
    </div>
  </div>

</BaseLayout>

<script>
  import { getDailyNow } from '../lib/utils/dailyNow';
  import { getLocalDateString } from '../lib/maze/dailyMaze';

  const stickyEl = document.getElementById('sticky-cta');
  const heroCta  = document.getElementById('hero-play-cta');
  const subEl    = document.getElementById('sticky-cta-sub');
  const btnEl    = document.getElementById('sticky-cta-btn') as HTMLAnchorElement | null;

  function getStickyState(): 'not-started' | 'in-progress' | 'completed' {
    const today = getLocalDateString(getDailyNow());
    if (localStorage.getItem(`daily_completed_${today}`) === 'true') return 'completed';
    try {
      const raw = localStorage.getItem('mazethis.dailyMaze.activeSession');
      if (raw) {
        const s = JSON.parse(raw) as Record<string, unknown>;
        const prog = s['progress'] as Record<string, unknown> | undefined;
        if (
          s['version'] === 1 &&
          s['mode'] === 'daily' &&
          s['localDate'] === today &&
          s['generatorVersion'] === 1 &&
          (prog?.['steps'] as number | undefined ?? 0) > 0
        ) return 'in-progress';
      }
    } catch { /* ignore */ }
    return 'not-started';
  }

  let heroCtaVisible = true;

  function applyBarState(): void {
    if (!stickyEl) return;
    const state = getStickyState();

    if (state === 'completed') {
      stickyEl.classList.add('translate-y-full');
      stickyEl.setAttribute('aria-hidden', 'true');
      btnEl?.setAttribute('tabindex', '-1');
      return;
    }

    if (subEl) subEl.textContent = state === 'in-progress' ? 'Continue today\'s challenge.' : 'A new maze is ready.';
    if (btnEl) btnEl.textContent = state === 'in-progress' ? 'Resume' : 'Play Now';

    if (heroCtaVisible) {
      stickyEl.classList.add('translate-y-full');
      stickyEl.setAttribute('aria-hidden', 'true');
      btnEl?.setAttribute('tabindex', '-1');
    } else {
      stickyEl.classList.remove('translate-y-full');
      stickyEl.removeAttribute('aria-hidden');
      btnEl?.removeAttribute('tabindex');
    }
  }

  if (stickyEl && heroCta) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        heroCtaVisible = entry.isIntersecting;
        applyBarState();
      },
      { threshold: 0 },
    );
    observer.observe(heroCta);
  }

  applyBarState();
  window.addEventListener('storage', applyBarState);
</script>
