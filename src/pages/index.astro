---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import FeatureMazes from '../components/home/FeatureMazes.astro';
import HowItWorks from '../components/home/HowItWorks.astro';

const siteUrl = import.meta.env.SITE || 'https://mazethis.com';

const websiteSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'MazeThis',
  url: siteUrl,
  description: 'Free printable maze puzzles and daily maze challenge. 420+ mazes for kids and adults.',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteUrl}/maze-generator`,
    'query-input': 'required name=search_term_string',
  },
});

const organizationSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'MazeThis',
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  description: 'Free printable mazes and interactive maze puzzles for kids and adults. Daily maze challenge, maze library, and custom maze generator.',
  foundingDate: '2024',
  knowsAbout: ['maze puzzles', 'printable mazes', 'daily maze challenge', 'maze generation', 'brain games', 'educational puzzles'],
});
---

<BaseLayout
  title="Free Maze Puzzles — Daily Challenge & Printable Mazes | MazeThis"
  description="Play a new free maze puzzle every day. Browse 420+ printable mazes for kids and adults, or generate your own. No account needed — free forever."
  schemaLD={[websiteSchema, organizationSchema]}
>

  <!-- 1. Hero -->
  <Hero />

  <!-- 2. Maze Library — combined section -->
  <FeatureMazes />

  <!-- 3. How It Works (dark section) -->
  <HowItWorks />

  <!-- 4. Generator CTA (light section) -->
  <section
    class="relative overflow-hidden py-20 sm:py-28"
    style="background-color: var(--color-bg); border-top: 1px solid var(--color-border);"
    aria-labelledby="generator-cta-heading"
  >
    <div class="absolute inset-0 architect-dot-grid opacity-60 pointer-events-none" aria-hidden="true"></div>
    <div class="absolute top-0 left-0 right-0 h-0.5" style="background-color: var(--color-accent);"></div>

    <div class="relative mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <p
          class="text-xs uppercase tracking-widest mb-4"
          style="font-family: 'IBM Plex Mono', monospace; color: var(--color-muted);"
        >Maze Generator</p>
        <h2
          id="generator-cta-heading"
          class="font-display text-6xl sm:text-7xl lg:text-8xl uppercase leading-none mb-6"
          style="color: var(--color-charcoal);"
        >Build Your<br />Own Maze</h2>
        <p
          class="text-sm leading-relaxed mb-8 max-w-md"
          style="color: var(--color-muted-strong);"
        >
          Create a unique maze in seconds — Small, Medium, or Large. Download as SVG or print from your browser. No account, no limit.
        </p>
        <a
          href="/maze-generator"
          class="btn-primary text-sm px-8 py-4 inline-flex items-center gap-2.5 w-full sm:w-auto justify-center sm:justify-start"
        >
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
          </svg>
          Generate a Maze
        </a>
      </div>
    </div>
  </section>

  <!-- 5. Made for Maze Lovers (dark section) -->
  <section
    class="relative overflow-hidden py-14 sm:py-20"
    style="background-color: var(--color-charcoal);"
    aria-labelledby="features-heading"
  >
    <div class="absolute inset-0 architect-dot-grid opacity-20 pointer-events-none" aria-hidden="true"></div>
    <div class="absolute top-0 left-0 right-0 h-0.5" style="background-color: var(--color-accent);" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">

      <div class="mb-10">
        <p
          class="text-xs uppercase tracking-widest mb-2"
          style="font-family: 'IBM Plex Mono', monospace; color: color-mix(in srgb, var(--color-bg) 50%, transparent);"
        >Features</p>
        <h2
          id="features-heading"
          class="font-display text-5xl sm:text-6xl uppercase"
          style="color: var(--color-bg);"
        >Made for<br />Maze Lovers</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-16 gap-y-8">
        {[
          {
            id: '01',
            title: 'Daily Maze Challenge',
            body: 'A fresh maze every day, shared by everyone.',
          },
          {
            id: '02',
            title: 'Print-Perfect Worksheets',
            body: 'Clean printable mazes for classrooms, folders, and puzzle books.',
          },
          {
            id: '03',
            title: 'Play Online on Any Device',
            body: 'Solve instantly on desktop, tablet, or phone.',
          },
          {
            id: '04',
            title: 'Unlimited Unique Mazes',
            body: 'Generate new mazes whenever you want.',
          },
          {
            id: '05',
            title: 'For Kids, Adults & Classrooms',
            body: 'Simple enough for kids, challenging enough for grown-ups.',
          },
          {
            id: '06',
            title: 'Always Free',
            body: 'Play, print, and generate mazes without an account.',
          },
        ].map(({ id, title, body }) => (
          <div class="flex gap-5">
            <span
              class="text-xs shrink-0 mt-1 w-6"
              style="font-family: 'IBM Plex Mono', monospace; color: color-mix(in srgb, var(--color-bg) 40%, transparent);"
            >{id}</span>
            <div>
              <h3
                class="text-sm font-bold mb-1"
                style="color: var(--color-bg);"
              >{title}</h3>
              <p
                class="text-sm leading-relaxed"
                style="color: color-mix(in srgb, var(--color-bg) 65%, transparent);"
              >{body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Sticky CTA — mobile only -->
  <div
    id="sticky-cta"
    class="fixed bottom-0 left-0 right-0 z-50 sm:hidden translate-y-full transition-transform duration-300 ease-in-out"
    aria-hidden="true"
  >
    <div
      class="px-4 py-2.5 backdrop-blur-md"
      style="background-color: color-mix(in srgb, var(--color-bg) 95%, transparent); border-top: 1px solid var(--color-border);"
    >
      <div class="mx-auto max-w-xl flex items-center justify-between gap-4">
        <div class="min-w-0">
          <p
            class="text-sm font-bold truncate"
            style="color: var(--color-charcoal);"
          >Today's Maze Challenge</p>
          <p
            class="text-xs"
            style="font-family: 'IBM Plex Mono', monospace; color: var(--color-muted-strong);"
          >Same puzzle for everyone · Free</p>
        </div>
        <a
          href="/play/maze-of-the-day/"
          class="btn-primary text-xs px-4 py-2 shrink-0"
          tabindex="-1"
          aria-hidden="true"
        >
          Play Now
        </a>
      </div>
    </div>
  </div>

</BaseLayout>

<script>
  const stickyEl = document.getElementById('sticky-cta');
  const heroCta = document.getElementById('hero-play-cta');

  if (stickyEl && heroCta) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        const visible = entry.isIntersecting;
        stickyEl.classList.toggle('translate-y-full', visible);
        if (visible) {
          stickyEl.setAttribute('aria-hidden', 'true');
          stickyEl.querySelector('a')?.setAttribute('tabindex', '-1');
        } else {
          stickyEl.removeAttribute('aria-hidden');
          stickyEl.querySelector('a')?.removeAttribute('tabindex');
        }
      },
      { threshold: 0 },
    );
    observer.observe(heroCta);
  }
</script>
