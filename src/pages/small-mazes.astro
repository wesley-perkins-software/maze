---
import CategoryLayout from '../layouts/CategoryLayout.astro';
import LibraryMazeCard from '../components/ui/LibraryMazeCard.astro';
import { LibraryProgress } from '../components/library/LibraryProgress';
import { getCategoryBySlug } from '../types/maze.js';
import { getLibraryMazesByDifficulty } from '../lib/library/catalog.js';

const category = getCategoryBySlug('small-mazes')!;
const nextCategory = getCategoryBySlug('medium-mazes')!;
const mazes = getLibraryMazesByDifficulty('small');
const allIds = mazes.map((m) => m.id);
const firstLabel = 'Start Small #001';

const BASE = 'https://mazethis.com';
const pageUrl = `${BASE}/small-mazes`;

const faqItems = [
  {
    open: true,
    q: 'What are Small Mazes?',
    a: 'Small Mazes are puzzle games on a 20×20 grid. They are quick and approachable — great for warm-ups, casual play, or anyone new to maze puzzles. The Small Maze collection on MazeThis contains 40 curated puzzles, each with a fixed unique layout that is always available at the same URL.',
  },
  {
    open: true,
    q: 'Who are Small Mazes for?',
    a: 'Small Mazes are a great starting point for anyone new to maze puzzles, and a reliable warm-up for experienced solvers. Their compact size makes them ideal for short play sessions or for introducing maze puzzles to younger players.',
  },
  {
    q: 'What makes Small Mazes different?',
    a: 'Small Mazes are designed for quick, approachable solves. The 20×20 grid keeps paths short and decisions manageable — you can always see the shape of the maze and orient yourself. If you are looking for a bigger challenge, Medium Mazes step up to a 40×40 grid with more branching paths.',
  },
  {
    q: 'How many Small Mazes are there?',
    a: 'There are 40 Small Mazes in the collection, numbered Small #001 through Small #040. Every maze has a fixed layout — the same puzzle is always at the same URL.',
  },
  {
    q: 'Are Small Mazes free to play?',
    a: 'Yes. Every Small Maze is free to play directly in your browser — no account, no download, and no sign-up required.',
  },
  {
    q: 'Can I play Small Mazes on mobile?',
    a: 'Yes. Small Mazes work on any modern phone or tablet. You can navigate using the on-screen d-pad or by tapping the maze directly.',
  },
  {
    q: 'How is my progress saved?',
    a: "Progress is saved on your device. After solving a maze, a green checkmark badge appears on the card and the progress bar updates. Your completions are stored in your browser's local storage, so they persist between visits without requiring an account.",
  },
  {
    q: 'Can I print Small Mazes?',
    a: 'Yes. Visit the Printable Mazes page to download and print maze puzzles in a range of sizes, including small mazes.',
  },
  {
    q: 'What should I try after Small Mazes?',
    a: 'After completing the Small Maze collection, Medium Mazes are a natural next step. They use a 40×40 grid with more branching paths and real decision points — a noticeable increase in challenge without being overwhelming.',
  },
];

const schemaLD = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': pageUrl,
      url: pageUrl,
      name: category.title,
      description: category.description,
      isPartOf: { '@id': `${BASE}/#website` },
      breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${BASE}/` },
        { '@type': 'ListItem', position: 2, name: 'Maze Library', item: `${BASE}/maze-library` },
        { '@type': 'ListItem', position: 3, name: 'Small Mazes' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqItems.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
    {
      '@type': 'ItemList',
      name: 'Small Mazes',
      numberOfItems: mazes.length,
      itemListElement: mazes.map((m, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `${BASE}/play/library/${m.id}`,
      })),
    },
  ],
});
---

<CategoryLayout
  category={category}
  totalCount={mazes.length}
  schemaLD={schemaLD}
  tagline="40 maze puzzles on a 20×20 grid. Play free online and complete the collection."
  nextCategory={nextCategory}
>
  <!-- Progress row -->
  <div class="mb-6 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3">
    <div class="min-w-0 flex-1 max-w-sm">
      <LibraryProgress client:load total={mazes.length} difficulty={category.difficulty} />
    </div>
    <a
      id="play-next-link"
      href={`/play/library/${allIds[0]}`}
      data-all-ids={JSON.stringify(allIds)}
      data-first-label={firstLabel}
      class="btn-primary text-sm px-4 py-2 shrink-0 w-full sm:w-auto"
    >
      {firstLabel}
    </a>
  </div>

  <!-- Card grid -->
  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
    {mazes.map((entry, i) => (
      <LibraryMazeCard entry={entry} index={i} />
    ))}
  </div>

  <!-- FAQ -->
  <div class="mt-12 max-w-2xl">
    <h2 class="text-xl font-bold mb-5" style="color: var(--color-charcoal);">About Small Mazes</h2>
    <div class="space-y-2">
      {faqItems.map(({ q, a, open }) => (
        <details open={open} class="group border rounded-lg" style="border-color: var(--color-border);">
          <summary class="flex cursor-pointer items-center justify-between px-4 py-3 font-semibold select-none list-none [&::-webkit-details-marker]:hidden" style="color: var(--color-charcoal);">
            {q}
            <svg class="h-4 w-4 shrink-0 ml-3 transition-transform duration-200 group-open:rotate-180" style="color: var(--color-muted);" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
            </svg>
          </summary>
          <div class="px-4 pb-4 leading-relaxed" style="color: var(--color-charcoal);">
            {q === 'What should I try after Small Mazes?' ? (
              <p>After completing the Small Maze collection, <a href="/medium-mazes" class="underline hover:opacity-80">Medium Mazes</a> are a natural next step. They use a 40×40 grid with more branching paths and real decision points — a noticeable increase in challenge without being overwhelming.</p>
            ) : q === 'Can I print Small Mazes?' ? (
              <p>Yes. Visit the <a href="/printable-mazes" class="underline hover:opacity-80">Printable Mazes</a> page to download and print maze puzzles in a range of sizes, including small mazes.</p>
            ) : (
              <p>{a}</p>
            )}
          </div>
        </details>
      ))}
    </div>
  </div>
</CategoryLayout>

<script>
  (function () {
    try {
      var raw = localStorage.getItem('mazethis.library.progress');
      var ids = raw ? JSON.parse(raw)?.completedMazeIds : [];
      if (!Array.isArray(ids)) return;
      var done = new Set(ids);

      document.querySelectorAll('[data-maze-id]').forEach(function (el) {
        if (done.has(el.getAttribute('data-maze-id'))) {
          el.classList.add('maze-card-completed');
        }
      });

      var link = document.getElementById('play-next-link');
      if (!link) return;
      var allIds = JSON.parse(link.getAttribute('data-all-ids') ?? '[]');
      var next = allIds.find(function (id) { return !done.has(id); });

      if (next) {
        var nextCard = document.querySelector('[data-maze-id="' + next + '"]');
        if (nextCard) nextCard.classList.add('maze-card-next');
      }

      var firstLabel = link.getAttribute('data-first-label') ?? 'Play Next';

      if (done.size === 0) {
        link.textContent = firstLabel;
      } else if (next) {
        link.textContent = 'Play Next';
        link.setAttribute('href', '/play/library/' + next);
      } else {
        link.textContent = 'Collection Complete ✓';
        link.setAttribute('href', '/play/library/' + allIds[0]);
      }
    } catch (_) {}
  })();
</script>
