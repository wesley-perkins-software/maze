---
import CategoryLayout from '../layouts/CategoryLayout.astro';
import LibraryMazeCard from '../components/ui/LibraryMazeCard.astro';
import { LibraryProgress } from '../components/library/LibraryProgress';
import { getCategoryBySlug } from '../types/maze.js';
import { getLibraryMazesByDifficulty } from '../lib/library/catalog.js';

const category = getCategoryBySlug('medium-mazes')!;
const mazes = getLibraryMazesByDifficulty('medium');
const allIds = mazes.map((m) => m.id);
const firstLabel = 'Start Medium #001';

const BASE = 'https://mazethis.com';
const pageUrl = `${BASE}/medium-mazes`;
const pageTitle = 'Medium Mazes | Free Online 40×40 Maze Puzzles | MazeThis';
const pageDescription = 'Play free Medium Mazes online. Solve balanced 40×40 maze puzzles, track your progress, and continue through the full Medium Maze collection.';

const faqItems = [
  {
    q: 'What are Medium Mazes?',
    a: 'Medium Mazes are 40×40 grid maze puzzles on MazeThis. They introduce real branching paths and decision points — a step up from Small without being overwhelming. The collection contains 40 puzzles, each with a fixed unique layout.',
  },
  {
    q: 'Are these mazes free?',
    a: 'Yes. Every Medium Maze is free to play directly in your browser — no account, no download, and no sign-up required.',
  },
  {
    q: 'Does my progress save?',
    a: "Yes. Progress is saved on your device using browser storage. Completed mazes show a green checkmark badge and the progress bar updates automatically. No account is required.",
  },
  {
    q: 'Can I play these mazes online?',
    a: 'Yes. All Medium Mazes work in any modern browser on desktop, tablet, or phone. Use keyboard arrows, swipe, or the on-screen D-pad to navigate.',
  },
  {
    q: 'Can I print these mazes?',
    a: 'These collection pages are optimized for online solving. For worksheet-style printouts and optional answer key pages, use Printable Mazes.',
    aHtml: 'These collection pages are optimized for online solving. For worksheet-style printouts and optional answer key pages, use <a href="/printable-mazes" class="underline hover:opacity-80">Printable Mazes</a>.',
  },
  {
    q: 'What size should I try next?',
    a: 'Try Large Mazes next for a bigger challenge, or return to Small Mazes for quicker solves.',
    aHtml: 'Try <a href="/large-mazes" class="underline hover:opacity-80">Large Mazes</a> next for a bigger challenge, or return to <a href="/small-mazes" class="underline hover:opacity-80">Small Mazes</a> for quicker solves.',
  },
  {
    q: 'What is the difference between this collection and the Maze Generator?',
    a: 'This collection contains fixed, numbered mazes with progress tracking — each maze has a permanent URL and stays the same every visit. The Maze Generator creates a unique random maze on demand with no fixed layout or progress tracking.',
  },
];

const schemaLD = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': pageUrl,
      url: pageUrl,
      name: pageTitle,
      description: pageDescription,
      isPartOf: { '@id': `${BASE}/#website` },
      breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${BASE}/` },
        { '@type': 'ListItem', position: 2, name: 'Maze Library', item: `${BASE}/maze-library` },
        { '@type': 'ListItem', position: 3, name: 'Medium Mazes' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqItems.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a ?? '' },
      })),
    },
    {
      '@type': 'ItemList',
      name: 'Medium Mazes',
      numberOfItems: mazes.length,
      itemListElement: mazes.map((m, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `${BASE}/play/library/${m.id}`,
      })),
    },
  ],
});
---

<CategoryLayout
  category={category}
  totalCount={mazes.length}
  schemaLD={schemaLD}
  pageTitle={pageTitle}
  pageDescription={pageDescription}
  heroLabel="MEDIUM MAZE COLLECTION"
  heroDescription="Balanced 40×40 maze puzzles with more room to explore and more decisions to make."
  benefitCards={[
    { title: 'Balanced challenge', body: 'More decisions than Small mazes without feeling overwhelming.' },
    { title: 'Everyday practice', body: 'A good default size for regular maze solving.' },
    { title: 'Better orientation', body: 'Large enough to require planning, small enough to stay readable.' },
    { title: 'Next step up', body: 'A natural move after completing Small mazes.' },
  ]}
  faqItems={faqItems}
  ctaHeading="Ready for a bigger challenge?"
  ctaDescription="Move up to Large Mazes, explore the full Maze Library, or generate a custom maze."
  ctaLinks={[
    { label: 'Large Mazes', href: '/large-mazes' },
    { label: 'Maze Library', href: '/maze-library' },
    { label: 'Maze Generator', href: '/maze-generator' },
  ]}
>
  <!-- Progress row -->
  <div class="mb-6 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3">
    <div class="min-w-0 flex-1 max-w-sm">
      <LibraryProgress client:load total={mazes.length} difficulty={category.difficulty} />
    </div>
    <a
      id="play-next-link"
      href={`/play/library/${allIds[0]}`}
      data-all-ids={JSON.stringify(allIds)}
      data-first-label={firstLabel}
      class="btn-primary text-sm px-4 py-2 shrink-0 w-full sm:w-auto"
    >
      {firstLabel}
    </a>
  </div>

  <!-- Card grid -->
  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
    {mazes.map((entry, i) => (
      <LibraryMazeCard entry={entry} index={i} />
    ))}
  </div>
</CategoryLayout>

<script>
  (function () {
    try {
      var raw = localStorage.getItem('mazethis.library.progress');
      var ids = raw ? JSON.parse(raw)?.completedMazeIds : [];
      if (!Array.isArray(ids)) return;
      var done = new Set(ids);

      document.querySelectorAll('[data-maze-id]').forEach(function (el) {
        if (done.has(el.getAttribute('data-maze-id'))) {
          el.classList.add('maze-card-completed');
        }
      });

      var link = document.getElementById('play-next-link');
      if (!link) return;
      var allIds = JSON.parse(link.getAttribute('data-all-ids') ?? '[]');
      var next = allIds.find(function (id) { return !done.has(id); });

      if (next) {
        var nextCard = document.querySelector('[data-maze-id="' + next + '"]');
        if (nextCard) nextCard.classList.add('maze-card-next');
      }

      var firstLabel = link.getAttribute('data-first-label') ?? 'Play Next';

      if (done.size === 0) {
        link.textContent = firstLabel;
      } else if (next) {
        link.textContent = 'Play Next';
        link.setAttribute('href', '/play/library/' + next);
      } else {
        link.textContent = 'Collection Complete ✓';
        link.setAttribute('href', '/play/library/' + allIds[0]);
      }
    } catch (_) {}
  })();
</script>
