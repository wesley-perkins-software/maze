---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/nav/Breadcrumb.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const siteUrl = import.meta.env.SITE || 'https://mazethis.com';

const blogSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'MazeThis Blog',
  description: 'Articles about maze puzzles, maze generation algorithms, benefits of mazes for kids and seniors, and printable maze tips.',
  url: `${siteUrl}/blog`,
  publisher: {
    '@type': 'Organization',
    name: 'MazeThis',
    url: siteUrl,
  },
});
---

<BaseLayout
  title="Maze Puzzle Blog — Tips, History & Guides | MazeThis"
  description="Learn about maze generation algorithms, benefits of mazes for kids and adults, how to solve mazes, the history of labyrinths, and free printable maze guides."
  schemaLD={blogSchema}
>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-10">
    <Breadcrumb crumbs={[{ label: 'Home', href: '/' }, { label: 'Blog' }]} />

    <div class="mt-4 mb-10">
      <h1 class="mb-2">Maze Puzzle Blog</h1>
      <p class="text-slate-500 text-lg">
        Guides, history, and science behind the world's most satisfying puzzles.
      </p>
    </div>

    <div class="grid gap-8 sm:grid-cols-2">
      {posts.map((post) => (
        <article class="group flex flex-col rounded-xl border border-slate-200 bg-white overflow-hidden hover:shadow-md transition-shadow">
          <a href={`/blog/${post.slug}`} class="block p-6 flex-1">
            <div class="flex flex-wrap gap-2 mb-3">
              {post.data.tags.slice(0, 2).map((tag) => (
                <span class="inline-flex items-center rounded-full bg-blue-50 px-2.5 py-0.5 text-xs font-medium text-blue-700">
                  {tag}
                </span>
              ))}
            </div>
            <h2 class="text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors leading-snug mb-2">
              {post.data.title}
            </h2>
            <p class="text-sm text-slate-500 leading-relaxed line-clamp-3">
              {post.data.description}
            </p>
          </a>
          <div class="px-6 pb-4 flex items-center justify-between">
            <time
              datetime={post.data.pubDate.toISOString()}
              class="text-xs text-slate-400"
            >
              {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            <a href={`/blog/${post.slug}`} class="text-xs font-medium text-blue-600 hover:underline">
              Read →
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
