---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/nav/Breadcrumb.astro';
import MazeCard from '../components/ui/MazeCard.astro';
import { getMazesByDifficulty } from '../lib/catalog/index.js';

const easyMazes = getMazesByDifficulty('easy').slice(0, 10);
const mediumMazes = getMazesByDifficulty('medium').slice(0, 10);

const siteUrl = import.meta.env.SITE || 'https://mazethis.com';

const schemaLD = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Mazes for Seniors',
  description: 'Free printable maze puzzles for seniors and older adults. Cognitively engaging, large-print friendly, and scientifically supported as beneficial brain activity.',
  url: `${siteUrl}/mazes-for-seniors`,
  audience: { '@type': 'Audience', audienceType: 'Seniors, Older Adults' },
  publisher: { '@type': 'Organization', name: 'MazeThis', url: siteUrl },
});
---

<BaseLayout
  title="Free Printable Mazes for Seniors — Cognitive Brain Exercises | MazeThis"
  description="Free maze puzzles for seniors and older adults. Proven cognitive benefits: spatial memory, attention, problem-solving. Large-print friendly, no account needed."
  schemaLD={schemaLD}
>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-10">
    <Breadcrumb crumbs={[{ label: 'Home', href: '/' }, { label: 'Mazes for Seniors' }]} />

    <div class="mt-4 mb-8">
      <h1 class="mb-3">Mazes for Seniors</h1>
      <p class="text-slate-500 text-lg max-w-3xl">
        Free printable and interactive maze puzzles for older adults. Engaging, accessible,
        and backed by research on cognitive health and spatial memory maintenance.
      </p>
    </div>

    <!-- Benefits section -->
    <section class="mb-12 rounded-xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-800 mb-5">Why Maze Puzzles Are Good for Seniors</h2>
      <div class="grid sm:grid-cols-2 gap-5">
        {[
          {
            icon: '🧠',
            title: 'Spatial Memory',
            desc: 'Navigating a maze engages the hippocampus — the brain\'s spatial memory center. Regular spatial activity helps maintain this system, which is specifically vulnerable in aging.',
          },
          {
            icon: '🎯',
            title: 'Sustained Attention',
            desc: 'Mazes require focus on a single goal for several minutes. Regular attention practice is associated with slower cognitive decline in older adults.',
          },
          {
            icon: '🔄',
            title: 'Cognitive Flexibility',
            desc: 'Dead ends require the solver to abandon a failed strategy and try a new one — exactly the kind of mental flexibility that benefits from regular exercise.',
          },
          {
            icon: '✋',
            title: 'Fine Motor Practice',
            desc: 'Tracing printed mazes with a pencil maintains hand-eye coordination and pencil control. Beneficial for dexterity maintenance, especially for those managing arthritis.',
          },
          {
            icon: '😊',
            title: 'Mood and Accomplishment',
            desc: 'Completing a puzzle creates a genuine sense of achievement. Regular small victories contribute meaningfully to wellbeing and mood.',
          },
          {
            icon: '👥',
            title: 'Social Activity',
            desc: 'Mazes work well as a group activity — sharing strategies, helping each other, comparing times. The social dimension compounds the cognitive benefit.',
          },
        ].map(({ icon, title, desc }) => (
          <div class="flex gap-3">
            <span class="text-2xl shrink-0 leading-none mt-0.5" aria-hidden="true">{icon}</span>
            <div>
              <p class="font-semibold text-slate-700">{title}</p>
              <p class="text-sm text-slate-500 mt-0.5 leading-relaxed">{desc}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="mt-6 pt-5 border-t border-slate-200">
        <a href="/learn" class="text-sm font-medium text-blue-600 hover:underline">
          Explore more maze guides →
        </a>
      </div>
    </section>

    <!-- Difficulty guide -->
    <section class="mb-12">
      <h2 class="text-xl font-bold text-slate-800 mb-4">Choosing the Right Difficulty</h2>
      <div class="grid sm:grid-cols-3 gap-4">
        {[
          {
            label: 'Gentle Start',
            size: '8×8 to 10×10',
            diff: 'Easy',
            who: 'New to puzzles, or managing mild cognitive changes',
            href: '/easy-mazes',
          },
          {
            label: 'Active Minds',
            size: '12×12 to 15×15',
            diff: 'Medium',
            who: 'Regular puzzle solvers in good cognitive health',
            href: '/medium-mazes',
          },
          {
            label: 'Serious Challenge',
            size: '20×20 to 25×25',
            diff: 'Adults / Hard',
            who: 'Experienced solvers who want a real challenge',
            href: '/mazes-for-adults',
          },
        ].map(({ label, size, diff, who, href }) => (
          <a href={href} class="group block rounded-xl border border-slate-200 bg-white p-5 hover:border-blue-300 hover:shadow-sm transition-all">
            <p class="font-bold text-slate-800 group-hover:text-blue-600">{label}</p>
            <p class="text-sm text-slate-500 mt-1">{size} grid · {diff} difficulty</p>
            <p class="text-sm text-slate-400 mt-2 leading-snug">{who}</p>
            <p class="text-xs text-blue-600 mt-3 font-medium">Browse mazes →</p>
          </a>
        ))}
      </div>
    </section>

    <!-- Easy mazes section -->
    <section class="mb-10">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xl font-bold text-slate-800">Easy Mazes (Good Starting Point)</h2>
        <a href="/easy-mazes" class="text-sm font-medium text-blue-600 hover:underline">All 90 →</a>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4">
        {easyMazes.map((entry) => <MazeCard entry={entry} />)}
      </div>
    </section>

    <!-- Medium mazes section -->
    <section class="mb-10">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xl font-bold text-slate-800">Medium Mazes (Moderate Challenge)</h2>
        <a href="/medium-mazes" class="text-sm font-medium text-blue-600 hover:underline">All 90 →</a>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4">
        {mediumMazes.map((entry) => <MazeCard entry={entry} />)}
      </div>
    </section>

    <!-- Tips for seniors -->
    <section class="mt-8 prose prose-slate max-w-none">
      <h2>Tips for Getting the Most from Maze Puzzles</h2>
      <p>
        The key to lasting benefit from maze puzzles is <strong>consistent practice</strong>. Even 5–10 minutes
        of maze-solving per day is more valuable than an occasional longer session.
      </p>
      <h3>For printed mazes:</h3>
      <ul>
        <li>Use a pencil (not pen) — marking dead ends and your current path makes hard mazes much more manageable</li>
        <li>Print larger if corridors feel too narrow — you can scale up in your printer settings</li>
        <li>Keep a folder of completed mazes as a satisfying visual record of progress</li>
        <li>Work through them with a friend or family member for the added social benefit</li>
      </ul>
      <h3>For online mazes:</h3>
      <ul>
        <li>Use the on-screen D-pad rather than keyboard if arrow keys are difficult</li>
        <li>The "Show Solution" button is always available — use it as a learning tool, not a defeat</li>
        <li>Start with easy mazes and work up to harder ones as your familiarity increases</li>
      </ul>
      <p>
        <a href="/learn">Learn more about mazes →</a>
      </p>
    </section>
  </div>
</BaseLayout>
