---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/nav/Breadcrumb.astro';

const siteUrl = import.meta.env.SITE || 'https://mazepuzzles.io';

const faqItems = [
  {
    q: 'What is the Maze Library?',
    a: 'The Maze Library is a set of ready-to-play maze collections on MazePuzzles.io. Collections are organized by size — Small, Medium, Large, Expert, and Hardcore — and you can work through each one at your own pace. Your progress is saved in your browser automatically.',
  },
  {
    q: 'Are Maze Library collections free?',
    a: 'Yes. All Maze Library collections are free to play. No account and no subscription are required.',
  },
  {
    q: 'Does Maze Library progress save?',
    a: "Yes. Completed mazes are tracked in your browser automatically. Progress is stored locally — no account needed. Clearing your browser's local storage will remove it, and progress does not sync across devices.",
  },
  {
    q: 'What maze size should I start with?',
    a: 'Small mazes (20×20) are the right starting point for most players. They are quick to complete and let you build confidence with navigation before moving to larger grids. If you have solved mazes before and want a challenge, Medium (40×40) is a good starting point.',
  },
  {
    q: 'What is the hardest Maze Library collection?',
    a: 'Hardcore mazes (100×100) are the largest and most demanding in the library. They require patience, a systematic approach, and the ability to hold a mental map of a large grid. Expert mazes (80×80) are the next step down.',
  },
  {
    q: 'How is the Maze Library different from the Maze Generator?',
    a: 'The Maze Library has ready-made collections with progress tracking — you work through a set of mazes and your completions are recorded. The Maze Generator creates a single custom maze on demand with your chosen size. There is no progress to track, but you can play, print, or share any generated maze.',
  },
  {
    q: 'Can I print Maze Library mazes?',
    a: 'The Maze Library is designed for online play. For clean worksheet-style printouts with an optional answer key page, use the Printable Mazes tool at mazepuzzles.io/printable-mazes.',
  },
];

const articleSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'How to Use the Maze Library',
  description: 'How Maze Library collections, size tiers, progress tracking, and Play Next work on MazePuzzles.io.',
  url: `${siteUrl}/maze-guides/maze-library`,
  datePublished: '2025-05-29',
  dateModified: '2025-05-29',
  author: {
    '@type': 'Organization',
    name: 'MazePuzzles.io',
    url: siteUrl,
  },
  publisher: {
    '@type': 'Organization',
    name: 'MazePuzzles.io',
    url: siteUrl,
    logo: { '@type': 'ImageObject', url: `${siteUrl}/favicon-96x96.png` },
  },
  isPartOf: { '@id': `${siteUrl}/maze-guides` },
  isAccessibleForFree: true,
});

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
});

const breadcrumbSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Maze Guides', item: `${siteUrl}/maze-guides` },
    { '@type': 'ListItem', position: 3, name: 'Maze Library' },
  ],
});
---

<BaseLayout
  title="How to Use the Maze Library | MazePuzzles.io"
  description="How Maze Library collections, size tiers, progress tracking, and Play Next work on MazePuzzles.io."
  canonical={`${siteUrl}/maze-guides/maze-library/`}
  schemaLD={[articleSchema, faqSchema, breadcrumbSchema]}
>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 pt-8 pb-10 sm:pt-10">

    <Breadcrumb crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Maze Guides', href: '/maze-guides/' },
      { label: 'Maze Library' },
    ]} />

    <div class="mt-4 mb-10">
      <p class="text-xs tracking-widest uppercase font-semibold mb-2 text-arch-accent">Maze Collections</p>
      <h1 class="text-5xl sm:text-6xl text-arch-charcoal mb-4">How to Use the Maze Library</h1>
      <p class="text-arch-600 text-base max-w-xl">
        How Maze Library collections, size tiers, progress tracking, and Play Next work.
      </p>
    </div>

    <!-- Section 1: What is an online maze library -->
    <section class="mt-16 pt-10" style="border-top: 1px solid var(--color-border);">
      <h2 class="text-xl font-bold text-arch-charcoal mb-4">What is an online maze library?</h2>
      <p class="text-sm mb-4" style="color: var(--color-muted-strong);">
        A maze library is a collection of ready-to-play maze puzzles organized so you can work through them over time. Rather than generating a single maze and playing it once, you browse a set of collections, pick a starting point, and return to continue where you left off.
      </p>
      <p class="text-sm mb-4" style="color: var(--color-muted-strong);">
        The <a href="/maze-library/" class="text-arch-accent underline">MazePuzzles.io Maze Library</a> is organized by grid size — five tiers from Small to Hardcore. Each tier is its own collection. Your progress through each collection is tracked in your browser automatically.
      </p>
      <p class="text-sm" style="color: var(--color-muted-strong);">
        There is no account required and no limit on how long a collection takes to complete.
      </p>
    </section>

    <!-- Section 2: Five size tiers -->
    <section class="mt-12 pt-10" style="border-top: 1px solid var(--color-border);">
      <h2 class="text-xl font-bold text-arch-charcoal mb-4">How the five size tiers work</h2>
      <p class="text-sm mb-5" style="color: var(--color-muted-strong);">
        Each tier is a separate collection with mazes of a consistent grid size. Larger grids have longer paths, more dead ends to navigate, and require more time to complete.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {[
          { href: '/maze-library/small-mazes/',   label: 'Small',   size: '20×20',   desc: 'A manageable starting point. Good for building confidence with navigation controls and basic strategy.' },
          { href: '/maze-library/medium-mazes/',  label: 'Medium',  size: '40×40',   desc: 'A genuine challenge that takes more planning. The step up from Small is noticeable.' },
          { href: '/maze-library/large-mazes/',   label: 'Large',   size: '60×60',   desc: 'Requires patience and a more deliberate approach to avoid retracing paths.' },
          { href: '/maze-library/expert-mazes/',  label: 'Expert',  size: '80×80',   desc: 'Dense, demanding, and rewarding. Systematic dead-end elimination helps here.' },
          { href: '/maze-library/hardcore-mazes/', label: 'Hardcore', size: '100×100', desc: 'The largest tier. Finishing a Hardcore maze is a real milestone.' },
        ].map(({ href, label, size, desc }) => (
          <a href={href} class="card-hover rounded-lg p-4 flex flex-col gap-1 no-underline">
            <div class="flex items-baseline gap-2">
              <p class="font-semibold text-sm" style="color: var(--color-charcoal);">{label}</p>
              <p class="text-xs" style="color: var(--color-muted-strong);">{size}</p>
            </div>
            <p class="text-sm" style="color: var(--color-muted-strong);">{desc}</p>
            <span class="text-sm font-medium mt-2 text-arch-accent">Browse →</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Section 3: Progress tracking -->
    <section class="mt-12 pt-10" style="border-top: 1px solid var(--color-border);">
      <h2 class="text-xl font-bold text-arch-charcoal mb-4">How progress tracking works</h2>
      <p class="text-sm mb-4" style="color: var(--color-muted-strong);">
        Each time you complete a maze in the library, it is marked as solved in your browser. The collection view shows a progress count and a visual indicator on each completed maze. You can see at a glance which mazes remain in a tier.
      </p>
      <div class="card rounded-lg p-4 mb-4">
        <p class="font-semibold text-sm mb-1" style="color: var(--color-charcoal);">How it is stored</p>
        <p class="text-sm" style="color: var(--color-muted-strong);">
          Progress is saved in your browser's local storage. No account is required. This means your progress is only available on the device and browser where you played. Clearing your browser data will remove it.
        </p>
      </div>
      <p class="text-sm" style="color: var(--color-muted-strong);">
        Progress does not sync across devices. If you play on a phone and later open the library on a laptop, the laptop will start with an empty record.
      </p>
    </section>

    <!-- Section 4: Play Next -->
    <section class="mt-12 pt-10" style="border-top: 1px solid var(--color-border);">
      <h2 class="text-xl font-bold text-arch-charcoal mb-4">How Play Next works</h2>
      <p class="text-sm mb-4" style="color: var(--color-muted-strong);">
        Each collection tier has a Play Next button on the Maze Library page. Pressing it jumps directly to the first maze in that tier you have not yet completed. You do not need to scan the grid to find where you left off.
      </p>
      <p class="text-sm" style="color: var(--color-muted-strong);">
        Once you have completed all mazes in a tier, the Play Next button changes to indicate the collection is finished. You can still open any individual maze from the collection view.
      </p>
    </section>

    <!-- Section 5: Choosing a collection -->
    <section class="mt-12 pt-10" style="border-top: 1px solid var(--color-border);">
      <h2 class="text-xl font-bold text-arch-charcoal mb-4">Choosing a collection</h2>
      <p class="text-sm mb-4" style="color: var(--color-muted-strong);">
        If you are new to online mazes or just getting started, Small mazes are the right starting point. They are short enough to finish quickly and long enough to practice navigation and backtracking.
      </p>
      <p class="text-sm mb-4" style="color: var(--color-muted-strong);">
        If you have solved mazes before and want a real challenge without the commitment of a very large maze, Medium is a natural step up. Large mazes are for players who want longer sessions and more complex layouts.
      </p>
      <p class="text-sm" style="color: var(--color-muted-strong);">
        Expert and Hardcore are for experienced players who want the maximum challenge. There is no requirement to complete earlier tiers before starting a harder one — collections are independent.
      </p>
    </section>

    <!-- Section 6: Library vs Generator -->
    <section class="mt-12 pt-10" style="border-top: 1px solid var(--color-border);">
      <h2 class="text-xl font-bold text-arch-charcoal mb-4">Maze Library vs. Maze Generator</h2>
      <p class="text-sm mb-5" style="color: var(--color-muted-strong);">
        Both tools let you play mazes, but they serve different purposes.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="card rounded-lg p-4">
          <p class="font-semibold text-sm mb-2" style="color: var(--color-charcoal);">Maze Library</p>
          <ul class="text-sm space-y-1" style="color: var(--color-muted-strong);">
            <li>Ready-to-play collections</li>
            <li>Progress tracked automatically</li>
            <li>Play Next to continue a set</li>
            <li>Best for working through a challenge over time</li>
          </ul>
          <a href="/maze-library/" class="text-sm font-medium mt-3 block text-arch-accent">Browse Maze Library →</a>
        </div>
        <div class="card rounded-lg p-4">
          <p class="font-semibold text-sm mb-2" style="color: var(--color-charcoal);">Maze Generator</p>
          <ul class="text-sm space-y-1" style="color: var(--color-muted-strong);">
            <li>Custom maze on demand</li>
            <li>Choose any size</li>
            <li>Play online, print, or share</li>
            <li>Best for one-off mazes or printing</li>
          </ul>
          <a href="/maze-generator/" class="text-sm font-medium mt-3 block text-arch-accent">Open Maze Generator →</a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="mt-16 pt-10" style="border-top: 1px solid var(--color-border);">
      <h2 class="text-xl font-bold text-arch-charcoal mb-6">Frequently asked questions</h2>
      <dl class="space-y-5">
        {faqItems.map(({ q, a }) => (
          <div class="border-b pb-5 last:border-0" style="border-color: var(--color-border);">
            <dt class="font-semibold mb-1" style="color: var(--color-charcoal);">{q}</dt>
            <dd class="text-sm" style="color: var(--color-muted-strong);">{a}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- CTA -->
    <section class="mt-12 rounded-sm border border-arch-200 bg-arch-bg p-6">
      <h2 class="text-lg font-bold text-arch-charcoal mb-2">Ready to start a collection?</h2>
      <p class="text-sm text-arch-600 mb-5">Choose a Maze Library collection and work through it at your own pace.</p>
      <div class="flex flex-wrap gap-3">
        <a href="/maze-library/" class="btn-secondary">Browse Maze Library</a>
        <a href="/maze-library/small-mazes/" class="btn-secondary">Start with Small Mazes</a>
      </div>
    </section>

    <!-- Back link -->
    <div class="mt-10 text-center">
      <a
        href="/maze-guides/"
        class="text-sm transition-colors"
        style="color: var(--color-muted-strong);"
        onmouseover="this.style.color='var(--color-charcoal)'"
        onmouseout="this.style.color='var(--color-muted-strong)'"
      >← All guides</a>
    </div>

  </div>
</BaseLayout>
