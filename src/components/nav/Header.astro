---
import CategoryNav from './CategoryNav.astro';

const pathname = Astro.url.pathname;
---

<header
  class="sticky top-0 z-40 backdrop-blur-md"
  style="background-color: color-mix(in srgb, var(--color-bg) 92%, transparent); border-bottom: 1px solid var(--color-border);"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-14 items-center justify-between gap-4">

      <!-- Logo — geometric, text-based -->
      <a
        href="/"
        class="flex items-center gap-3 shrink-0 group"
        aria-label="MazePuzzles.io home"
      >
        <img
          src="/favicon-96x96.png"
          width="24" height="24"
          alt=""
          aria-hidden="true"
          class="transition-transform duration-200 group-hover:scale-110"
        />
        <span
          class="font-display text-2xl tracking-wider uppercase"
          style="color: var(--color-charcoal);"
        >MazePuzzles.io</span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-1" aria-label="Main navigation">
        <a
          href="/maze-generator"
          class:list={[
            'btn-ghost text-sm px-3 py-1.5',
            pathname === '/maze-generator' ? 'text-accent font-semibold' : '',
          ]}
          style={pathname === '/maze-generator' ? 'color: var(--color-accent);' : ''}
        >
          Maze Generator
        </a>
        <a
          href="/maze-library"
          class:list={[
            'btn-ghost text-sm px-3 py-1.5',
            (pathname === '/maze-library' || pathname.endsWith('-mazes') || pathname.startsWith('/play/library')) ? 'font-semibold' : '',
          ]}
          style={(pathname === '/maze-library' || pathname.endsWith('-mazes') || pathname.startsWith('/play/library')) ? 'color: var(--color-accent);' : ''}
        >
          Maze Library
        </a>
        <a
          href="/maze-guides"
          class:list={[
            'btn-ghost text-sm px-3 py-1.5',
            pathname.startsWith('/maze-guides') ? 'font-semibold' : '',
          ]}
          style={pathname.startsWith('/maze-guides') ? 'color: var(--color-accent);' : ''}
        >
          Maze Guides
        </a>

        <!-- Primary CTA -->
        <a href="/play/maze-of-the-day/" class="btn-primary ml-4 text-xs px-4 py-2">
          Maze of the Day
        </a>
      </nav>

      <div class="flex items-center gap-1">
        <!-- Dark mode toggle -->
        <button
          id="theme-toggle"
          class="btn-ghost p-2"
          aria-label="Toggle dark mode"
          title="Toggle dark mode"
          style="color: var(--color-muted-strong);"
        >
          <svg id="theme-icon-sun" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
          </svg>
          <svg id="theme-icon-moon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
          </svg>
        </button>

        <!-- Mobile nav toggle -->
        <button
          id="mobile-menu-toggle"
          class="md:hidden btn-ghost p-2"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Open menu"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden px-4 py-3 space-y-0.5"
    style="border-top: 1px solid var(--color-border); background-color: var(--color-bg);"
  >
    <a href="/play/maze-of-the-day/" class="block btn-ghost w-full text-left font-semibold py-2.5" style="color: var(--color-accent);">Maze of the Day</a>
    <a href="/maze-generator" class="block btn-ghost w-full text-left py-2.5">Maze Generator</a>
    <a href="/maze-library" class="block btn-ghost w-full text-left py-2.5">Maze Library</a>
    <a href="/maze-library/small-mazes" class="block btn-ghost w-full text-left py-2.5 pl-6 text-slate-500">Small Mazes</a>
    <a href="/maze-library/medium-mazes" class="block btn-ghost w-full text-left py-2.5 pl-6 text-slate-500">Medium Mazes</a>
    <a href="/maze-library/large-mazes" class="block btn-ghost w-full text-left py-2.5 pl-6 text-slate-500">Large Mazes</a>
    <a href="/maze-library/expert-mazes" class="block btn-ghost w-full text-left py-2.5 pl-6 text-slate-500">Expert Mazes</a>
    <a href="/maze-library/hardcore-mazes" class="block btn-ghost w-full text-left py-2.5 pl-6 text-slate-500">Hardcore Mazes</a>
    <a href="/maze-guides" class="block btn-ghost w-full text-left py-2.5">Maze Guides</a>
    <a href="/faq" class="block btn-ghost w-full text-left py-2.5">FAQ</a>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!open));
  });

  const themeBtn = document.getElementById('theme-toggle');
  const sunIcon = document.getElementById('theme-icon-sun');
  const moonIcon = document.getElementById('theme-icon-moon');

  function updateIcons() {
    const isDark = document.documentElement.classList.contains('dark');
    sunIcon?.classList.toggle('hidden', !isDark);
    moonIcon?.classList.toggle('hidden', isDark);
  }

  updateIcons();

  themeBtn?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch(e) {}
    updateIcons();
  });
</script>
