---
import CategoryNav from './CategoryNav.astro';

const pathname = Astro.url.pathname;
---

<header class="sticky top-0 z-40 bg-white border-b border-slate-200 shadow-sm">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-14 items-center justify-between gap-4">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 font-bold text-lg text-blue-600 shrink-0" aria-label="MazeThis home">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <rect width="28" height="28" rx="6" fill="#2563eb"/>
          <path d="M4 4h7v4H4zM17 4h7v7h-4V8h-3zM4 12h3v4H4zM11 8h3v8h-3zM4 20h7v4H4zM14 16h7v4h-4v4h-3z" fill="white"/>
        </svg>
        <span>MazeThis</span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-1" aria-label="Main navigation">
        <a href="/maze-generator" class:list={['btn-ghost', pathname === '/maze-generator' && 'bg-slate-100']}>
          Generator
        </a>
        <a href="/easy-mazes" class:list={['btn-ghost', pathname.includes('mazes') && 'bg-slate-100']}>
          Maze Library
        </a>
        <a href="/maze-generator" class="btn-primary ml-2">
          Create Maze
        </a>
      </nav>

      <!-- Mobile nav toggle -->
      <button
        id="mobile-menu-toggle"
        class="md:hidden btn-ghost p-2"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white px-4 py-3 space-y-1">
    <a href="/maze-generator" class="block btn-ghost w-full text-left">Generator</a>
    <a href="/easy-mazes" class="block btn-ghost w-full text-left">Easy Mazes</a>
    <a href="/medium-mazes" class="block btn-ghost w-full text-left">Medium Mazes</a>
    <a href="/hard-mazes" class="block btn-ghost w-full text-left">Hard Mazes</a>
    <a href="/mazes-for-kids" class="block btn-ghost w-full text-left">Kids Mazes</a>
    <a href="/mazes-for-adults" class="block btn-ghost w-full text-left">Adults Mazes</a>
    <div class="pt-2">
      <a href="/maze-generator" class="btn-primary w-full justify-center">Create Maze</a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!open));
  });
</script>
