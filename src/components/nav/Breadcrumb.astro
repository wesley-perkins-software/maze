---
export interface Props {
  crumbs: Array<{ label: string; href?: string }>;
}
const { crumbs } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-sm">
  <ol class="flex flex-wrap items-center gap-1 text-slate-500">
    {crumbs.map((crumb, i) => (
      <li class="flex items-center gap-1">
        {i > 0 && (
          <svg class="w-3 h-3 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        )}
        {crumb.href ? (
          <a href={crumb.href} class="hover:text-blue-600 transition-colors">
            {crumb.label}
          </a>
        ) : (
          <span class="text-slate-700 font-medium" aria-current="page">{crumb.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
