---
import { CATEGORIES } from '../../types/maze.js';

export interface Props {
  activeDifficulty?: string;
  compact?: boolean;
}

const { activeDifficulty, compact = false } = Astro.props;

const emojiMap: Record<string, string> = {
  small:   '🌱',
  medium:  '⚡',
  large:   '🔥',
  expert:  '🧠',
  hardcore: '🏔️',
};
---

<nav aria-label="Maze categories">
  {compact ? (
    <div class="flex flex-wrap gap-2">
      {CATEGORIES.map((cat) => (
        <a
          href={`/${cat.slug}`}
          class:list={[
            'badge border',
            activeDifficulty === cat.difficulty
              ? 'bg-arch-accent border-arch-accent text-white'
              : 'bg-arch-surface border-arch-100 text-arch-charcoal hover:border-arch-charcoal transition-colors',
          ]}
          aria-current={activeDifficulty === cat.difficulty ? 'page' : undefined}
        >
          {cat.label}
        </a>
      ))}
    </div>
  ) : (
    <div class="grid grid-cols-3 sm:grid-cols-5 gap-3">
      {CATEGORIES.map((cat) => (
        <a
          href={`/${cat.slug}`}
          class:list={[
            'flex flex-col items-center gap-1 rounded-xl border p-4 text-center transition-all',
            activeDifficulty === cat.difficulty
              ? 'border-arch-accent bg-arch-surface'
              : 'border-arch-100 bg-arch-surface hover:border-arch-charcoal transition-colors',
          ]}
          aria-current={activeDifficulty === cat.difficulty ? 'page' : undefined}
        >
          <span class="text-2xl" aria-hidden="true">{emojiMap[cat.difficulty]}</span>
          <span class="text-sm font-semibold text-arch-charcoal">{cat.label}</span>
        </a>
      ))}
    </div>
  )}
</nav>
