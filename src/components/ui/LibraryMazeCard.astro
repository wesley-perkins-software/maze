---
import type { LibraryCatalogEntry } from '../../types/maze.js';
import { generateMazeFromLibraryCatalog } from '../../lib/maze/index.js';
import { renderThumbnail } from '../../lib/svg/renderToString.js';

export interface Props {
  entry: LibraryCatalogEntry;
  index: number;
}

const { entry, index } = Astro.props;
const maze = generateMazeFromLibraryCatalog(entry);
const svg = renderThumbnail(maze);
const num = String(index + 1).padStart(3, '0');
const label = `${entry.difficulty.charAt(0).toUpperCase()}${entry.difficulty.slice(1)} #${num}`;
---

<a
  href={`/play/library/${entry.id}`}
  class="card card-hover group block relative"
  data-maze-id={entry.id}
  aria-label={`Play ${label}`}
>
  <!-- Completed badge — top-right, shown when maze-card-completed class is applied -->
  <div
    class="completed-badge absolute top-2 right-2 z-10 items-center gap-0.5 px-2 py-0.5 text-white font-semibold rounded-sm shadow"
    aria-hidden="true"
    style="font-family: 'IBM Plex Mono', monospace; background-color: #10b981; font-size: 0.8125rem; letter-spacing: 0.02em;"
  >
    ✓ Complete
  </div>
  <!-- Next badge — top-left, shown when maze-card-next class is applied -->
  <div
    class="next-badge absolute top-2 left-2 z-10 items-center gap-0.5 px-2 py-0.5 text-white font-semibold rounded-sm shadow"
    aria-hidden="true"
    style="font-family: 'IBM Plex Mono', monospace; background-color: #E03B24; font-size: 0.8125rem; letter-spacing: 0.02em;"
  >
    → Next
  </div>
  <div
    class="maze-thumbnail flex items-center justify-center p-2 aspect-square overflow-hidden transition-transform duration-300 group-hover:scale-[1.03]"
    style="background-color: var(--color-bg);"
    set:html={svg}
  />
  <div
    class="p-3"
    style="border-top: 1px solid var(--color-border);"
  >
    <p
      class="text-sm font-semibold leading-tight transition-colors duration-150"
      style="color: var(--color-charcoal);"
    >
      {label}
    </p>
    <p
      class="play-hint text-sm mt-0.5 transition-opacity duration-150 group-hover:opacity-0"
      style="color: var(--color-charcoal);"
    >
      Play →
    </p>
  </div>
</a>

<style is:global>
  .completed-badge {
    display: none;
  }

  .next-badge {
    display: none;
  }

  [data-maze-id].maze-card-completed {
    border-color: #10b981;
    box-shadow: 0 0 0 1px #10b981;
  }

  [data-maze-id].maze-card-completed .completed-badge {
    display: inline-flex;
  }

  [data-maze-id].maze-card-completed .maze-thumbnail {
    opacity: 0.88;
  }

  [data-maze-id].maze-card-next .next-badge {
    display: inline-flex;
  }
</style>
