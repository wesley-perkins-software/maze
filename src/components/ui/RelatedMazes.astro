---
import type { MazeCatalogEntry } from '../../types/maze.js';
import { generateMazeTitle } from '../../lib/catalog/seo.js';
import { generateMazeFromCatalog } from '../../lib/maze/index.js';
import { renderThumbnail } from '../../lib/svg/renderToString.js';
import DifficultyBadge from './DifficultyBadge.astro';

export interface Props {
  mazes: MazeCatalogEntry[];
  heading?: string;
}

const { mazes, heading = 'More Mazes' } = Astro.props;
---

{mazes.length > 0 && (
  <section aria-labelledby="related-heading">
    <h2 id="related-heading" class="text-xl font-bold text-slate-800 mb-4">{heading}</h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
      {mazes.map((entry) => {
        const maze = generateMazeFromCatalog(entry);
        const svg = renderThumbnail(maze);
        const title = generateMazeTitle(entry);
        return (
          <a
            href={`/mazes/${entry.slug}`}
            class="card hover:shadow-md transition-shadow group"
            aria-label={title}
          >
            <div
              class="bg-slate-50 flex items-center justify-center p-2"
              set:html={svg}
            />
            <div class="p-2">
              <p class="text-xs font-medium text-slate-600 truncate group-hover:text-blue-600 transition-colors">
                {title}
              </p>
            </div>
          </a>
        );
      })}
    </div>
  </section>
)}
