---
const measurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID as string | undefined;
---

{measurementId && (
  <>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src={'https://www.googletagmanager.com/gtag/js?id=' + measurementId}></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    </script>
    <meta name="ga-mid" content={measurementId} />
    <script>
      // Initialise GA config only on production domains
      const mid = document.querySelector('meta[name="ga-mid"]')?.getAttribute('content');
      if (mid) {
        const host = window.location.hostname;
        if (host === 'mazepuzzles.io' || host === 'www.mazepuzzles.io') {
          window.gtag?.('config', mid);
        }
      }
    </script>
  </>
)}
