---
const measurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID as string | undefined;
---

{measurementId && (
  <script is:inline>
    (function () {
      var el = document.querySelector('meta[name="ga-mid"]');
      if (!el) return;
      var mid = el.getAttribute('content');
      if (!mid) return;
      var host = window.location.hostname;
      if (host !== 'mazepuzzles.io' && host !== 'www.mazepuzzles.io') return;
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + mid;
      document.head.appendChild(s);
      s.onload = function () {
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', mid);
      };
    })();
  </script>
)}
{measurementId && <meta name="ga-mid" content={measurementId} />}
