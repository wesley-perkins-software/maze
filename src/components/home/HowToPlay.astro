---
---

<section class="py-16" aria-labelledby="how-to-play-heading">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <h2 id="how-to-play-heading" class="text-2xl font-bold text-slate-800 mb-2 text-center">
      How to Play
    </h2>
    <p class="text-slate-500 text-center mb-10">Everything you need to start solving mazes</p>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
      <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
        <div class="text-3xl mb-3" aria-hidden="true">🖨️</div>
        <h3 class="font-semibold text-slate-700 mb-2">Print</h3>
        <p class="text-sm text-slate-500">
          Open any maze and click "Print Maze" for a clean, printer-friendly version. Perfect for classrooms and home.
        </p>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
        <div class="text-3xl mb-3" aria-hidden="true">⌨️</div>
        <h3 class="font-semibold text-slate-700 mb-2">Play Online</h3>
        <p class="text-sm text-slate-500">
          Use arrow keys or WASD on desktop, or swipe on mobile. Your trail is shown so you never lose track.
        </p>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
        <div class="text-3xl mb-3" aria-hidden="true">⚙️</div>
        <h3 class="font-semibold text-slate-700 mb-2">Generate</h3>
        <p class="text-sm text-slate-500">
          Use the maze generator to create custom mazes in any size and difficulty. Download as SVG or print directly.
        </p>
      </div>
    </div>
  </div>
</section>
