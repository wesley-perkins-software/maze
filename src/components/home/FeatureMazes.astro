---
import { getFeaturedMazes } from '../../lib/catalog/index.js';
import { generateMazeFromCatalog } from '../../lib/maze/index.js';
import { renderThumbnail } from '../../lib/svg/renderToString.js';
import type { Difficulty } from '../../types/maze.js';

const featured = getFeaturedMazes();
const svgs = featured.map(entry => renderThumbnail(generateMazeFromCatalog(entry)));

const labels: Record<Difficulty, { name: string; time: string; desc: string; href: string }> = {
  small:  { name: 'Small',  time: '~1–2 min',   desc: 'Quick mazes for kids and warm-ups.',  href: '/small-mazes'  },
  medium: { name: 'Medium', time: '~5–10 min',  desc: 'Balanced mazes for a focused solve.', href: '/medium-mazes' },
  large:  { name: 'Large',  time: '~10–20 min', desc: 'Dense mazes for a real challenge.',   href: '/large-mazes'  },
};
---

<section
  id="maze-library"
  class="py-16 sm:py-20"
  style="background-color: var(--color-surface); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);"
  aria-labelledby="challenge-heading"
>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="flex items-end justify-between mb-10">
      <div>
        <p
          class="text-xs uppercase tracking-widest mb-2"
          style="font-family: 'IBM Plex Mono', monospace; color: var(--color-muted-strong);"
        >Free Maze Library</p>
        <h2
          id="challenge-heading"
          class="font-display text-5xl sm:text-6xl uppercase"
          style="color: var(--color-charcoal);"
        >Pick Your<br />Challenge</h2>
        <p
          class="mt-3 text-sm leading-relaxed max-w-md"
          style="color: var(--color-muted-strong);"
        >420+ free printable mazes in three sizes — play online or print at home.</p>
      </div>
      <a
        href="/large-mazes"
        class="hidden sm:inline-flex items-center gap-1.5 feat-viewall-desktop"
      >View all 420+ mazes →</a>
    </div>

    <!-- Three cards — each entire card is one link -->
    <div class="feat-grid">
      {featured.map((entry, i) => {
        const meta = labels[entry.difficulty];
        const svg  = svgs[i];
        return (
          <a href={meta.href} class="feat-col" aria-label={`Browse ${meta.name} mazes`}>

            <!-- Right content: flex column on mobile; display:contents on desktop -->
            <div class="feat-right">

              <!-- Title + solve time (both mobile and desktop) -->
              <div class="feat-name-wrap">
                <span class="font-display uppercase feat-name">{meta.name}</span>
                <span class="feat-mono feat-time">{meta.time}</span>
              </div>

              <!-- Maze preview -->
              <div class="feat-preview-frame">
                <div class="feat-preview" set:html={svg} />
              </div>

              <!-- Description -->
              <div class="feat-body feat-mono">
                <span class="feat-desc">{meta.desc}</span>
              </div>

              <!-- Browse footer -->
              <div class="feat-strip-bottom feat-mono">
                Browse {meta.name.toLowerCase()} <span class="feat-arrow">→</span>
              </div>

            </div>

          </a>
        );
      })}
    </div>

    <!-- Mobile: view all link -->
    <div
      class="mt-4 sm:hidden"
      style="border-top: 1px solid var(--color-border); padding-top: 0.875rem;"
    >
      <a
        href="/large-mazes"
        class="feat-viewall-link text-xs uppercase tracking-widest block text-center"
        style="font-family: 'IBM Plex Mono', monospace;"
      >View all 420+ mazes →</a>
    </div>

  </div>
</section>

<style>
  /* ── SVG fills its container ─────────────────────────────────────────────── */
  .feat-preview :global(svg) { width: 100%; height: 100%; display: block; }

  /* ── Outer grid ──────────────────────────────────────────────────────────────
     Mobile:  1-col stack with 6px cream gaps
     Desktop: 3-col editorial table
  ─────────────────────────────────────────────────────────────────────────── */
  .feat-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 6px;
    background-color: var(--color-bg);
  }
  @media (min-width: 640px) {
    .feat-grid {
      grid-template-columns: repeat(3, 1fr);
      border-top: 1px solid var(--color-border);
      gap: 0;
      background-color: transparent;
    }
    .feat-col:not(:first-child) {
      border-left: 1px solid var(--color-border);
    }
  }

  /* ── Card ────────────────────────────────────────────────────────────────────
     Mobile:  2-col thumbnail-left media row (104px | 1fr)
     Desktop: vertical flex card, title above preview
  ─────────────────────────────────────────────────────────────────────────── */
  .feat-col {
    display: grid;
    grid-template-columns: 104px 1fr;
    background-color: var(--color-surface);
    text-decoration: none;
    transition: background-color 120ms ease;
  }
  @media (min-width: 640px) {
    .feat-col {
      display: flex;
      flex-direction: column;
    }
  }
  .feat-col:hover,
  .feat-col:focus-visible {
    background-color: var(--color-bg);
    outline: none;
  }
  .feat-col:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  /* ── Right content wrapper ───────────────────────────────────────────────────
     Mobile:  flex column occupying col 2 of the card grid
     Desktop: display:contents — children become direct flex items of .feat-col
  ─────────────────────────────────────────────────────────────────────────── */
  .feat-right {
    display: contents;
  }
  @media (max-width: 639px) {
    .feat-right {
      display: flex;
      flex-direction: column;
      min-width: 0;
    }
  }

  /* ── Shared mono ────────────────────────────────────────────────────────── */
  .feat-mono { font-family: 'IBM Plex Mono', monospace; }

  /* ── Title + time row ───────────────────────────────────────────────────── */
  .feat-name-wrap {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.75rem 0.875rem 0.25rem;
  }
  @media (min-width: 640px) {
    .feat-name-wrap {
      padding: 0.75rem 1.25rem 0.625rem;
      border-bottom: 1px solid var(--color-border);
    }
  }
  .feat-name {
    font-size: 1.75rem;
    line-height: 1;
    color: var(--color-charcoal);
  }
  @media (min-width: 640px) {
    .feat-name {
      display: block;
      font-size: clamp(2rem, 5vw, 2.75rem);
    }
  }

  /* ── Solve time ─────────────────────────────────────────────────────────── */
  .feat-time {
    font-size: 0.6875rem;
    color: var(--color-muted-strong);
    line-height: 1;
    flex-shrink: 0;
    white-space: nowrap;
  }
  @media (min-width: 640px) {
    .feat-time {
      font-size: 0.75rem;
      color: var(--color-muted-strong);
      align-self: flex-end;
      padding-bottom: 0.125rem;
    }
  }

  /* ── Maze preview ────────────────────────────────────────────────────────── */
  .feat-preview-frame {
    /* Mobile: square thumb, col 1, with right border */
    grid-row: 1 / 5;
    width: 104px;
    aspect-ratio: 1;
    align-self: center;
    overflow: hidden;
    border-right: 1px solid var(--color-border);
    flex-shrink: 0;
    transition: border-color 150ms ease;
  }
  @media (min-width: 640px) {
    .feat-preview-frame {
      grid-row: unset;
      width: auto;
      aspect-ratio: unset;
      align-self: stretch;
      border-right: none;
      /* Conservative padding keeps maze dominant; just a hint of breathing room */
      padding: 0.5rem;
      border-bottom: 1px solid var(--color-border);
      transition: border-color 150ms ease;
    }
  }
  .feat-col:hover .feat-preview-frame {
    border-color: var(--color-border-strong);
  }
  .feat-preview {
    width: 100%;
    height: 100%;
    transition: transform 400ms ease;
  }
  .feat-col:hover .feat-preview { transform: scale(1.012); }

  /* ── Description ─────────────────────────────────────────────────────────── */
  .feat-body {
    flex: 1;
    padding: 0.375rem 0.875rem 0.25rem;
    display: flex;
    flex-direction: column;
  }
  @media (min-width: 640px) {
    .feat-body { padding: 0.625rem 1.25rem 0.375rem; }
  }
  .feat-desc {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--color-muted-strong);
  }

  /* ── Browse footer ──────────────────────────────────────────────────────── */
  .feat-strip-bottom {
    padding: 0.3125rem 0.875rem 0.75rem;
    font-size: 0.75rem;
    color: var(--color-muted-strong);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 2px;
    transition: color 120ms ease, text-decoration-color 120ms ease;
  }
  @media (min-width: 640px) {
    .feat-strip-bottom {
      padding: 0.5rem 1.25rem 0.875rem;
      font-size: 0.8125rem;
      color: var(--color-charcoal-2);
      text-decoration: underline;
      text-decoration-color: var(--color-border-strong);
      border-top: 1px solid var(--color-border);
    }
  }
  .feat-col:hover .feat-strip-bottom,
  .feat-col:focus-visible .feat-strip-bottom {
    color: var(--color-charcoal);
    text-decoration-color: currentColor;
  }

  /* ── Browse arrow shift on hover ────────────────────────────────────────── */
  .feat-arrow {
    display: inline-block;
    transition: transform 150ms ease;
  }
  .feat-col:hover .feat-arrow,
  .feat-col:focus-visible .feat-arrow {
    transform: translateX(4px);
  }

  /* ── Desktop "View all" link ────────────────────────────────────────────── */
  .feat-viewall-desktop {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-charcoal);
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-underline-offset: 3px;
    transition: color 120ms ease, text-decoration-color 120ms ease;
  }
  .feat-viewall-desktop:hover,
  .feat-viewall-desktop:focus-visible {
    color: var(--color-charcoal);
    text-decoration-color: var(--color-charcoal);
    outline: none;
  }
  .feat-viewall-desktop:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* ── Mobile "View all" closing link ─────────────────────────────────────── */
  .feat-viewall-link {
    color: var(--color-muted-strong);
    transition: color 120ms ease;
  }
  .feat-viewall-link:hover,
  .feat-viewall-link:focus-visible {
    color: var(--color-charcoal);
    outline: none;
  }
  .feat-viewall-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>
