---
import MazeCard from '../ui/MazeCard.astro';
import { getFeaturedMazes } from '../../lib/catalog/index.js';
import type { Difficulty } from '../../types/maze.js';

const featured = getFeaturedMazes();

const labels: Record<Difficulty, { title: string; description: string; time: string; href: string }> = {
  small:  { title: 'Small',  description: 'Quick mazes for kids and warm-ups.',  time: '~1–2 min',   href: '/small-mazes'  },
  medium: { title: 'Medium', description: 'Balanced mazes for a focused solve.',  time: '~5–10 min',  href: '/medium-mazes' },
  large:  { title: 'Large',  description: 'Dense mazes for a real challenge.',    time: '~10–20 min', href: '/large-mazes'  },
};
---

<section
  class="py-16 sm:py-20"
  style="background-color: var(--color-surface); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);"
  aria-labelledby="challenge-heading"
>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="flex items-end justify-between mb-10">
      <div>
        <p
          class="text-xs uppercase tracking-widest mb-2"
          style="font-family: 'IBM Plex Mono', monospace; color: var(--color-muted);"
        >Maze Library</p>
        <h2
          id="challenge-heading"
          class="font-display text-5xl sm:text-6xl uppercase"
          style="color: var(--color-charcoal);"
        >Pick Your<br />Challenge</h2>
      </div>
      <a
        href="/large-mazes"
        class="hidden sm:inline-flex items-center gap-1.5 text-xs uppercase tracking-widest pb-1 transition-colors"
        style="font-family: 'IBM Plex Mono', monospace; color: var(--color-muted); border-bottom: 1px solid var(--color-border);"
        onmouseover="this.style.color='var(--color-accent)'; this.style.borderColor='var(--color-accent)';"
        onmouseout="this.style.color='var(--color-muted)'; this.style.borderColor='var(--color-border)';"
      >View all 420+ mazes →</a>
    </div>

    <!-- Three columns -->
    <div class="grid grid-cols-1 sm:grid-cols-3 sm:gap-px" style="background-color: var(--color-border);">
      {featured.map((entry) => {
        const meta = labels[entry.difficulty];
        return (
          <a
            href={meta.href}
            class="group flex flex-row sm:flex-col items-stretch transition-colors duration-150"
            style="background-color: var(--color-surface); border-top: 1px solid var(--color-border);"
            onmouseover="this.style.backgroundColor='var(--color-bg)';"
            onmouseout="this.style.backgroundColor='var(--color-surface)';"
          >
            <!-- Image preview -->
            <div class="w-28 shrink-0 sm:w-auto sm:shrink" style="border-right: 1px solid var(--color-border);">
              <MazeCard entry={entry} imageOnly={true} />
            </div>

            <!-- Text content -->
            <div class="flex-1 flex flex-col px-3 py-3 sm:py-0 min-w-0">
              <!-- Size name + time -->
              <div class="flex items-baseline justify-between gap-2 sm:pt-4 sm:pb-1">
                <span
                  class="font-display text-2xl sm:text-4xl uppercase leading-none"
                  style="color: var(--color-charcoal);"
                >{meta.title}</span>
                <span
                  class="text-xs shrink-0"
                  style="font-family: 'IBM Plex Mono', monospace; color: var(--color-muted);"
                >{meta.time}</span>
              </div>

              <!-- Description -->
              <p
                class="text-xs leading-snug mt-1 sm:mt-2"
                style="font-family: 'IBM Plex Mono', monospace; color: var(--color-muted);"
              >{meta.description}</p>

              <!-- Browse link -->
              <span
                class="mt-auto pt-3 text-xs uppercase tracking-widest"
                style="font-family: 'IBM Plex Mono', monospace; color: var(--color-muted-strong);"
              >Browse {meta.title} mazes →</span>
            </div>
          </a>
        );
      })}
    </div>

    <!-- Mobile all-mazes link -->
    <div class="mt-5 sm:hidden text-center">
      <a
        href="/large-mazes"
        class="text-xs uppercase tracking-widest"
        style="font-family: 'IBM Plex Mono', monospace; color: var(--color-muted);"
      >View all 420+ mazes →</a>
    </div>
  </div>
</section>
