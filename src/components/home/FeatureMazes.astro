---
import { getFeaturedMazes } from '../../lib/catalog/index.js';
import { generateMazeFromCatalog } from '../../lib/maze/index.js';
import { renderThumbnail } from '../../lib/svg/renderToString.js';
import type { Difficulty } from '../../types/maze.js';

const featured = getFeaturedMazes();
const svgs = featured.map(entry => renderThumbnail(generateMazeFromCatalog(entry)));

const labels: Record<Difficulty, { num: string; name: string; time: string; desc: string; href: string }> = {
  small:  { num: '01', name: 'Small',  time: '~1–2 min',   desc: 'Quick, satisfying puzzles. Perfect for kids and warm-ups.',      href: '/small-mazes'  },
  medium: { num: '02', name: 'Medium', time: '~5–10 min',  desc: 'A proper challenge. Good for a focused 10-minute session.',      href: '/medium-mazes' },
  large:  { num: '03', name: 'Large',  time: '~10–20 min', desc: 'The full experience. A serious maze that takes real effort.',    href: '/large-mazes'  },
};
---

<section
  id="maze-library"
  class="py-16 sm:py-20"
  style="background-color: var(--color-surface); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);"
  aria-labelledby="challenge-heading"
>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="flex items-end justify-between mb-10">
      <div>
        <p
          class="text-xs uppercase tracking-widest mb-2"
          style="font-family: 'IBM Plex Mono', monospace; color: var(--color-muted);"
        >Free Maze Library</p>
        <h2
          id="challenge-heading"
          class="font-display text-5xl sm:text-6xl uppercase"
          style="color: var(--color-charcoal);"
        >Pick Your<br />Challenge</h2>
        <p
          class="mt-3 text-sm leading-relaxed max-w-md"
          style="color: var(--color-muted-strong);"
        >420+ free printable mazes in three sizes — play online or print at home.</p>
      </div>
      <a
        href="/large-mazes"
        class="hidden sm:inline-flex items-center gap-1.5 text-xs uppercase tracking-widest pb-1 transition-colors"
        style="font-family: 'IBM Plex Mono', monospace; color: var(--color-muted); border-bottom: 1px solid var(--color-border);"
        onmouseover="this.style.color='var(--color-accent)'; this.style.borderColor='var(--color-accent)';"
        onmouseout="this.style.color='var(--color-muted)'; this.style.borderColor='var(--color-border)';"
      >View all 420+ mazes →</a>
    </div>

    <!-- Three columns -->
    <div class="feat-grid">
      {featured.map((entry, i) => {
        const meta = labels[entry.difficulty];
        const svg  = svgs[i];
        return (
          <div class="feat-col">

            <!-- Number + time strip -->
            <div class="feat-strip-top">
              <span class="feat-mono feat-num">{meta.num}</span>
              <span class="feat-mono feat-time">{meta.time}</span>
            </div>

            <!-- Size name — large display, links to category -->
            <a href={meta.href} class="feat-name-link">
              <span class="font-display uppercase feat-name">{meta.name}</span>
            </a>

            <!-- Maze preview — links to category, not individual maze -->
            <a href={meta.href} class="feat-preview-link" aria-label={`Browse ${meta.name} mazes`}>
              <div class="feat-preview" set:html={svg} />
            </a>

            <!-- Description -->
            <p class="feat-desc feat-mono">{meta.desc}</p>

            <!-- Browse footer -->
            <a
              href={meta.href}
              class="feat-strip-bottom feat-mono"
              onmouseover="this.style.backgroundColor='var(--color-bg)';"
              onmouseout="this.style.backgroundColor='transparent';"
            >
              Browse {meta.name} mazes →
            </a>

          </div>
        );
      })}
    </div>

    <!-- Mobile all-mazes link -->
    <div class="mt-5 sm:hidden text-center">
      <a
        href="/large-mazes"
        class="text-xs uppercase tracking-widest"
        style="font-family: 'IBM Plex Mono', monospace; color: var(--color-muted);"
      >View all 420+ mazes →</a>
    </div>

    <!-- Audience navigation — subdirectory links, footnote weight -->
    <div class="mt-8 pt-6 flex flex-wrap gap-2 text-xs" style="border-top: 1px solid var(--color-border);">
      {[
        { href: '/printable-mazes',     label: 'Printable Mazes' },
        { href: '/mazes-for-kids',      label: 'Mazes for Kids' },
        { href: '/mazes-for-adults',    label: 'Mazes for Adults' },
        { href: '/mazes-for-classroom', label: 'Classroom Mazes' },
      ].map(({ href, label }) => (
        <a
          href={href}
          class="inline-flex items-center px-3 py-1.5 uppercase tracking-widest transition-colors duration-150"
          style="font-family: 'IBM Plex Mono', monospace; color: var(--color-muted); border: 1px solid var(--color-border);"
          onmouseover="this.style.color='var(--color-charcoal)'; this.style.borderColor='var(--color-border-strong)';"
          onmouseout="this.style.color='var(--color-muted)'; this.style.borderColor='var(--color-border)';"
        >{label}</a>
      ))}
    </div>
  </div>
</section>

<style>
  /* ── SVG scaling ─────────────────────────────────────────────────────────── */
  .feat-preview :global(svg) { width: 100%; height: auto; display: block; }

  /* ── Grid: single col mobile, 3 col desktop with 1px dividers ───────────── */
  .feat-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid var(--color-border);
  }
  @media (min-width: 640px) {
    .feat-grid {
      grid-template-columns: repeat(3, 1fr);
      border-top: none;
    }
    /* Vertical dividers between columns via left border on 2nd and 3rd */
    .feat-col:not(:first-child) {
      border-left: 1px solid var(--color-border);
    }
  }

  /* ── Column ─────────────────────────────────────────────────────────────── */
  .feat-col {
    display: flex;
    flex-direction: column;
    background-color: var(--color-surface);
  }

  /* ── Shared mono base ───────────────────────────────────────────────────── */
  .feat-mono {
    font-family: 'IBM Plex Mono', monospace;
  }

  /* ── Top strip: number + time ───────────────────────────────────────────── */
  .feat-strip-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 1rem 0.625rem;
    border-bottom: 1px solid var(--color-border);
  }
  .feat-num  { font-size: 0.75rem; color: var(--color-muted); }
  .feat-time { font-size: 0.75rem; color: var(--color-muted); }

  /* ── Size name: large display, links to category ───────────────────────── */
  .feat-name-link {
    display: block;
    padding: 0.75rem 1rem 0.5rem;
    text-decoration: none;
  }
  .feat-name {
    display: block;
    font-size: clamp(2rem, 5vw, 2.75rem);
    line-height: 1;
    color: var(--color-charcoal);
    transition: color 120ms ease;
  }
  .feat-name-link:hover .feat-name { color: var(--color-accent); }

  /* ── Maze preview ───────────────────────────────────────────────────────── */
  .feat-preview-link {
    display: block;
    overflow: hidden;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  /* Constrain height on mobile so 3 stacked cards don't overwhelm the page */
  .feat-preview {
    max-height: 260px;
    overflow: hidden;
    transition: transform 400ms ease;
  }
  .feat-preview-link:hover .feat-preview { transform: scale(1.02); }

  @media (min-width: 640px) {
    .feat-preview { max-height: none; aspect-ratio: 1; overflow: hidden; }
  }

  /* ── Description ─────────────────────────────────────────────────────────  */
  .feat-desc {
    padding: 0.75rem 1rem 0.875rem;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-muted-strong);
    flex: 1;
  }

  /* ── Bottom browse strip ─────────────────────────────────────────────────  */
  .feat-strip-bottom {
    display: flex;
    align-items: center;
    padding: 0.75rem 1rem;
    font-size: 0.75rem;
    color: var(--color-muted-strong);
    text-decoration: none;
    border-top: 1px solid var(--color-border);
    transition: background-color 150ms ease, color 120ms ease;
  }
  .feat-strip-bottom:hover { color: var(--color-charcoal); }
</style>
