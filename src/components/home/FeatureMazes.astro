---
import { getFeaturedMazes } from '../../lib/catalog/index.js';
import { generateMazeFromCatalog } from '../../lib/maze/index.js';
import { renderThumbnail } from '../../lib/svg/renderToString.js';
import type { Difficulty } from '../../types/maze.js';

const featured = getFeaturedMazes();
const svgs = featured.map(entry => renderThumbnail(generateMazeFromCatalog(entry)));

const labels: Record<Difficulty, { num: string; name: string; time: string; grid: string; desc: string; href: string }> = {
  small:  { num: '01', name: 'Small',  time: '~1–2 min',   grid: '20×20', desc: 'Quick mazes for kids and warm-ups.',  href: '/small-mazes'  },
  medium: { num: '02', name: 'Medium', time: '~5–10 min',  grid: '40×40', desc: 'Balanced mazes for a focused solve.', href: '/medium-mazes' },
  large:  { num: '03', name: 'Large',  time: '~10–20 min', grid: '60×60', desc: 'Dense mazes for a real challenge.',   href: '/large-mazes'  },
};
---

<section
  id="maze-library"
  class="py-16 sm:py-20"
  style="background-color: var(--color-surface); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);"
  aria-labelledby="challenge-heading"
>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="flex items-end justify-between mb-10">
      <div>
        <p
          class="text-xs uppercase tracking-widest mb-2"
          style="font-family: 'IBM Plex Mono', monospace; color: var(--color-muted);"
        >Free Maze Library</p>
        <h2
          id="challenge-heading"
          class="font-display text-5xl sm:text-6xl uppercase"
          style="color: var(--color-charcoal);"
        >Pick Your<br />Challenge</h2>
        <p
          class="mt-3 text-sm leading-relaxed max-w-md"
          style="color: var(--color-muted-strong);"
        >420+ free printable mazes in three sizes — play online or print at home.</p>
      </div>
      <a
        href="/large-mazes"
        class="hidden sm:inline-flex items-center gap-1.5 text-xs uppercase tracking-widest pb-1 transition-colors"
        style="font-family: 'IBM Plex Mono', monospace; color: var(--color-muted-strong); border-bottom: 1px solid var(--color-border);"
        onmouseover="this.style.color='var(--color-charcoal)'; this.style.borderColor='var(--color-charcoal)';"
        onmouseout="this.style.color='var(--color-muted-strong)'; this.style.borderColor='var(--color-border)';"
      >View all 420+ mazes →</a>
    </div>

    <!-- Three cards — each entire card is one link -->
    <div class="feat-grid">
      {featured.map((entry, i) => {
        const meta = labels[entry.difficulty];
        const svg  = svgs[i];
        return (
          <a href={meta.href} class="feat-col" aria-label={`Browse ${meta.name} mazes`}>

            <!-- Maze preview — square thumb on mobile, full-width on desktop -->
            <div class="feat-preview-frame">
              <div class="feat-preview" set:html={svg} />
            </div>

            <!-- Right content: flex column on mobile; display:contents on desktop -->
            <div class="feat-right">

              <!-- Desktop only: number + time strip -->
              <div class="feat-strip-top">
                <span class="feat-mono feat-num">{meta.num}</span>
                <span class="feat-mono feat-time">{meta.time}</span>
              </div>

              <!-- Name row: title left, time right (mobile) / title only (desktop) -->
              <div class="feat-name-wrap">
                <span class="font-display uppercase feat-name">{meta.name}</span>
                <span class="feat-mono feat-time-mobile">{meta.time}</span>
              </div>

              <!-- Description + grid size -->
              <div class="feat-body feat-mono">
                <span class="feat-desc">{meta.desc}</span>
                <span class="feat-grid-label">{meta.grid} grid</span>
              </div>

              <!-- Browse footer -->
              <div class="feat-strip-bottom feat-mono">
                Browse {meta.name} →
              </div>

            </div>

          </a>
        );
      })}
    </div>

    <!-- Mobile: view all link -->
    <div class="mt-6 sm:hidden text-center">
      <a
        href="/large-mazes"
        class="text-xs uppercase tracking-widest"
        style="font-family: 'IBM Plex Mono', monospace; color: var(--color-muted-strong);"
      >View all 420+ mazes →</a>
    </div>

  </div>
</section>

<style>
  /* ── SVG fills its container ─────────────────────────────────────────────── */
  .feat-preview :global(svg) { width: 100%; height: 100%; display: block; }

  /* ── Outer grid: 1-col stack on mobile, 3-col editorial on desktop ────────── */
  .feat-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }
  @media (min-width: 640px) {
    .feat-grid {
      grid-template-columns: repeat(3, 1fr);
      border-top: 1px solid var(--color-border);
    }
    .feat-col:not(:first-child) {
      border-left: 1px solid var(--color-border);
    }
  }

  /* ── Card ────────────────────────────────────────────────────────────────────
     Mobile:  2-col thumbnail-left media row (96px | 1fr)
     Desktop: vertical flex card
  ─────────────────────────────────────────────────────────────────────────── */
  .feat-col {
    display: grid;
    grid-template-columns: 96px 1fr;
    background-color: var(--color-surface);
    text-decoration: none;
    border-top: 1px solid var(--color-border);
    transition: background-color 120ms ease;
  }
  @media (min-width: 640px) {
    .feat-col {
      display: flex;
      flex-direction: column;
      border-top: none;
    }
  }
  .feat-col:hover,
  .feat-col:focus-visible {
    background-color: var(--color-bg);
    outline: none;
  }
  .feat-col:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  /* ── Right content wrapper ───────────────────────────────────────────────────
     Mobile:  flex column occupying col 2 of the card grid
     Desktop: display:contents — children become direct flex items of .feat-col,
              preserving the original desktop layout exactly
  ─────────────────────────────────────────────────────────────────────────── */
  .feat-right {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  @media (min-width: 640px) {
    .feat-right { display: contents; }
  }

  /* ── Shared mono ────────────────────────────────────────────────────────── */
  .feat-mono { font-family: 'IBM Plex Mono', monospace; }

  /* ── Desktop-only: number + time strip ──────────────────────────────────── */
  .feat-strip-top { display: none; }
  @media (min-width: 640px) {
    .feat-strip-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.625rem 1rem 0.5rem;
      border-bottom: 1px solid var(--color-border);
    }
  }
  .feat-num  { font-size: 0.75rem; color: var(--color-muted); }
  .feat-time { font-size: 0.75rem; color: var(--color-muted); }

  /* ── Mobile-only inline solve time (sits beside the title) ──────────────── */
  .feat-time-mobile {
    font-size: 0.6875rem;
    color: var(--color-muted);
    line-height: 1;
    flex-shrink: 0;
    white-space: nowrap;
  }
  @media (min-width: 640px) {
    .feat-time-mobile { display: none; }
  }

  /* ── Size name ──────────────────────────────────────────────────────────── */
  /* Mobile: flex row — title left, solve time right */
  .feat-name-wrap {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.625rem 0.875rem 0.1875rem;
  }
  @media (min-width: 640px) {
    .feat-name-wrap {
      display: block;
      padding: 0.5rem 1rem 0.375rem;
    }
  }
  .feat-name {
    font-size: 1.75rem;
    line-height: 1;
    color: var(--color-charcoal);
    transition: color 120ms ease;
  }
  @media (min-width: 640px) {
    .feat-name {
      display: block;
      font-size: clamp(2rem, 5vw, 2.75rem);
    }
  }
  .feat-col:hover .feat-name { color: var(--color-accent); }

  /* ── Maze preview ────────────────────────────────────────────────────────── */
  /* Mobile: fixed square thumbnail, vertically centered, contained */
  .feat-preview-frame {
    width: 96px;
    aspect-ratio: 1;
    align-self: center;
    overflow: hidden;
    border-right: 1px solid var(--color-border);
    flex-shrink: 0;
  }
  /* Desktop: full-width square between strips */
  @media (min-width: 640px) {
    .feat-preview-frame {
      width: auto;
      align-self: stretch;
      border-right: none;
      border-top: 1px solid var(--color-border);
      border-bottom: 1px solid var(--color-border);
    }
  }
  .feat-preview {
    width: 100%;
    height: 100%;
    transition: transform 400ms ease;
  }
  .feat-col:hover .feat-preview { transform: scale(1.015); }

  /* ── Description + grid size ────────────────────────────────────────────── */
  .feat-body {
    flex: 1;
    padding: 0.1875rem 0.875rem 0.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }
  @media (min-width: 640px) {
    .feat-body { padding: 0.5rem 1rem; gap: 0.25rem; }
  }
  .feat-desc { font-size: 0.75rem; line-height: 1.4; color: var(--color-muted-strong); }
  .feat-grid-label { font-size: 0.7rem; color: var(--color-muted); }

  /* Hide grid size label on mobile */
  @media (max-width: 639px) {
    .feat-grid-label { display: none; }
  }

  /* ── Browse footer ──────────────────────────────────────────────────────── */
  /* Mobile: no border, lighter treatment */
  .feat-strip-bottom {
    padding: 0.25rem 0.875rem 0.6875rem;
    font-size: 0.6875rem;
    color: var(--color-muted);
    transition: color 120ms ease;
  }
  @media (min-width: 640px) {
    .feat-strip-bottom {
      padding: 0.5rem 1rem;
      font-size: 0.75rem;
      color: var(--color-muted-strong);
      border-top: 1px solid var(--color-border);
    }
  }
  .feat-col:hover .feat-strip-bottom { color: var(--color-charcoal); }
</style>
