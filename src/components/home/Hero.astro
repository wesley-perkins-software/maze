---
import { getFeaturedMazes } from '../../lib/catalog/index.js';
import { generateMazeFromCatalog } from '../../lib/maze/index.js';
import { renderThumbnail } from '../../lib/svg/renderToString.js';

const featured = getFeaturedMazes();
const heroEntry = featured.find(f => f.difficulty === 'large') ?? featured[0];
const heroMaze = generateMazeFromCatalog(heroEntry);
const heroSvg = renderThumbnail(heroMaze);
---

<section
  class="relative overflow-hidden"
  style="background-color: var(--color-bg); border-bottom: 1px solid var(--color-border);"
  aria-labelledby="hero-heading"
>
  <div class="absolute inset-0 architect-dot-grid pointer-events-none" aria-hidden="true"></div>

  <!-- ─── MOBILE: poster overlay layout ─────────────────────────────────── -->
  <!--
    min-height fills the viewport below the sticky header (h-14 = 3.5rem).
    flex-col lets the content area grow to fill remaining space, so the
    next section never awkwardly peeks above the fold.
  -->
  <div class="hero-mobile-root md:hidden flex flex-col">

    <!-- Full-width maze with headline overlaid -->
    <div class="hero-maze-poster">
      <!-- Maze at confident opacity — it IS the product -->
      <div class="maze-fill-width" style="opacity: 0.60;" set:html={heroSvg} />

      <!--
        Scrim: elliptical cream shape, taller at the vertical center where
        the headline lives. Strong enough to feel "printed on" without
        washing out the outer maze.
      -->
      <div class="hero-scrim" aria-hidden="true"></div>

      <!--
        Headline: absolutely fills the poster, flexed to center, but
        padding-bottom shifts the visual center ~10% upward for better
        composition and breathing room toward the bottom edge.
      -->
      <a
        href="/play/maze-of-the-day/"
        class="hero-headline-link"
        aria-label="Play today's maze"
        tabindex="-1"
      >
        <h1
          id="hero-heading"
          class="font-display uppercase text-center"
          style="font-size: clamp(2.9rem, 14.5vw, 5rem); line-height: 0.86; color: var(--color-charcoal); pointer-events: none;"
        >
          CAN YOU<br />SOLVE<br /><span style="color: var(--color-accent);">TODAY'S</span><br />MAZE?
        </h1>
      </a>
    </div>

    <!-- Below-poster: daily state + CTA + secondary links -->
    <div class="hero-mobile-content">

      <!-- Daily state — two lines, prominent but not larger than the CTA -->
      <div id="hero-daily-status-mobile" class="hero-status-block">
        <p class="hero-status-line1">
          <span style="color: var(--color-accent);">●</span>&thinsp;Ready now
        </p>
        <p class="hero-status-line2">Today's maze is waiting.</p>
      </div>

      <!-- Primary CTA — full-width, subtle tactile depth -->
      <a
        id="hero-play-cta"
        href="/play/maze-of-the-day/"
        class="hero-cta-primary btn-primary w-full justify-center text-sm px-7 py-4 inline-flex items-center gap-2"
      >
        <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M8 5v14l11-7z" />
        </svg>
        Play Today's Maze
      </a>

      <!-- Secondary links — clearly links, clearly secondary, 44px tap targets -->
      <div class="hero-sec-group-mobile">
        <a href="/#maze-library" class="hero-sec-link">Browse Library →</a>
        <a href="/maze-generator" class="hero-sec-link">Make a Maze →</a>
      </div>

    </div>
  </div>

  <!-- ─── DESKTOP: split editorial layout ───────────────────────────────── -->
  <div class="hidden md:block relative">
    <div class="mx-auto max-w-6xl px-6 lg:px-8 pt-4 pb-8 lg:pt-6 lg:pb-10">
      <div class="grid grid-cols-[1fr_540px] lg:grid-cols-[1fr_580px] gap-10 lg:gap-14 items-start">

        <!-- Left: headline + daily state + CTA + secondary links -->
        <div class="flex flex-col items-start">
          <h1
            class="font-display uppercase mb-4"
            style="font-size: clamp(3.5rem, 9vw, 8.5rem); line-height: 0.88; color: var(--color-charcoal);"
          >
            Can You<br />Solve<br /><span style="color: var(--color-accent);">Today's</span><br />Maze?
          </h1>

          <!-- Daily state — prominent, between headline and CTA -->
          <div id="hero-daily-status-desktop" class="hero-status-block mb-4">
            <p class="hero-status-line1">
              <span style="color: var(--color-accent);">●</span>&thinsp;Ready now
            </p>
            <p class="hero-status-line2">Today's maze is waiting.</p>
          </div>

          <!-- Primary CTA -->
          <a
            href="/play/maze-of-the-day/"
            class="hero-cta-primary btn-primary text-sm px-8 py-4 mb-4 inline-flex items-center gap-2"
          >
            <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M8 5v14l11-7z" />
            </svg>
            Play Today's Maze
          </a>

          <!-- Secondary links — horizontal row on desktop -->
          <div class="hero-sec-group-desktop">
            <a href="/#maze-library" class="hero-sec-link">Browse Library →</a>
            <a href="/maze-generator" class="hero-sec-link">Make a Maze →</a>
          </div>
        </div>

        <!-- Right: maze preview with corner-bracket frame -->
        <div class="pt-1">
          <div class="relative">
            <!-- Corner brackets — 3px border weight so they register as intentional -->
            <div class="absolute -top-2 -left-2 w-6 h-6 z-10" style="border-top: 3px solid var(--color-charcoal); border-left: 3px solid var(--color-charcoal);"></div>
            <div class="absolute -top-2 -right-2 w-6 h-6 z-10" style="border-top: 3px solid var(--color-charcoal); border-right: 3px solid var(--color-charcoal);"></div>
            <div class="absolute -bottom-2 -left-2 w-6 h-6 z-10" style="border-bottom: 3px solid var(--color-charcoal); border-left: 3px solid var(--color-charcoal);"></div>
            <div class="absolute -bottom-2 -right-2 w-6 h-6 z-10" style="border-bottom: 3px solid var(--color-charcoal); border-right: 3px solid var(--color-charcoal);"></div>
            <a
              href="/play/maze-of-the-day/"
              class="block w-full group overflow-hidden cursor-pointer"
              style="border: 1px solid var(--color-border-strong); background-color: var(--color-surface); aspect-ratio: 1;"
              aria-label="Play today's maze"
              tabindex="-1"
            >
              <div class="maze-fill-square w-full h-full transition-transform duration-500 group-hover:scale-[1.02]" set:html={heroSvg} />
            </a>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  /* ── SVG scaling ────────────────────────────────────────────────────────── */
  .maze-fill-width :global(svg)  { width: 100%; height: auto;  display: block; }
  .maze-fill-square :global(svg) { width: 100%; height: 100%;  display: block; }

  /*
    Mobile root: display/flex-direction live as Tailwind classes (flex flex-col)
    so md:hidden can override display without specificity conflict.
    No forced min-height — the natural height of poster + content is enough
    on any real phone, and letting the next section peek slightly reads as
    intentional scroll invitation rather than a dead zone.
  */
  .hero-mobile-root {
    /* intentionally no min-height */
  }

  /* ── Mobile maze poster ─────────────────────────────────────────────────── */
  .hero-maze-poster {
    position: relative;
    overflow: hidden;
    flex-shrink: 0;
    background-color: var(--color-surface);
    /* Thin print-rule frame above and below the maze image */
    border-top:    1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border-strong);
  }

  /*
    Scrim: linear gradient, transparent at top → opaque cream at bottom.
    Keeps maze fully visible in the upper portion (where it reads as product),
    grades to readable contrast around the headline, and grounds the poster
    with a clean bottom edge into the content below.
  */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent               0%,
      rgba(246, 245, 240, 0.12) 22%,
      rgba(246, 245, 240, 0.52) 48%,
      rgba(246, 245, 240, 0.88) 72%,
      #F6F5F0                   100%
    );
  }

  /*
    Headline overlay: fills the poster, flexed to center.
    padding-bottom of 14% shifts the visual center ~7% upward —
    better negative space at the bottom, avoids feeling cramped at top.
  */
  .hero-headline-link {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-bottom: 14%;
    /* no text-decoration — it's a layout link, the heading is the content */
  }

  /* ── Mobile content: natural height, centered to match poster composition ── */
  .hero-mobile-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1.25rem 1rem 1.75rem;
  }

  /* ── Daily status block — bordered tile so it reads as product state ──── */
  .hero-status-block {
    width:            100%;
    margin-bottom:    1.1rem;
    padding:          0.75rem 1rem;
    background-color: var(--color-surface);
    border:           1px solid var(--color-border);
    border-left:      3px solid var(--color-accent);
  }
  /* Desktop: don't stretch to full column — shrink to content width */
  @media (min-width: 768px) {
    .hero-status-block {
      width: auto;
    }
  }
  .hero-status-line1 {
    font-family: 'IBM Plex Mono', monospace;
    font-size:   0.9375rem; /* 15px */
    font-weight: 600;
    color:       var(--color-charcoal);
    line-height: 1.3;
  }
  .hero-status-line2 {
    font-family: 'IBM Plex Mono', monospace;
    font-size:   0.8125rem; /* 13px */
    color:       var(--color-muted-strong);
    margin-top:  0.2rem;
    line-height: 1.4;
  }

  /* ── Primary CTA: subtle tactile bottom-edge depth ──────────────────────── */
  /*
    box-shadow creates a 2px dark bottom ledge — like a rubber stamp.
    Active state "presses" it down by 2px and removes the shadow.
  */
  .hero-cta-primary {
    box-shadow: 0 2px 0 0 var(--color-accent-dark);
    margin-bottom: 0.75rem;
  }
  .hero-cta-primary:active {
    transform:  translateY(2px);
    box-shadow: none;
  }

  /* ── Secondary links — compact bordered chips ───────────────────────────── */
  /*
    Small auto-width buttons with a thin 1px border. Clearly tappable due to
    the visible border, clearly subordinate to the red CTA due to small size,
    muted color, and no fill. Not the old full-width bordered buttons.
  */
  .hero-sec-link {
    display:         inline-flex;
    align-items:     center;
    font-family:     'IBM Plex Mono', monospace;
    font-size:       0.75rem; /* 12px — intentionally smaller than the CTA */
    color:           var(--color-muted-strong);
    text-decoration: none;
    cursor:          pointer;
    border:          1px solid var(--color-border-strong);
    padding:         0.4rem 0.875rem;
    white-space:     nowrap;
    transition:      color 120ms ease, border-color 120ms ease;
  }
  .hero-sec-link:hover {
    color:         var(--color-charcoal);
    border-color:  var(--color-charcoal);
  }
  .hero-sec-link:focus-visible {
    outline:        2px solid var(--color-charcoal);
    outline-offset: 2px;
  }

  /* Mobile: side-by-side chips with 44px tap zone via padding trick */
  .hero-sec-group-mobile {
    display:     flex;
    flex-wrap:   wrap;
    gap:         0.625rem;
    padding-top: 0.125rem; /* optical alignment with status above */
  }
  .hero-sec-group-mobile .hero-sec-link {
    padding: 0.7rem 0.875rem; /* taller padding = solid 44px tap target */
  }

  /* Desktop: same chip style, compact horizontal row */
  .hero-sec-group-desktop {
    display:     flex;
    flex-direction: row;
    gap:         0.625rem;
    align-items: center;
  }
</style>

<script>
  const todayKey = (): string => {
    const n = new Date();
    return `daily_completed_${n.getUTCFullYear()}-${String(n.getUTCMonth() + 1).padStart(2, '0')}-${String(n.getUTCDate()).padStart(2, '0')}`;
  };

  const msUntilMidnight = (): number => {
    const now = new Date();
    const midnight = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate() + 1));
    return midnight.getTime() - now.getTime();
  };

  const formatCountdown = (ms: number): string => {
    const total = Math.max(0, Math.floor(ms / 1000));
    const h = Math.floor(total / 3600);
    const m = Math.floor((total % 3600) / 60);
    const s = total % 60;
    return `${h}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
  };

  /*
    Renders two-line status HTML with fully inline styles so it works
    correctly whether rendered server-side or injected via innerHTML.
    Classes on the container are Astro-scoped; inner content uses inline styles.
  */
  const renderStatus = (done: boolean): string => {
    const monoBase = `font-family:'IBM Plex Mono',monospace;`;
    const line1Style = `${monoBase}font-size:0.9375rem;font-weight:600;color:var(--color-charcoal);line-height:1.3;`;
    const line2Style = `${monoBase}font-size:0.8125rem;color:var(--color-muted-strong);margin-top:0.2rem;line-height:1.4;`;
    const accentStyle = `color:var(--color-accent);`;

    if (!done) {
      return `<p style="${line1Style}"><span style="${accentStyle}">●</span>&thinsp;Ready now</p>`
           + `<p style="${line2Style}">Today's maze is waiting.</p>`;
    }
    const cd = formatCountdown(msUntilMidnight());
    return `<p style="${line1Style}"><span style="${accentStyle}">✓</span>&thinsp;Solved today</p>`
         + `<p style="${line2Style}">Next maze in <span style="font-variant-numeric:tabular-nums;">${cd}</span></p>`;
  };

  const desktopEl = document.getElementById('hero-daily-status-desktop');
  const mobileEl  = document.getElementById('hero-daily-status-mobile');

  let prevDone: boolean | null = null;

  const updateStatus = (): void => {
    const done = localStorage.getItem(todayKey()) === 'true';
    // Always re-render when completed (countdown ticks); only on transition when not.
    if (done !== prevDone || done) {
      const html = renderStatus(done);
      if (desktopEl) desktopEl.innerHTML = html;
      if (mobileEl)  mobileEl.innerHTML  = html;
      prevDone = done;
    }
  };

  updateStatus();
  const timer = window.setInterval(updateStatus, 1000);
  window.addEventListener('storage', updateStatus);
  window.addEventListener('beforeunload', () => {
    clearInterval(timer);
    window.removeEventListener('storage', updateStatus);
  });
</script>
