---
---

<section class="bg-gradient-to-b from-blue-50 to-white border-b border-blue-100">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-16 sm:py-20 text-center">

    <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900 mb-5 leading-tight">
      Free Maze Puzzles —<br class="hidden sm:block" />
      Print, Play Online &amp; Generate
    </h1>

    <p class="text-lg text-slate-600 max-w-2xl mx-auto mb-8">
      Browse 420+ free printable mazes for kids and adults. Solve the daily maze challenge,
      or create unlimited custom mazes with our generator.
    </p>

    <!-- Primary CTA -->
    <div class="flex justify-center mb-4">
      <a href="/maze-of-the-day/" class="btn-primary text-base px-8 py-3.5 shadow-md hover:shadow-lg transition-shadow">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M8 5v14l11-7z" />
        </svg>
        Play Today's Maze
      </a>
    </div>

    <!-- Secondary CTAs -->
    <div class="flex flex-col sm:flex-row gap-2 justify-center">
      <a href="/printable-mazes" class="btn-secondary text-sm px-5 py-2.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        Browse Free Mazes
      </a>
      <a href="/maze-generator" class="btn-secondary text-sm px-5 py-2.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        Create a Maze
      </a>
    </div>

    <!-- Trust signals -->
    <div class="mt-10 flex flex-wrap justify-center gap-3">
      {[
        { icon: '🆓', text: '100% free' },
        { icon: '🖨️', text: 'Print-friendly' },
        { icon: '📱', text: 'Mobile-friendly' },
        { icon: '🔄', text: 'New maze daily' },
        { icon: '✏️', text: 'No account needed' },
      ].map(({ icon, text }) => (
        <span class="flex items-center gap-1.5 rounded-full bg-white border border-slate-200 px-3 py-1.5 text-sm text-slate-600 shadow-sm">
          <span aria-hidden="true">{icon}</span>
          {text}
        </span>
      ))}
    </div>
  </div>
</section>
