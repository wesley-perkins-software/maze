---
import { getFeaturedMazes } from '../../lib/catalog/index.js';
import { generateMazeFromCatalog } from '../../lib/maze/index.js';
import { renderThumbnail } from '../../lib/svg/renderToString.js';

const featured = getFeaturedMazes();
const heroEntry = featured.find(f => f.difficulty === 'large') ?? featured[0];
const heroMaze = generateMazeFromCatalog(heroEntry);
const heroSvg = renderThumbnail(heroMaze);
---

<section
  class="relative overflow-hidden"
  style="background-color: var(--color-bg); border-bottom: 1px solid var(--color-border);"
  aria-labelledby="hero-heading"
>
  <!-- Dot grid -->
  <div class="absolute inset-0 architect-dot-grid pointer-events-none" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 pt-12 pb-16 sm:pt-16 sm:pb-24">

    <!-- Rule + date row -->
    <div class="flex items-center gap-4 mb-10 animate-reveal" style="--tw-reveal-delay: 0ms;">
      <div class="h-px flex-1" style="background-color: var(--color-border-strong);"></div>
      <span
        class="shrink-0 text-xs uppercase tracking-widest"
        style="font-family: 'IBM Plex Mono', monospace; color: var(--color-muted);"
        id="hero-date"
      >Daily Maze Challenge</span>
      <div class="h-px flex-1" style="background-color: var(--color-border-strong);"></div>
    </div>

    <!-- Two-column layout -->
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_360px] gap-10 lg:gap-16 items-start">

      <!-- Left: headline + CTAs -->
      <div>
        <h1
          id="hero-heading"
          class="font-display text-[clamp(5rem,14vw,9rem)] uppercase leading-none mb-6 animate-reveal"
          style="color: var(--color-charcoal);"
        >
          Can You<br />
          Solve<br />
          <span style="color: var(--color-accent);">Today's</span><br />
          Maze?
        </h1>

        <p
          class="text-base leading-relaxed mb-8 max-w-sm animate-reveal [animation-delay:80ms]"
          style="color: var(--color-muted-strong);"
        >
          A new puzzle unlocks every day — same maze for everyone, no account needed.
          Explore 420+ free printable mazes or build your own.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-3 mb-8 animate-reveal [animation-delay:130ms]">
          <a
            id="hero-play-cta"
            href="/play/maze-of-the-day/"
            class="btn-primary text-sm px-7 py-3.5 font-semibold"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M8 5v14l11-7z" />
            </svg>
            Play Today's Maze
          </a>
          <a href="/printable-mazes" class="btn-secondary text-sm px-6 py-3.5">
            Browse Free Mazes
          </a>
        </div>

        <!-- Mono metadata strip -->
        <div
          class="flex flex-wrap gap-x-6 gap-y-1.5 text-xs animate-reveal [animation-delay:180ms]"
          style="font-family: 'IBM Plex Mono', monospace; color: var(--color-muted);"
        >
          <span>~10–15 min</span>
          <span aria-hidden="true" style="color: var(--color-border-strong);">·</span>
          <span>Next maze in <span id="hero-countdown" class="font-semibold" style="color: var(--color-muted-strong);">…</span></span>
          <span aria-hidden="true" style="color: var(--color-border-strong);">·</span>
          <span>Free forever</span>
        </div>
      </div>

      <!-- Right: maze SVG in architectural frame -->
      <div class="hidden lg:block animate-reveal-right [animation-delay:200ms]">
        <div class="relative" style="aspect-ratio: 1;">
          <!-- Corner brackets in accent color -->
          <div class="absolute -top-2 -left-2 w-6 h-6 border-t-2 border-l-2 z-10" style="border-color: var(--color-accent);"></div>
          <div class="absolute -top-2 -right-2 w-6 h-6 border-t-2 border-r-2 z-10" style="border-color: var(--color-accent);"></div>
          <div class="absolute -bottom-2 -left-2 w-6 h-6 border-b-2 border-l-2 z-10" style="border-color: var(--color-accent);"></div>
          <div class="absolute -bottom-2 -right-2 w-6 h-6 border-b-2 border-r-2 z-10" style="border-color: var(--color-accent);"></div>

          <!-- Maze SVG — rendered at build time -->
          <a
            href="/play/maze-of-the-day/"
            class="block w-full h-full group overflow-hidden"
            style="border: 1px solid var(--color-border); background-color: var(--color-surface);"
            aria-label="Play today's maze"
            tabindex="-1"
          >
            <div
              class="w-full h-full transition-transform duration-500 group-hover:scale-[1.02]"
              set:html={heroSvg}
            />
          </a>

          <!-- Hover label -->
          <div
            class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none"
            aria-hidden="true"
          >
            <span
              class="px-4 py-2 text-xs font-semibold uppercase tracking-widest text-white"
              style="background-color: var(--color-accent); font-family: 'IBM Plex Mono', monospace;"
            >Solve it →</span>
          </div>
        </div>

        <!-- Maze metadata beneath the frame -->
        <div
          class="mt-3 flex items-center justify-between text-xs"
          style="font-family: 'IBM Plex Mono', monospace; color: var(--color-muted);"
        >
          <span>{heroEntry.width}×{heroEntry.height} grid</span>
          <span style="color: var(--color-border-strong);">·</span>
          <span>Large</span>
          <span style="color: var(--color-border-strong);">·</span>
          <span>10–20 min</span>
        </div>
      </div>
    </div>

    <!-- Bottom trust strip -->
    <div
      class="mt-12 pt-6 flex flex-wrap gap-x-8 gap-y-2 animate-reveal [animation-delay:240ms]"
      style="border-top: 1px solid var(--color-border);"
    >
      {[
        'No Account Needed',
        '420+ Free Mazes',
        'Print-Friendly PDFs',
        'Mobile-Ready',
      ].map((label) => (
        <span
          class="text-xs uppercase tracking-widest"
          style="font-family: 'IBM Plex Mono', monospace; color: var(--color-muted);"
        >{label}</span>
      ))}
    </div>
  </div>
</section>

<script>
  const dateEl = document.getElementById('hero-date');
  if (dateEl) {
    dateEl.textContent = new Date().toLocaleDateString('en-US', {
      weekday: 'long', month: 'long', day: 'numeric',
    });
  }

  function tickCountdown() {
    const now = new Date();
    const midnight = new Date(Date.UTC(
      now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate() + 1,
    ));
    const rem = Math.max(0, Math.floor((midnight.getTime() - now.getTime()) / 1000));
    const h = Math.floor(rem / 3600);
    const m = Math.floor((rem % 3600) / 60);
    const s = rem % 60;
    const el = document.getElementById('hero-countdown');
    if (el) {
      el.textContent = h > 0
        ? `${h}h ${String(m).padStart(2, '0')}m`
        : `${m}m ${String(s).padStart(2, '0')}s`;
    }
  }
  tickCountdown();
  setInterval(tickCountdown, 1000);
</script>
