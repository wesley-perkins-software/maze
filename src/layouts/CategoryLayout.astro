---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/nav/Breadcrumb.astro';
import CategoryNav from '../components/nav/CategoryNav.astro';
import type { CategoryInfo } from '../types/maze.js';

export interface Props {
  category: CategoryInfo;
  schemaLD?: string;
  totalCount: number;
  tagline?: string;
  nextCategory?: CategoryInfo;
}

const { category, schemaLD, totalCount, tagline, nextCategory } = Astro.props;
const taglineText = tagline ?? `${totalCount} maze puzzles — play free online.`;
---

<BaseLayout
  title={category.title}
  description={category.description}
  schemaLD={schemaLD}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumb -->
    <Breadcrumb crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Maze Library', href: '/maze-library' },
      { label: category.label },
    ]} />

    <!-- Page header -->
    <div class="mt-4 mb-8">
      <h1 class="mb-2">{category.h1}</h1>
      <p class="text-slate-500 text-lg">{taglineText}</p>
    </div>

    <!-- Category nav -->
    <div class="mb-8">
      <CategoryNav activeDifficulty={category.difficulty} compact />
    </div>

    <!-- Maze grid + page-specific content -->
    <slot />

    <!-- What to try next -->
    <div class="mt-12">
      {nextCategory ? (
        <div class="rounded-xl border p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4" style="border-color: var(--color-border);">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider mb-1" style="color: var(--color-muted);">What to Try Next</p>
            <p class="font-bold text-lg" style="color: var(--color-charcoal);">{nextCategory.label}</p>
            <p class="text-sm mt-1" style="color: var(--color-muted-strong);">{nextCategory.teaser}</p>
          </div>
          <a href={`/${nextCategory.slug}`} class="btn-secondary shrink-0">
            Browse {nextCategory.label} →
          </a>
        </div>
      ) : (
        <div class="rounded-xl border p-6 text-center" style="border-color: var(--color-border);">
          <p class="text-xs font-semibold uppercase tracking-wider mb-1" style="color: var(--color-muted);">You've Reached the Top Tier</p>
          <p class="font-bold text-lg mb-1" style="color: var(--color-charcoal);">Maze Library</p>
          <p class="text-sm mb-4" style="color: var(--color-muted-strong);">Explore all 160 curated puzzles across five difficulty tiers.</p>
          <a href="/maze-library" class="btn-secondary">
            Browse Full Library →
          </a>
        </div>
      )}
      <p class="mt-4 text-xs text-center" style="color: var(--color-muted);">
        Want something completely different?
        <a href="/maze-generator" class="underline hover:opacity-80" style="color: var(--color-muted-strong);">Create a custom maze →</a>
      </p>
    </div>
  </div>
</BaseLayout>
